suite github.activity

case "a digest totals its tallies" {
	let d = digest(
		"2026-11-01",
		[
			Tally {
				repo: Some("bynk-lang/bynk"),
				event: "push",
				action: None,
				deliveries: 3,
			},
			Tally {
				repo: None,
				event: "ping",
				action: None,
				deliveries: 1,
			},
		]
	)
	expect d.total == 4
	expect d.tallies.length() == 2
}

case "an empty day totals zero" {
	expect digest("2026-11-01", []).total == 0
}

case "a day's range is its 24 hours in UTC" {
	let Some(r) = rangeOf("2026-11-01") else {
		expect false
	}
	expect r.start.toIso() == "2026-11-01T00:00:00.000Z"
	expect r.end.toIso() == "2026-11-02T00:00:00.000Z"
}

case "a range crosses months and years" {
	let Some(feb) = rangeOf("2024-02-29") else {
		expect false
	}
	let Some(eve) = rangeOf("2026-12-31") else {
		expect false
	}
	expect feb.end.toIso() == "2024-03-01T00:00:00.000Z"
	expect eve.end.toIso() == "2027-01-01T00:00:00.000Z"
}

case "a date that doesn't exist has no range" {
	expect rangeOf("2026-04-31") == None
	expect rangeOf("2026-02-30") == None
	expect rangeOf("2026-02-29") == None
	expect rangeOf("1900-02-29") == None
}

case "29 February exists in leap years" {
	expect rangeOf("2024-02-29").isSome()
	expect rangeOf("2000-02-29").isSome()
}
