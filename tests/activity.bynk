suite github.activity

case "a digest totals its tallies" {
	let d = digest(
		"2026-11-01",
		[
			Tally {
				repo: Some("bynk-lang/bynk"),
				event: "push",
				action: None,
				deliveries: 3,
			},
			Tally {
				repo: None,
				event: "ping",
				action: None,
				deliveries: 1,
			},
		]
	)
	expect d.total == 4
	expect d.tallies.length() == 2
}

case "an empty day totals zero" {
	expect digest("2026-11-01", []).total == 0
}

case "a day's range ends just after every timestamp of that day" {
	expect dayEnd("2026-11-01") == "2026-11-01U"
	expect "2026-11-01T23:59:59.999Z" < dayEnd("2026-11-01")
	expect "2026-11-02T00:00:00.000Z" > dayEnd("2026-11-01")
}

case "a real day is within its month's length" {
	expect isRealDay("2026-01-31")
	expect isRealDay("2026-04-30")
	expect isRealDay("2026-02-28")
	expect isRealDay("2026-12-31")
	expect !isRealDay("2026-04-31")
	expect !isRealDay("2026-02-30")
}

case "29 February exists only in leap years" {
	expect isRealDay("2024-02-29")
	expect isRealDay("2000-02-29")
	expect !isRealDay("2026-02-29")
	expect !isRealDay("1900-02-29")
}
