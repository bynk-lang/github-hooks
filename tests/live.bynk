// Phase 4, step 4 (#20): when a run is pushed to open dashboards. The socket
// itself can't be driven from a suite (bynk-lang/bynk has no WebSocket test
// harness yet); `scripts/live.mjs` checks it end to end against `bynk dev`.
suite github.hooks

fixture completedRun = "fixtures/github/workflow_run.completed.json"

fixture mergedPull = "fixtures/github/pull_request.closed.json"

fixture closedIssue = "fixtures/github/issues.closed.json"

fixture commented = "fixtures/github/issue_comment.created.json"

--- A `workflow_run` delivery's headers.
fn runHeaders(id: String) -> RequestHeaders {
	RequestHeaders.of(["X-GitHub-Event: workflow_run", "X-GitHub-Delivery: \(id)"])
}

case "a public run that changed is pushed, once" {
	stub Edge.purge(_) returns true
	let _ <- api.POST("/github", runHeaders("live-1"), Bytes.fromUtf8(completedRun)) by GitHub
	expect LiveFeed.publish called once with e == LiveEvent { refetch_ms: 3000, kind: "run", repo: "bynk-lang/github-hooks", number: 0, path: ".github/workflows/ci.yml", workflow: "CI", run_id: 41978704067, attempt: 1, status: "completed", conclusion: "success" }
}

case "a redelivery, which changes nothing, pushes nothing more" {
	let _ <- api.POST("/github", runHeaders("live-1"), Bytes.fromUtf8(completedRun)) by GitHub
	let _ <- api.POST("/github", runHeaders("live-1"), Bytes.fromUtf8(completedRun)) by GitHub
	expect LiveFeed.publish called once
}

case "a late in_progress after completed moves nothing, so pushes nothing" {
	let _ <- api.POST("/github", runHeaders("done"), Bytes.fromUtf8(completedRun)) by GitHub
	let _ <- api.POST(
		"/github",
		runHeaders("late"),
		Bytes.fromUtf8(completedRun
			.replace("\"status\": \"completed\"", "\"status\": \"in_progress\"")
			.replace(
				"\"updated_at\": \"2026-11-05T06:11:34Z\"",
				"\"updated_at\": \"2026-11-05T06:11:00Z\""
			))
	) by GitHub
	expect LiveFeed.publish called once with e.status == "completed"
}

case "a private repository's run is never pushed" {
	let _ <- api.POST(
		"/github",
		runHeaders("private-1"),
		Bytes.fromUtf8(completedRun.replace("\"private\": false", "\"private\": true"))
	) by GitHub
	expect LiveFeed.publish never called
}

case "other events push nothing" {
	let _ <- api.POST(
		"/github",
		RequestHeaders.of(["X-GitHub-Event: push", "X-GitHub-Delivery: push-1"]),
		Bytes.fromUtf8("{\"repository\": {\"full_name\": \"bynk-lang/bynk\", \"private\": false}}")
	) by GitHub
	expect LiveFeed.publish never called
}

--- A `pull_request` delivery's headers.
fn pullHeaders(id: String) -> RequestHeaders {
	RequestHeaders.of(["X-GitHub-Event: pull_request", "X-GitHub-Delivery: \(id)"])
}

case "a public pull request's delivery is pushed, as a pull" {
	stub Edge.purge(_) returns true
	let _ <- api.POST("/github", pullHeaders("pr-live-1"), Bytes.fromUtf8(mergedPull)) by GitHub
	expect LiveFeed.publish called once with e == LiveEvent { refetch_ms: 3000, kind: "pull", repo: "bynk-lang/github-hooks", number: 25, path: "", workflow: "", run_id: 0, attempt: 0, status: "closed", conclusion: "merged" }
}

case "a pull request's redelivery pushes nothing more" {
	let _ <- api.POST("/github", pullHeaders("pr-live-1"), Bytes.fromUtf8(mergedPull)) by GitHub
	let _ <- api.POST("/github", pullHeaders("pr-live-1"), Bytes.fromUtf8(mergedPull)) by GitHub
	expect LiveFeed.publish called once
}

case "a private repository's pull request is never pushed" {
	let _ <- api.POST(
		"/github",
		pullHeaders("pr-private-1"),
		Bytes.fromUtf8(mergedPull.replace("\"private\": false", "\"private\": true"))
	) by GitHub
	expect LiveFeed.publish never called
}

case "a change purges the metrics routes' edge cache, so pages can refetch at once" {
	stub Edge.purge(_) returns true
	let _ <- api.POST("/github", pullHeaders("pr-edge-1"), Bytes.fromUtf8(mergedPull)) by GitHub
	expect Edge.purge called once with prefixes == ["/metrics/"]
	expect LiveFeed.publish called once with e.refetch_ms == 3000
}

case "a second change within 15 seconds isn't purged, so pages wait for the cache to expire" {
	stub Edge.purge(_) returns true
	let _ <- api.POST("/github", runHeaders("edge-run"), Bytes.fromUtf8(completedRun)) by GitHub
	let _ <- api.POST("/github", pullHeaders("edge-pr"), Bytes.fromUtf8(mergedPull)) by GitHub
	expect Edge.purge called once
	expect LiveFeed.publish called with e.kind == "run" && e.refetch_ms == 3000
	expect LiveFeed.publish called with e.kind == "pull" && e.refetch_ms == 31000
}

case "a purge Cloudflare refuses tells pages to wait for the cache to expire" {
	stub Edge.purge(_) returns false
	let _ <- api.POST("/github", pullHeaders("pr-refused"), Bytes.fromUtf8(mergedPull)) by GitHub
	expect LiveFeed.publish called once with e.refetch_ms == 31000
	expect Logger.warn called once with msg.startsWith("Cloudflare refused the edge purge")
}

case "a public issue's delivery is pushed, as an issue" {
	let seeded <- Deliveries.run(
		"INSERT INTO repositories (repo, public, default_branch) VALUES ('bynk-lang/bynk', 1, 'main')",
		[]
	)
	expect seeded is Ok(_)
	let _ <- api.POST(
		"/github",
		RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: issue-live"]),
		Bytes.fromUtf8(closedIssue)
	) by GitHub
	expect LiveFeed.publish called once with e == LiveEvent { refetch_ms: 3000, kind: "issue", repo: "bynk-lang/bynk", number: 2982, path: "", workflow: "", run_id: 0, attempt: 0, status: "closed", conclusion: "closed" }
	// A redelivery tells nothing new.
	let _ <- api.POST(
		"/github",
		RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: issue-live"]),
		Bytes.fromUtf8(closedIssue)
	) by GitHub
	expect LiveFeed.publish called once
}

case "a comment on a pull request pushes nothing" {
	let _ <- api.POST(
		"/github",
		RequestHeaders.of(["X-GitHub-Event: issue_comment", "X-GitHub-Delivery: pr-comment"]),
		Bytes.fromUtf8(
			commented.replace(
				"\"number\": 2982,",
				"\"number\": 2982,\n    \"pull_request\": {\"url\": \"https://api.github.com/repos/bynk-lang/bynk/pulls/2982\"},"
			)
		)
	) by GitHub
	expect LiveFeed.publish never called
}
