// Phase 3 end to end, through the webhook: the delivery is recorded, then the
// bot reacts. Signing is real (a key pair made for these tests only), D1 is
// in-memory SQLite with the migrations applied, Tokens is the in-memory KV
// double, and Fetch is stubbed: first the token exchange, then the comment.
suite github.hooks

env {
	ACTION_REPOS = "bynk-lang/github-hooks-sandbox"
	APP_CLIENT_ID = "Iv1.testclient"
	APP_PRIVATE_KEY = ""
}

case "a first-timer's issue is welcomed, as the App's installation" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\", \"expires_at\": \"2026-11-04T06:00:00Z\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-1"])
	let r <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 7, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect r == Accepted("recorded")
	expect Fetch.send called 2 times
	expect Fetch.send called with req.url == "https://api.github.com/app/installations/42/access_tokens"
	expect Fetch.send called with req.url == "https://api.github.com/repos/bynk-lang/github-hooks-sandbox/issues/7/comments" && req.authorization == Some("Bearer ghs_test") && req.headers.get("user-agent") == Some("bynk-lang-github-hooks")
	expect Logger.info called with msg == "welcomed newcomer on bynk-lang/github-hooks-sandbox#7"
	let row <- Deliveries.first(
		"SELECT status FROM actions WHERE delivery = 'w-1' AND action = 'welcome'",
		[]
	)
	expect row == Ok(Some("{\"status\":\"done\"}"))
}

case "the JWT the App sends verifies with the App's public key" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-jwt"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 1, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	let calls = trace(Fetch.send)
	let Some(first) = calls.get(0) else {
		expect false
	}
	let Some(bearer) = first.req.authorization else {
		expect false
	}
	let jwt = bearer.slice(7, bearer.length())
	let parts = jwt.split(".")
	expect parts.length() == 3
	let Some(head) = parts.get(0) else {
		expect false
	}
	let Some(claims) = parts.get(1) else {
		expect false
	}
	let Some(sigText) = parts.get(2) else {
		expect false
	}
	let Some(sig) = Bytes.fromBase64Url(sigText) else {
		expect false
	}
	let Some(spki) = Bytes.fromBase64(
		""
	) else {
		expect false
	}
	let Ok(vk) <- Crypto.importVerifyKey(RsaPkcs1Sha256, spki) else match {
		Err(_) => expect false,
	}
	let ok <- Crypto.verify(vk, Bytes.fromUtf8("\(head).\(claims)"), sig)
	expect ok
}

case "a token is minted once and reused for the next welcome" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let a = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-a"])
	let b = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-b"])
	let _ <- api.POST(
		"/github",
		a,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 1, "user": { "login": "first" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		b,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 2, "user": { "login": "second" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send called 3 times
	expect Fetch.send called once with req.url == "https://api.github.com/app/installations/42/access_tokens"
}

case "a repository not in ACTION_REPOS is left alone" {
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-2"])
	let r <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/bynk" }, "installation": { "id": 42 },
			  "issue": { "number": 9, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect r == Accepted("recorded")
	expect Fetch.send never called
	expect Logger.info called with msg == "welcome for bynk-lang/bynk#9 skipped: not in ACTION_REPOS"
}

case "a sandbox can widen who is welcomed" {
	env {
		WELCOME_ASSOCIATIONS = "FIRST_TIMER,FIRST_TIME_CONTRIBUTOR,OWNER"
	}
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-own"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 8, "user": { "login": "the-owner" }, "author_association": "OWNER" } }
			"""
		)
	) by GitHub
	expect Logger.info called with msg == "welcomed the-owner on bynk-lang/github-hooks-sandbox#8"
}

case "a known contributor's issue is not welcomed" {
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-3"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 9, "user": { "login": "regular" }, "author_association": "MEMBER" } }
			"""
		)
	) by GitHub
	expect Fetch.send never called
}

case "a redelivery of a welcome that worked does not comment again" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-4"])
	let body = Bytes.fromUtf8(
		"""
		{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
		  "issue": { "number": 4, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
		"""
	)
	let first <- api.POST("/github", h, body) by GitHub
	let again <- api.POST("/github", h, body) by GitHub
	expect first == Accepted("recorded")
	expect again == Ok("duplicate")
	expect Fetch.send called 2 times
	expect Logger.info called with msg == "welcome for w-4 already done or in progress"
}

case "a refused comment is recorded as failed, and a redelivery retries it" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 403, headers: Map.empty(), body: "{\"message\": \"Resource not accessible by integration\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-5"])
	let body = Bytes.fromUtf8(
		"""
		{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
		  "issue": { "number": 5, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
		"""
	)
	let _ <- api.POST("/github", h, body) by GitHub
	let failed <- Deliveries.first("SELECT status, detail FROM actions WHERE delivery = 'w-5'", [])
	expect failed == Ok(Some("{\"status\":\"failed\",\"detail\":\"GitHub refused the comment on bynk-lang/github-hooks-sandbox#5: 403\"}"))
	expect Logger.error called once with msg == "could not welcome newcomer on bynk-lang/github-hooks-sandbox#5: GitHub refused the comment on bynk-lang/github-hooks-sandbox#5: 403"
	let _ <- api.POST("/github", h, body) by GitHub
	expect Fetch.send called 3 times
	let done <- Deliveries.first("SELECT status FROM actions WHERE delivery = 'w-5'", [])
	expect done == Ok(Some("{\"status\":\"done\"}"))
}

case "without the App's credentials, nothing is sent and the failure is recorded" {
	env {
		APP_CLIENT_ID = ""
	}
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-6"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 6, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send never called
	let row <- Deliveries.first("SELECT status FROM actions WHERE delivery = 'w-6'", [])
	expect row == Ok(Some("{\"status\":\"failed\"}"))
}
