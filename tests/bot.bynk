// TEST-ONLY KEY: APP_PRIVATE_KEY below (and the public key in the JWT case)
// was generated for these tests with `openssl genpkey`, has never belonged to
// any GitHub App, and grants nothing. The same key is in tests/app.bynk; rotate
// both together. It stays inline: an `env` value must be a `String` literal,
// so the suite cannot read it from a fixture.
//
// Phase 3 end to end, through the webhook: the delivery is recorded, then the
// bot reacts. Signing is real (with that test key), D1 is
// in-memory SQLite with the migrations applied, Tokens is the in-memory KV
// double, and Fetch is stubbed: first the token exchange, then the comment.
suite github.hooks

env {
	ACTION_REPOS = "bynk-lang/github-hooks-sandbox"
	APP_CLIENT_ID = "Iv1.testclient"
	APP_PRIVATE_KEY = ""
}

case "a first-timer's issue is welcomed, as the App's installation" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\", \"expires_at\": \"2026-11-04T06:00:00Z\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-1"])
	let r <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 7, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect r == Accepted("recorded")
	expect Fetch.send called 2 times
	expect Fetch.send called with req.url == "https://api.github.com/app/installations/42/access_tokens"
	expect Fetch.send called with req.url == "https://api.github.com/repos/bynk-lang/github-hooks-sandbox/issues/7/comments" && req.authorization == Some("Bearer ghs_test") && req.headers.get("user-agent") == Some("bynk-lang-github-hooks")
	expect Logger.info called with msg == "welcomed newcomer on bynk-lang/github-hooks-sandbox#7"
	let row <- Deliveries.first(
		"SELECT status FROM actions WHERE delivery = 'w-1' AND action = 'welcome'",
		[]
	)
	expect row == Ok(Some("{\"status\":\"done\"}"))
}

case "the JWT the App sends verifies with the App's public key" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-jwt"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 1, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	let calls = trace(Fetch.send)
	let Some(first) = calls.get(0) else {
		expect false
	}
	let Some(bearer) = first.req.authorization else {
		expect false
	}
	let jwt = bearer.slice(7, bearer.length())
	let parts = jwt.split(".")
	expect parts.length() == 3
	let Some(head) = parts.get(0) else {
		expect false
	}
	let Some(claims) = parts.get(1) else {
		expect false
	}
	let Some(sigText) = parts.get(2) else {
		expect false
	}
	let Some(sig) = Bytes.fromBase64Url(sigText) else {
		expect false
	}
	let Some(spki) = Bytes.fromBase64(
		""
	) else {
		expect false
	}
	let Ok(vk) <- Crypto.importVerifyKey(RsaPkcs1Sha256, spki) else match {
		Err(_) => expect false,
	}
	let ok <- Crypto.verify(vk, Bytes.fromUtf8("\(head).\(claims)"), sig)
	expect ok
}

case "a token is minted once and reused for the next welcome" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let a = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-a"])
	let b = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-b"])
	let _ <- api.POST(
		"/github",
		a,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 1, "user": { "login": "first" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		b,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 2, "user": { "login": "second" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send called 3 times
	expect Fetch.send called once with req.url == "https://api.github.com/app/installations/42/access_tokens"
}

case "a repository not in ACTION_REPOS is left alone" {
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-2"])
	let r <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/bynk" }, "installation": { "id": 42 },
			  "issue": { "number": 9, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect r == Accepted("recorded")
	expect Fetch.send never called
	expect Logger.info called with msg == "welcome for bynk-lang/bynk#9 skipped: not in ACTION_REPOS"
}

case "a sandbox can widen who is welcomed" {
	env {
		WELCOME_ASSOCIATIONS = "FIRST_TIMER,FIRST_TIME_CONTRIBUTOR,OWNER"
	}
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-own"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 8, "user": { "login": "the-owner" }, "author_association": "OWNER" } }
			"""
		)
	) by GitHub
	expect Logger.info called with msg == "welcomed the-owner on bynk-lang/github-hooks-sandbox#8"
}

case "a known contributor's issue is not welcomed" {
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-3"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 9, "user": { "login": "regular" }, "author_association": "MEMBER" } }
			"""
		)
	) by GitHub
	expect Fetch.send never called
	expect Logger.info called with msg == "welcome for w-3 skipped: regular is MEMBER, not in WELCOME_ASSOCIATIONS (FIRST_TIMER,FIRST_TIME_CONTRIBUTOR)"
}

case "a redelivery of a welcome that worked does not comment again" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-4"])
	let body = Bytes.fromUtf8(
		"""
		{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
		  "issue": { "number": 4, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
		"""
	)
	let first <- api.POST("/github", h, body) by GitHub
	let again <- api.POST("/github", h, body) by GitHub
	expect first == Accepted("recorded")
	expect again == Ok("duplicate")
	expect Fetch.send called 2 times
	expect Logger.info called with msg == "welcome for w-4 already done or in progress"
}

case "a refused comment evicts the token and retries once with a fresh one" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 403, headers: Map.empty(), body: "{\"message\": \"Resource not accessible by integration\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_fresh\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-fresh"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 11, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send called 4 times
	expect Tokens.delete called once with key == "installation:42"
	expect Fetch.send called with req.authorization == Some("Bearer ghs_fresh")
	expect Logger.info called with msg == "welcomed newcomer on bynk-lang/github-hooks-sandbox#11"
}

case "a comment refused twice is recorded as failed, and a redelivery retries it" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 403, headers: Map.empty(), body: "{\"message\": \"Resource not accessible by integration\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 403, headers: Map.empty(), body: "{\"message\": \"Resource not accessible by integration\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-5"])
	let body = Bytes.fromUtf8(
		"""
		{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
		  "issue": { "number": 5, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
		"""
	)
	let _ <- api.POST("/github", h, body) by GitHub
	let failed <- Deliveries.first("SELECT status, detail FROM actions WHERE delivery = 'w-5'", [])
	expect failed == Ok(Some("{\"status\":\"failed\",\"detail\":\"GitHub refused the comment on bynk-lang/github-hooks-sandbox#5: 403 Resource not accessible by integration\"}"))
	let released <- Deliveries.first("SELECT login FROM welcomed", [])
	expect released == Ok(None)
	let _ <- api.POST("/github", h, body) by GitHub
	expect Fetch.send called 5 times
	let done <- Deliveries.first("SELECT status FROM actions WHERE delivery = 'w-5'", [])
	expect done == Ok(Some("{\"status\":\"done\"}"))
}

case "a refused token is recorded with GitHub's message" {
	stub Fetch.send(_) returns each [Ok(Response { status: 404, headers: Map.empty(), body: "{\"message\": \"Not Found\", \"documentation_url\": \"https://docs.github.com/rest\"}" })]
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-t"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 6, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send called once
	let failed <- Deliveries.first("SELECT status, detail FROM actions WHERE delivery = 'w-t'", [])
	expect failed == Ok(Some("{\"status\":\"failed\",\"detail\":\"GitHub refused a token for installation 42: 404 Not Found\"}"))
}

case "a person is welcomed once per repository, however many pull requests they open" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let first = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-p1"])
	let second = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-p2"])
	let _ <- api.POST(
		"/github",
		first,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 21, "user": { "login": "Newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		second,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 22, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send called 2 times
	expect Logger.info called with msg == "newcomer was already welcomed in bynk-lang/github-hooks-sandbox; not again for #22"
	let row <- Deliveries.first("SELECT status, detail FROM actions WHERE delivery = 'w-p2'", [])
	expect row == Ok(Some("{\"status\":\"done\",\"detail\":\"newcomer was already welcomed in bynk-lang/github-hooks-sandbox\"}"))
}

case "a claim left started by a stopped Worker is taken over after 10 minutes" {
	stub Fetch.send(_) returns each [Ok(Response { status: 201, headers: Map.empty(), body: "{\"token\": \"ghs_test\"}" }), Ok(Response { status: 201, headers: Map.empty(), body: "{}" })]
	let _ <- Deliveries.run(
		"INSERT INTO actions (delivery, action, status, at) VALUES ('w-stale', 'welcome', 'started', '2026-01-01T00:00:00.000Z')",
		[]
	)
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-stale"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 31, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send called 2 times
	let done <- Deliveries.first("SELECT status FROM actions WHERE delivery = 'w-stale'", [])
	expect done == Ok(Some("{\"status\":\"done\"}"))
}

case "a claim started moments ago is left to finish" {
	let _ <- Deliveries.run(
		"INSERT INTO actions (delivery, action, status) VALUES ('w-busy', 'welcome', 'started')",
		[]
	)
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-busy"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 32, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send never called
	expect Logger.info called with msg == "welcome for w-busy already done or in progress"
}

case "without the App's credentials, nothing is sent and the failure is recorded" {
	env {
		APP_CLIENT_ID = ""
	}
	let h = RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: w-6"])
	let _ <- api.POST(
		"/github",
		h,
		Bytes.fromUtf8(
			"""
			{ "action": "opened", "repository": { "full_name": "bynk-lang/github-hooks-sandbox" }, "installation": { "id": 42 },
			  "issue": { "number": 6, "user": { "login": "newcomer" }, "author_association": "FIRST_TIMER" } }
			"""
		)
	) by GitHub
	expect Fetch.send never called
	let row <- Deliveries.first("SELECT status FROM actions WHERE delivery = 'w-6'", [])
	expect row == Ok(Some("{\"status\":\"failed\"}"))
}
