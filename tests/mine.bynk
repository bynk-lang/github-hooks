--- No Claude calls today, against the default caps.
fn noClaude() -> ClaudeToday {
	ClaudeToday {
		calls: 0,
		busiest: 0,
		repo_cap: 50,
		total_cap: 200,
	}
}

case "a maintainer's own work, across public and private repositories" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET("/maintainers/mine") by Maintainer("accuser")
	expect r == Ok(Mine {
		login: "accuser",
		pulls: [
			MyPull {
				repo: "bynk-lang/secret",
				number: 4,
				title: "Four",
				stage: "queued",
				opened_at: "2026-10-30T00:00:00.000Z",
				ready_since: Some("2026-10-30T00:00:00.000Z"),
				ci: Some("running"),
			},
			MyPull {
				repo: "bynk-lang/bynk",
				number: 1,
				title: "One",
				stage: "ready",
				opened_at: "2026-11-01T00:00:00.000Z",
				ready_since: Some("2026-11-01T00:00:00.000Z"),
				ci: Some("failing"),
			},
			MyPull {
				repo: "bynk-lang/bynk",
				number: 2,
				title: "Two",
				stage: "ready",
				opened_at: "2026-11-02T00:00:00.000Z",
				ready_since: Some("2026-11-02T00:00:00.000Z"),
				ci: Some("passing"),
			},
			MyPull {
				repo: "bynk-lang/bynk",
				number: 3,
				title: "Three",
				stage: "draft",
				opened_at: "2026-11-03T00:00:00.000Z",
				ready_since: None,
				ci: None,
			},
		],
		reviews: [
			ReviewWaiting {
				repo: "bynk-lang/bynk",
				number: 5,
				title: "Five",
				author: "a-person",
				draft: false,
				opened_at: "2026-11-04T00:00:00.000Z",
				ready_since: Some("2026-11-04T00:00:00.000Z"),
			},
		],
		issues: [
			MyIssue {
				repo: "bynk-lang/bynk",
				number: 10,
				title: "Ten",
				opened_at: "2026-10-01T00:00:00.000Z",
				updated_at: "2026-10-10T00:00:00.000Z",
				stale: true,
			},
			MyIssue {
				repo: "bynk-lang/secret",
				number: 11,
				title: "Eleven",
				opened_at: "2026-11-04T00:00:00.000Z",
				updated_at: "2026-11-04T00:00:00.000Z",
				stale: false,
			},
		],
		unreleased: [
			MyMerge {
				repo: "bynk-lang/bynk",
				number: 20,
				title: "Twenty",
				merged_at: "2026-11-03T00:00:00.000Z",
			},
		],
		proposals: [],
		claude: noClaude(),
	})
}

case "someone with nothing to act on gets empty lists, not an error" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let kept <- Deliveries.run(
		"INSERT INTO org_members (org, login, member, checked_at) VALUES ('bynk-lang', 'new-person', 1, '2026-11-05T11:00:00.000Z')",
		[]
	)
	expect kept is Ok(_)
	let r <- api.GET("/maintainers/mine") by Maintainer("new-person")
	expect r == Ok(Mine {
		login: "new-person",
		pulls: [],
		reviews: [],
		issues: [],
		unreleased: [],
		proposals: [],
		claude: noClaude(),
	})
}

case "it is a maintainer's alone: someone who has left is refused" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns Ok(Response { status: 404, headers: Map.empty(), body: "{\"message\": \"Not Found\"}" })
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let installed <- Deliveries.run(
		"INSERT INTO deliveries (id, event, repo, installation, size, received_at) VALUES ('d-1', 'push', 'bynk-lang/bynk', 42, 1, '2026-11-05T00:00:00.000Z')",
		[]
	)
	expect installed is Ok(_)
	let r <- api.GET("/maintainers/mine") by Maintainer("a-leaver")
	expect r is RawError(403, _, _)
}
