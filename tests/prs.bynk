case "a week of PR flow for people, with bots apart, from public repositories" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET("/metrics/prs", PrQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.since == "2026-10-29T12:00:00.000Z"
	expect m.until == "2026-11-05T12:00:00.000Z"
	// The first merge recorded, in any repository (#5).
	expect m.data_since == Some("2026-10-20T00:00:00.000Z")
	expect m.repos.map((f) => f.repo) == ["bynk-lang/bynk"]
	let Some(f) = m.repos.first() else {
		expect false
	}
	expect f.merged == 3
	expect f.closed_unmerged == 1
	expect f.ready_to_merge_counted == 2
	expect f.ready_to_merge_p50_seconds == Some(3600)
	expect f.ready_to_merge_p95_seconds == Some(7200)
	expect f.open_to_merge_p50_seconds == Some(43200)
	expect f.open_to_merge_p95_seconds == Some(86400)
	expect f.queue_counted == 2
	expect f.queue_p50_seconds == Some(1200)
	expect f.queue_p95_seconds == Some(1800)
	expect f.requeued == 1
	expect f.size_counted == 2
	expect f.size_p50_lines == Some(10)
	expect f.bots_merged == 1
	expect f.bots_open == 1
	expect f.bots_merge_p50_seconds == Some(3600)
}

case "queue exits other than a merge, and merges by day" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET("/metrics/prs", PrQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	// MERGE is the normal way out; the excluded and private repositories' exits don't show.
	expect m.queue_exits.map(
		(x) => "\(x.repo) \(x.reason) \(x.count)"
	) == ["bynk-lang/bynk CI_FAILURE 3", "bynk-lang/bynk unknown 1"]
	expect m.daily.map(
		(d) => "\(d.day) \(d.merged)"
	) == ["2026-11-03 1", "2026-11-04 1", "2026-11-05 1"]
}

case "a longer window reaches further back, and a repository filter narrows it" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let month <- api.GET(
		"/metrics/prs",
		PrQuery {
			repo: Some("Bynk-Lang/Bynk"),
			days: 30,
		},
		viewer()
	) by Visitor
	let Ok(m) = month else {
		expect false
	}
	expect m.repos.map((f) => "\(f.repo) \(f.merged)") == ["bynk-lang/bynk 4"]
	let other <- api.GET(
		"/metrics/prs",
		PrQuery {
			repo: Some("bynk-lang/other"),
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(o) = other else {
		expect false
	}
	expect o.repos.length() == 0
	expect o.daily.length() == 0
}

case "open pull requests, longest waiting first and drafts last, with where each one is" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET("/metrics/prs/open", NowQuery { repo: None }, viewer()) by Visitor
	let Ok(o) = r else {
		expect false
	}
	expect o.open.map(
		(p) => "#\(p.number) \(p.stage)\(if p.stale { " stale" } else { "" })\(if p.author_is_bot { " bot" } else { "" })"
	) == ["#9 ready stale", "#7 ready bot", "#10 queued", "#12 ready", "#14 ready", "#8 draft"]
	let Some(nine) = o.open.first() else {
		expect false
	}
	expect nine.ready_since == Some("2026-10-25T00:00:00.000Z")
	// Made ready again today, so it waits from today, not from 1 October.
	expect o.open
		.filter((p) => p.number == 14)
		.map((p) => p.ready_since) == [Some("2026-11-05T11:30:00.000Z")]
	expect nine.title == "Nine"
}

case "an empty table is empty lists, not an error" {
	let r <- api.GET("/metrics/prs", PrQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.repos.length() == 0
	expect m.data_since == None
	let o <- api.GET("/metrics/prs/open", NowQuery { repo: None }, viewer()) by Visitor
	expect o == Ok(PrsOpen { open: [] })
}

case "a window other than 7, 30 or 90 days is refused, and the limit applies to both routes" {
	stub MetricsLimit.allow(_) returns each [true, false, false]
	let bad <- api.GET("/metrics/prs", PrQuery { repo: None, days: 14 }, viewer()) by Visitor
	expect bad is BadRequest("days must be 7, 30 or 90")
	let limited <- api.GET("/metrics/prs", PrQuery { repo: None, days: 7 }, viewer()) by Visitor
	expect limited is TooManyRequests(_)
	let open <- api.GET("/metrics/prs/open", NowQuery { repo: None }, viewer()) by Visitor
	expect open is TooManyRequests(_)
	expect Deliveries.all never called
}

--- accuser, a maintainer: GitHub's kept answer, so the maintainer routes need no GitHub stub.
fn keptMaintainer() -> SqlStatement {
	SqlStatement {
		sql: "INSERT INTO org_members (org, login, member, checked_at) VALUES ('bynk-lang', 'accuser', 1, '2026-11-06T00:00:00.000Z')",
		params: [],
	}
}

case "a maintainer's PR flow includes private and excluded repositories; the public's never does" {
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let public0 <- api.GET("/metrics/prs", PrQuery { repo: None, days: 7 }, viewer()) by Visitor
	let mine0 <- api.POST("/maintainers/metrics/prs", PrQuery {
		repo: None,
		days: 7,
	}) by Maintainer("accuser")
	let Ok(p0) = public0 else {
		expect false
	}
	let Ok(m0) = mine0 else {
		expect false
	}
	// /metrics/prs: the public never see the private or excluded repository; a maintainer sees both.
	let pt0 = Json.encode(p0)
	let mt0 = Json.encode(m0)
	expect !pt0.contains("bynk-lang/secret") && !pt0.contains("bynk-lang/sandbox")
	expect mt0.contains("bynk-lang/secret") && mt0.contains("bynk-lang/sandbox")
	expect mt0.contains("bynk-lang/bynk")
	let public1 <- api.GET("/metrics/prs/open", NowQuery { repo: None }, viewer()) by Visitor
	let mine1 <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	let Ok(p1) = public1 else {
		expect false
	}
	let Ok(m1) = mine1 else {
		expect false
	}
	// /metrics/prs/open: the public never see the private or excluded repository; a maintainer sees both.
	let pt1 = Json.encode(p1)
	let mt1 = Json.encode(m1)
	expect !pt1.contains("bynk-lang/secret") && !pt1.contains("bynk-lang/sandbox")
	expect mt1.contains("bynk-lang/secret") && mt1.contains("bynk-lang/sandbox")
	expect mt1.contains("bynk-lang/bynk")
}

case "a maintainer's PR figures are shared until a pull request or release purge, not a run's (#62)" {
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let first <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	expect first is Ok(_)
	let cleared <- Deliveries.run("DELETE FROM pull_requests", [])
	expect cleared is Ok(_)
	// A run's purge leaves PR flow's shared answer alone.
	let run <- Deliveries.run(
		"UPDATE edge_purge_slots SET at = '2026-11-05T11:59:00.000Z' WHERE slot = 'runs'",
		[]
	)
	expect run is Ok(_)
	let afterRun <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	expect afterRun == first
	// A pull request's purge moves it on, so the cleared table is read.
	let flow <- Deliveries.run(
		"UPDATE edge_purge_slots SET at = '2026-11-05T11:59:30.000Z' WHERE slot = 'flow'",
		[]
	)
	expect flow is Ok(_)
	let afterFlow <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	expect afterFlow == Ok(PrsOpen { open: [] })
}

case "a change only the maintainers' board hears moves their shared PR figures on too (#68)" {
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let first <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	expect first is Ok(_)
	let cleared <- Deliveries.run("DELETE FROM pull_requests", [])
	expect cleared is Ok(_)
	// A hidden run leaves PR flow's shared answer alone.
	let run <- Deliveries.run(
		"UPDATE hidden_changes SET at = '2026-11-05T11:59:00.000Z' WHERE slot = 'runs'",
		[]
	)
	expect run is Ok(_)
	let afterRun <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	expect afterRun == first
	// A hidden pull request moves it on, with no edge purge.
	let flow <- Deliveries.run(
		"UPDATE hidden_changes SET at = '2026-11-05T11:59:30.000Z' WHERE slot = 'flow'",
		[]
	)
	expect flow is Ok(_)
	let afterFlow <- api.POST(
		"/maintainers/metrics/prs/open",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	expect afterFlow == Ok(PrsOpen { open: [] })
}
