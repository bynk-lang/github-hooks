// Phase 4, step 2 (#20): the public CI metrics, against an in-memory D1 with
// the migrations applied and a hand-built set of runs whose numbers are worked
// out below. The clock is fixed at 2026-11-05T12:00:00Z, so the default 7-day
// window opens at 2026-10-29T12:00:00Z.
suite github.hooks

env {
	DASHBOARD_EXCLUDE = "bynk-lang/sandbox"
}

stub Clock.now() returns Instant.fromEpochMillis(1793880000000)

--- A viewer's request headers: one address, well within the limit.
fn viewer() -> RequestHeaders {
	RequestHeaders.of(["CF-Connecting-IP: 203.0.113.7"])
}

---
The runs every case reads. In `bynk-lang/bynk`'s CI (`ci.yml`), within the
window: r1 600 s, r2 1200 s, r3 1800 s (a PR branch) and r4's re-run 600 s
succeed; r4's first attempt fails (so r4 is flaky); r5 is cancelled, r6
skipped and r7 timed out, last of all on `main`. So 8 runs, 4 successes, 6
judged: 67 % pass; successful wall-clock 600, 600, 1200, 1800: p50 600, p95
1800. r8 completed before the window, r9 is running, r10 has been "running"
for two days. CodeQL last passed on `main`. A private repository and an
excluded one have a passing run each, and must not appear.
---
fn seed() -> List[SqlStatement] {
	[
		SqlStatement {
			sql: """
				INSERT INTO repositories (repo, public, default_branch) VALUES
				  ('bynk-lang/bynk', 1, 'main'), ('bynk-lang/secret', 0, 'main'), ('bynk-lang/sandbox', 1, 'main')
			""",
			params: [],
		},
		SqlStatement {
			sql: """
				INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
				                           created_at, queued_at, started_at, completed_at, updated_at) VALUES
				  ('bynk-lang/bynk', 1, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a1', 'push', 'completed', 'success',
				   '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:10:00.000Z', '2026-11-05T10:10:00.000Z'),
				  ('bynk-lang/bynk', 2, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a2', 'push', 'completed', 'success',
				   '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:20:00.000Z', '2026-11-05T10:20:00.000Z'),
				  ('bynk-lang/bynk', 3, 1, 'CI', '.github/workflows/ci.yml', 'feature', 'a3', 'pull_request', 'completed', 'success',
				   '2026-11-05T09:00:00.000Z', '2026-11-05T09:00:00.000Z', '2026-11-05T09:00:00.000Z', '2026-11-05T09:30:00.000Z', '2026-11-05T09:30:00.000Z'),
				  ('bynk-lang/bynk', 4, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a4', 'push', 'completed', 'failure',
				   '2026-11-05T08:00:00.000Z', '2026-11-05T08:00:00.000Z', '2026-11-05T08:00:00.000Z', '2026-11-05T08:05:00.000Z', '2026-11-05T08:05:00.000Z'),
				  ('bynk-lang/bynk', 4, 2, 'CI', '.github/workflows/ci.yml', 'main', 'a4', 'push', 'completed', 'success',
				   '2026-11-05T08:00:00.000Z', '2026-11-05T08:10:00.000Z', '2026-11-05T08:10:00.000Z', '2026-11-05T08:20:00.000Z', '2026-11-05T08:20:00.000Z'),
				  ('bynk-lang/bynk', 5, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a5', 'push', 'completed', 'cancelled',
				   '2026-11-05T10:30:00.000Z', '2026-11-05T10:30:00.000Z', '2026-11-05T10:30:00.000Z', '2026-11-05T10:31:00.000Z', '2026-11-05T10:31:00.000Z'),
				  ('bynk-lang/bynk', 6, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a6', 'push', 'completed', 'skipped',
				   '2026-11-05T10:40:00.000Z', '2026-11-05T10:40:00.000Z', '2026-11-05T10:40:00.000Z', '2026-11-05T10:40:05.000Z', '2026-11-05T10:40:05.000Z'),
				  ('bynk-lang/bynk', 7, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a7', 'push', 'completed', 'timed_out',
				   '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T11:00:00.000Z', '2026-11-05T11:00:00.000Z'),
				  ('bynk-lang/bynk', 8, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a8', 'push', 'completed', 'success',
				   '2026-10-20T10:00:00.000Z', '2026-10-20T10:00:00.000Z', '2026-10-20T10:00:00.000Z', '2026-10-20T10:10:00.000Z', '2026-10-20T10:10:00.000Z'),
				  ('bynk-lang/bynk', 9, 1, 'CI', '.github/workflows/ci.yml', 'feature', 'a9', 'pull_request', 'in_progress', NULL,
				   '2026-11-05T11:55:00.000Z', '2026-11-05T11:55:00.000Z', '2026-11-05T11:55:00.000Z', NULL, '2026-11-05T11:56:00.000Z'),
				  ('bynk-lang/bynk', 10, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a10', 'push', 'in_progress', NULL,
				   '2026-11-03T10:00:00.000Z', '2026-11-03T10:00:00.000Z', '2026-11-03T10:00:00.000Z', NULL, '2026-11-03T10:00:00.000Z'),
				  ('bynk-lang/bynk', 11, 1, 'CodeQL', '.github/workflows/codeql.yml', 'main', 'a11', 'push', 'completed', 'success',
				   '2026-11-05T11:00:00.000Z', '2026-11-05T11:00:00.000Z', '2026-11-05T11:00:00.000Z', '2026-11-05T11:30:00.000Z', '2026-11-05T11:30:00.000Z'),
				  ('bynk-lang/secret', 12, 1, 'CI', '.github/workflows/ci.yml', 'main', 'b1', 'push', 'completed', 'success',
				   '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:10:00.000Z', '2026-11-05T10:10:00.000Z'),
				  ('bynk-lang/sandbox', 13, 1, 'CI', '.github/workflows/ci.yml', 'main', 'c1', 'push', 'completed', 'success',
				   '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:00:00.000Z', '2026-11-05T10:10:00.000Z', '2026-11-05T10:10:00.000Z')
			""",
			params: [],
		},
	]
}

case "a week of CI health, from completed attempts in public repositories" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.since == "2026-10-29T12:00:00.000Z"
	expect m.until == "2026-11-05T12:00:00.000Z"
	expect m.data_since == Some("2026-10-20T10:10:00.000Z")
	expect m.workflows.map(
		(w) => "\(w.repo) \(w.path)"
	) == ["bynk-lang/bynk .github/workflows/ci.yml", "bynk-lang/bynk .github/workflows/codeql.yml"]
	let Some(ci) = m.workflows.first() else {
		expect false
	}
	expect ci.workflow == "CI"
	expect ci.runs == 8
	expect ci.success == 4
	expect ci.failure == 1
	expect ci.timed_out == 1
	expect ci.cancelled == 1
	expect ci.skipped == 1
	expect ci.other == 0
	expect ci.pass_percent == Some(67)
	expect ci.wall_p50_seconds == Some(600)
	expect ci.wall_p95_seconds == Some(1800)
	expect ci.flaky == 1
}

case "filters narrow the window: branch, trigger, repository (any case) and length" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	// On main: r1, r2, r4 (both attempts), r5, r6, r7 = 7 runs; 3 of 5 judged pass;
	// successful 600, 1200, 600 s: p50 600, p95 1200. CodeQL runs on main too.
	let onMain <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: Some("main"),
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(m) = onMain else {
		expect false
	}
	let Some(ci) = m.workflows.first() else {
		expect false
	}
	expect ci.runs == 7
	expect ci.pass_percent == Some(60)
	expect ci.wall_p50_seconds == Some(600)
	expect ci.wall_p95_seconds == Some(1200)
	expect m.workflows.length() == 2
	// Pull requests only: r3, one run, 30 minutes.
	let prs <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: Some("pull_request"),
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(p) = prs else {
		expect false
	}
	expect p.workflows.map(
		(w) => "\(w.path) \(w.runs) \(w.pass_percent.getOrElse(-1)) \(w.wall_p50_seconds.getOrElse(-1)) \(w.wall_p95_seconds.getOrElse(-1))"
	) == [".github/workflows/ci.yml 1 100 1800 1800"]
	// 30 days reach r8 too; the repository matches whatever its case.
	let month <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: Some("Bynk-Lang/BYNK"),
			branch: None,
			event: None,
			days: 30,
		},
		viewer()
	) by Visitor
	let Ok(mo) = month else {
		expect false
	}
	let Some(ci30) = mo.workflows.first() else {
		expect false
	}
	expect mo.since == "2026-10-06T12:00:00.000Z"
	expect ci30.runs == 9
	expect ci30.success == 5
}

case "an empty window is an empty list, not an error" {
	let r <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.workflows == []
	expect m.data_since == None
}

case "now: what is running, and each workflow's latest result on the default branch" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET("/metrics/ci/now", NowQuery { repo: None }, viewer()) by Visitor
	let Ok(n) = r else {
		expect false
	}
	// r10 has been "running" for two days: its completion was lost, so it's left out.
	expect n.in_flight.map((f) => f.run_id) == [9]
	expect n.main.map(
		(s) => "\(s.path) \(s.conclusion) \(s.red_since.getOrElse("-"))"
	) == [
		".github/workflows/ci.yml timed_out 2026-11-05T11:00:00.000Z",
		".github/workflows/codeql.yml success -",
	]
}

case "red since the first failure after the last success" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	// A later failure on main does not move red_since: it is still r7's 11:00.
	let _ <- Deliveries.run(
		"""
		INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
		                           created_at, queued_at, started_at, completed_at, updated_at)
		VALUES ('bynk-lang/bynk', 20, 1, 'CI', '.github/workflows/ci.yml', 'main', 'd1', 'push', 'completed', 'failure',
		        '2026-11-05T11:30:00.000Z', '2026-11-05T11:30:00.000Z', '2026-11-05T11:30:00.000Z',
		        '2026-11-05T11:40:00.000Z', '2026-11-05T11:40:00.000Z')
		""",
		[]
	)
	let r <- api.GET(
		"/metrics/ci/now",
		NowQuery { repo: Some("bynk-lang/bynk") },
		viewer()
	) by Visitor
	let Ok(n) = r else {
		expect false
	}
	let Some(ci) = n.main.first() else {
		expect false
	}
	expect ci.conclusion == "failure"
	expect ci.completed_at == "2026-11-05T11:40:00.000Z"
	expect ci.red_since == Some("2026-11-05T11:00:00.000Z")
}

case "a re-run after a cancelled first attempt is not flaky" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let _ <- Deliveries.run(
		"""
		INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
		                           created_at, queued_at, started_at, completed_at, updated_at) VALUES
		  ('bynk-lang/bynk', 21, 1, 'CI', '.github/workflows/ci.yml', 'main', 'e1', 'push', 'completed', 'cancelled',
		   '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z',
		   '2026-11-04T10:01:00.000Z', '2026-11-04T10:01:00.000Z'),
		  ('bynk-lang/bynk', 21, 2, 'CI', '.github/workflows/ci.yml', 'main', 'e1', 'push', 'completed', 'success',
		   '2026-11-04T10:00:00.000Z', '2026-11-04T10:05:00.000Z', '2026-11-04T10:05:00.000Z',
		   '2026-11-04T10:15:00.000Z', '2026-11-04T10:15:00.000Z')
		""",
		[]
	)
	let r <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(m) = r else {
		expect false
	}
	let Some(ci) = m.workflows.first() else {
		expect false
	}
	// Still 1: r4 from the seed. Run 21, re-run after a cancellation, adds none.
	expect ci.flaky == 1
}

case "only the default branch decides a workflow's state" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	// CodeQL fails later on a release branch: main is still green.
	let _ <- Deliveries.run(
		"""
		INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
		                           created_at, queued_at, started_at, completed_at, updated_at)
		VALUES ('bynk-lang/bynk', 22, 1, 'CodeQL', '.github/workflows/codeql.yml', 'release', 'f1', 'push',
		        'completed', 'failure', '2026-11-05T11:40:00.000Z', '2026-11-05T11:40:00.000Z',
		        '2026-11-05T11:40:00.000Z', '2026-11-05T11:50:00.000Z', '2026-11-05T11:50:00.000Z')
		""",
		[]
	)
	let r <- api.GET("/metrics/ci/now", NowQuery { repo: None }, viewer()) by Visitor
	let Ok(n) = r else {
		expect false
	}
	expect n.main.map(
		(s) => "\(s.path) \(s.branch) \(s.conclusion)"
	) == [".github/workflows/ci.yml main timed_out", ".github/workflows/codeql.yml main success"]
}

case "a window other than 7, 30 or 90 days is refused, so the cache covers every shape asked" {
	let r <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 14,
		},
		viewer()
	) by Visitor
	expect r is BadRequest("days must be 7, 30 or 90")
	let h <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 14,
		},
		viewer()
	) by Visitor
	expect h is BadRequest("days must be 7, 30 or 90")
	expect Deliveries.all never called
}

case "past the per-address limit, metrics are refused before anything is read" {
	stub MetricsLimit.allow(_) returns false
	let ci <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let now <- api.GET("/metrics/ci/now", NowQuery { repo: None }, viewer()) by Visitor
	let history <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	expect ci is TooManyRequests(_)
	expect now is TooManyRequests(_)
	expect history is TooManyRequests(_)
	expect MetricsLimit.allow called with key == "metrics:203.0.113.7"
	expect Deliveries.all never called
}

---
A nightly workflow with 25 runs, one every 6 hours back from 11:00 on
5 November: run 100 + i completed 6i hours earlier, 5 minutes after it was
queued, and every fifth failed. So 5 November holds i = 1, 4 November
i = 2..5 (3 passed, i = 5 failed), and so on back to 30 October (i = 22..25).
---
fn nightly() -> List[SqlStatement] {
	[
		SqlStatement {
			sql: """
				WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 25)
				INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
				                           created_at, queued_at, started_at, completed_at, updated_at)
				SELECT 'bynk-lang/bynk', 100 + i, 1, 'Nightly', '.github/workflows/nightly.yml', 'main', 'n' || i, 'schedule',
				  'completed', CASE WHEN i % 5 = 0 THEN 'failure' ELSE 'success' END,
				  strftime('%Y-%m-%dT%H:%M:%S.000Z', '2026-11-05T10:55:00', '-' || (6 * i) || ' hours'),
				  strftime('%Y-%m-%dT%H:%M:%S.000Z', '2026-11-05T10:55:00', '-' || (6 * i) || ' hours'),
				  strftime('%Y-%m-%dT%H:%M:%S.000Z', '2026-11-05T10:55:00', '-' || (6 * i) || ' hours'),
				  strftime('%Y-%m-%dT%H:%M:%S.000Z', '2026-11-05T11:00:00', '-' || (6 * i) || ' hours'),
				  strftime('%Y-%m-%dT%H:%M:%S.000Z', '2026-11-05T11:00:00', '-' || (6 * i) || ' hours')
				FROM n
			""",
			params: [],
		},
	]
}

case "history: each workflow's recent attempts, oldest first, from public repositories" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(h) = r else {
		expect false
	}
	expect h.since == "2026-10-29T12:00:00.000Z"
	expect h.until == "2026-11-05T12:00:00.000Z"
	// r8 is before the window; r9 and r10 haven't completed; the private and
	// excluded repositories' runs are left out.
	expect h.recent.map(
		(x) => "\(x.run_id)/\(x.attempt) \(x.conclusion) \(x.wall_seconds)"
	) == [
		"4/1 failure 300",
		"4/2 success 600",
		"3/1 success 1800",
		"1/1 success 600",
		"2/1 success 1200",
		"5/1 cancelled 60",
		"6/1 skipped 5",
		"7/1 timed_out 3600",
		"11/1 success 1800",
	]
	expect h.recent.filter((x) => x.run_id == 3).map((x) => x.branch) == [Some("feature")]
}

case "history: each workflow's day, with the pass rate and median of /metrics/ci" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(h) = r else {
		expect false
	}
	// All of CI's window is on 5 November, so its one day matches the window's
	// figures: 8 runs, 4 passed, 2 failed or timed out, 67 %, median 600 s.
	expect h.daily.map(
		(d) => "\(d.path) \(d.day) \(d.runs) \(d.success) \(d.failed) \(d.other)"
	) == [
		".github/workflows/ci.yml 2026-11-05 8 4 2 2",
		".github/workflows/codeql.yml 2026-11-05 1 1 0 0",
	]
	expect h.daily.map((d) => d.pass_percent) == [Some(67), Some(100)]
	expect h.daily.map((d) => d.wall_p50_seconds) == [Some(600), Some(1800)]
}

case "history: at most 20 recent attempts, and a day with nothing judged has no pass rate" {
	let seeded <- Deliveries.batch(nightly())
	expect seeded is Ok(_)
	let visible <- Deliveries.run(
		"INSERT INTO repositories (repo, public, default_branch) VALUES ('bynk-lang/bynk', 1, 'main')",
		[]
	)
	expect visible is Ok(_)
	// 29 October has only a cancelled run: counted, but nothing judged.
	let cancelled <- Deliveries.run(
		"""
		INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
		                           created_at, queued_at, started_at, completed_at, updated_at) VALUES
		  ('bynk-lang/bynk', 99, 1, 'Nightly', '.github/workflows/nightly.yml', 'main', 'n0', 'schedule', 'completed', 'cancelled',
		   '2026-10-29T13:00:00.000Z', '2026-10-29T13:00:00.000Z', '2026-10-29T13:00:00.000Z', '2026-10-29T13:01:00.000Z', '2026-10-29T13:01:00.000Z')
		""",
		[]
	)
	expect cancelled is Ok(_)
	let r <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: Some("bynk-lang/bynk"),
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let Ok(h) = r else {
		expect false
	}
	// The newest 20 of 25: runs 120 (oldest, failed) to 101.
	expect h.recent.length() == 20
	expect h.recent.first().map((x) => "\(x.run_id) \(x.conclusion)") == Some("120 failure")
	expect h.recent
		.get(19)
		.map((x) => "\(x.run_id) \(x.conclusion) \(x.wall_seconds)") == Some("101 success 300")
	expect h.daily.map(
		(d) => "\(d.day) \(d.runs) \(d.success) \(d.failed)"
	) == [
		"2026-10-29 1 0 0",
		"2026-10-30 4 3 1",
		"2026-10-31 4 3 1",
		"2026-11-01 4 3 1",
		"2026-11-02 4 3 1",
		"2026-11-03 4 4 0",
		"2026-11-04 4 3 1",
		"2026-11-05 1 1 0",
	]
	expect h.daily.map(
		(d) => d.pass_percent
	) == [None, Some(75), Some(75), Some(75), Some(75), Some(100), Some(75), Some(100)]
	expect h.daily.map(
		(d) => d.wall_p50_seconds
	) == [None, Some(300), Some(300), Some(300), Some(300), Some(300), Some(300), Some(300)]
}

case "history: filters apply as they do to /metrics/ci" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: Some("feature"),
			event: Some("pull_request"),
			days: 30,
		},
		viewer()
	) by Visitor
	let Ok(h) = r else {
		expect false
	}
	expect h.recent.map((x) => x.run_id) == [3]
	expect h.daily.map(
		(d) => "\(d.day) \(d.runs) \(d.pass_percent.getOrElse(-1))"
	) == ["2026-11-05 1 100"]
	// 30 days reaches r8 (20 October) on main.
	let wide <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: Some("main"),
			event: None,
			days: 30,
		},
		viewer()
	) by Visitor
	let Ok(w) = wide else {
		expect false
	}
	expect w.daily.map(
		(d) => "\(d.path) \(d.day)"
	) == [
		".github/workflows/ci.yml 2026-10-20",
		".github/workflows/ci.yml 2026-11-05",
		".github/workflows/codeql.yml 2026-11-05",
	]
}

--- accuser, a maintainer: GitHub's kept answer, so the maintainer routes need no GitHub stub.
fn keptMaintainer() -> SqlStatement {
	SqlStatement {
		sql: "INSERT INTO org_members (org, login, member, checked_at) VALUES ('bynk-lang', 'accuser', 1, '2026-11-06T00:00:00.000Z')",
		params: [],
	}
}

case "a maintainer's CI figures include private and excluded repositories; the public's never do" {
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let public0 <- api.GET(
		"/metrics/ci",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let mine0 <- api.POST("/maintainers/metrics/ci", CiQuery {
		repo: None,
		branch: None,
		event: None,
		days: 7,
	}) by Maintainer("accuser")
	let Ok(p0) = public0 else {
		expect false
	}
	let Ok(m0) = mine0 else {
		expect false
	}
	// /metrics/ci: the public never see the private or excluded repository; a maintainer sees both.
	let pt0 = Json.encode(p0)
	let mt0 = Json.encode(m0)
	expect !pt0.contains("bynk-lang/secret") && !pt0.contains("bynk-lang/sandbox")
	expect mt0.contains("bynk-lang/secret") && mt0.contains("bynk-lang/sandbox")
	expect mt0.contains("bynk-lang/bynk")
	let public1 <- api.GET("/metrics/ci/now", NowQuery { repo: None }, viewer()) by Visitor
	let mine1 <- api.POST(
		"/maintainers/metrics/ci/now",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	let Ok(p1) = public1 else {
		expect false
	}
	let Ok(m1) = mine1 else {
		expect false
	}
	// /metrics/ci/now: the public never see the private or excluded repository; a maintainer sees both.
	let pt1 = Json.encode(p1)
	let mt1 = Json.encode(m1)
	expect !pt1.contains("bynk-lang/secret") && !pt1.contains("bynk-lang/sandbox")
	expect mt1.contains("bynk-lang/secret") && mt1.contains("bynk-lang/sandbox")
	expect mt1.contains("bynk-lang/bynk")
	let public2 <- api.GET(
		"/metrics/ci/history",
		CiQuery {
			repo: None,
			branch: None,
			event: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let mine2 <- api.POST("/maintainers/metrics/ci/history", CiQuery {
		repo: None,
		branch: None,
		event: None,
		days: 7,
	}) by Maintainer("accuser")
	let Ok(p2) = public2 else {
		expect false
	}
	let Ok(m2) = mine2 else {
		expect false
	}
	// /metrics/ci/history: the public never see the private or excluded repository; a maintainer sees both.
	let pt2 = Json.encode(p2)
	let mt2 = Json.encode(m2)
	expect !pt2.contains("bynk-lang/secret") && !pt2.contains("bynk-lang/sandbox")
	expect mt2.contains("bynk-lang/secret") && mt2.contains("bynk-lang/sandbox")
	expect mt2.contains("bynk-lang/bynk")
}

case "a maintainer sees every repository, marked public or private, and whether it's excluded" {
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let r <- api.GET("/maintainers/repositories") by Maintainer("accuser")
	expect r == Ok([
		ShownRepository {
			repo: "bynk-lang/bynk",
			public: true,
			excluded: false,
		},
		ShownRepository {
			repo: "bynk-lang/sandbox",
			public: true,
			excluded: true,
		},
		ShownRepository {
			repo: "bynk-lang/secret",
			public: false,
			excluded: false,
		},
	])
}

case "the maintainer figures are refused to someone who has left, and unavailable when GitHub can't say" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns each [Ok(Response { status: 404, headers: Map.empty(), body: "{\"message\": \"Not Found\"}" }), Ok(Response { status: 500, headers: Map.empty(), body: "{\"message\": \"Server Error\"}" })]
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let installed <- Deliveries.run(
		"INSERT INTO deliveries (id, event, repo, installation, size, received_at) VALUES ('d-1', 'push', 'bynk-lang/bynk', 42, 1, '2026-11-05T00:00:00.000Z')",
		[]
	)
	expect installed is Ok(_)
	let leaver <- api.POST("/maintainers/metrics/ci", CiQuery {
		repo: None,
		branch: None,
		event: None,
		days: 7,
	}) by Maintainer("a-leaver")
	expect leaver is RawError(403, _, _)
	let unknown <- api.POST(
		"/maintainers/metrics/ci/now",
		NowQuery { repo: None }
	) by Maintainer("someone")
	expect unknown is ServiceUnavailable(_)
}

case "a maintainer's requests are limited per login, before anything is read" {
	stub MaintainerLimit.allow(_) returns each [true, false]
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let first <- api.POST(
		"/maintainers/metrics/ci/now",
		NowQuery { repo: None }
	) by Maintainer("Accuser")
	expect first is Ok(_)
	let second <- api.GET("/maintainers/repositories") by Maintainer("accuser")
	expect second is TooManyRequests(_)
	expect MaintainerLimit.allow called 2 times with key == "maintainer:accuser"
}
