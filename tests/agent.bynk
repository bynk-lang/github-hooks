// #129, step 1: a conversation with Claude that uses tools, against an
// in-memory D1 with the migrations applied. Anthropic is stubbed at the wire.
// The tools are a stand-in: `read_file` answers what it was asked for, and
// `finish` ends the conversation with an answer.
suite github.hooks

consumes bynk { Response, Clock }

env {
	ANTHROPIC_API_KEY = "test-anthropic-key"
}

stub Clock.now() returns Instant.fromEpochMillis(1793880000000)

fn answer(status: Int, body: String) -> Result[Response, String] {
	Ok(Response { status: status, headers: Map.empty(), body: body })
}

--- A Messages API reply whose `content` is the JSON text `content`, stopping for `stop`.
fn replying(content: String, stop: String) -> Result[Response, String] {
	answer(
		200,
		"{\"id\":\"msg_1\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-opus-5-5\",\"content\":\(content),\"stop_reason\":\"\(stop)\",\"usage\":{\"input_tokens\":100,\"output_tokens\":20,\"cache_read_input_tokens\":80}}"
	)
}

--- Claude thinks, then asks to read `src/a.ts`.
const READ_CALL: String = "[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"sig-1\"},{\"type\":\"tool_use\",\"id\":\"tu_1\",\"name\":\"read_file\",\"input\":{\"path\":\"src/a.ts\"}}]"

--- Claude writes a note with brackets, quotes and an emoji in it, then finishes.
const FINISH_CALL: String = "[{\"type\":\"text\",\"text\":\"Done ] { \\\" [ 😀\"},{\"type\":\"tool_use\",\"id\":\"tu_2\",\"name\":\"finish\",\"input\":{\"answer\":\"looks fine\"}}]"

--- Claude only talks.
const TALK: String = "[{\"type\":\"text\",\"text\":\"I think it's fine.\"}]"

--- The stand-in tools' input: each uses one field.
type DemoInput = {
	path: Option[String] = None,
	answer: Option[String] = None,
}

fn ask(maxTurns: Int) -> AgentAsk {
	AgentAsk {
		feature: "review",
		repo: "bynk-lang/vscode",
		review: Some(7),
		effort: High,
		maxTokens: 16000,
		maxTurns: maxTurns,
		taskBudget: Some(200000),
		system: "You review pull requests.",
		user: "Review pull request #12.",
		tools: [
			AgentTool {
				name: "read_file",
				description: "Read a file.",
				schema: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}",
				strict: false,
			},
			AgentTool {
				name: "finish",
				description: "Finish.",
				schema: "{\"type\":\"object\",\"properties\":{\"answer\":{\"type\":\"string\"}},\"required\":[\"answer\"],\"additionalProperties\":false}",
				strict: true,
			},
		],
		finish: "finish",
	}
}

fn reading(c: ToolCall[DemoInput]) -> ToolResult {
	let path = c.input.andThen((i) => i.path).getOrElse("")
	ToolResult {
		content: "read \(path)",
		isError: false,
	}
}

--- The assistant turn the second request must carry, as the first reply had it.
fn echoed(content: String) -> String {
	"{\"role\":\"assistant\",\"content\":".concat(content).concat("}")
}

type Recorded = {
	feature: String,
	model: String,
	outcome: String,
	review: Option[Int],
	cache_read_input_tokens: Option[Int],
}

case "a tool call is run, its result sent back with Claude's turn as it came, and the finishing call ends it" {
	stub AnthropicHttp.post(_, _, _) returns each [replying(READ_CALL, "tool_use"), replying(FINISH_CALL, "tool_use")]
	let r <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect r.end == Finished
	expect r.answer.andThen((a) => a.answer) == Some("looks fine")
	expect r.turns == 2
	expect AnthropicHttp.post called 2 times
	// Claude's turn, thinking block and signature included, exactly as it came.
	expect AnthropicHttp.post called with body.contains(echoed(READ_CALL))
	expect AnthropicHttp.post called with body.contains("{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"tu_1\",\"content\":\"read src/a.ts\",\"is_error\":false}]}")
	expect AnthropicHttp.post called with beta == Some("server-side-fallback-2026-07-01,task-budgets-2026-03-13")
	expect AnthropicHttp.post called with body.contains("\"model\":\"claude-opus-5-5\"") && body.contains("\"effort\":\"high\",\"task_budget\":{\"type\":\"tokens\",\"total\":200000}") && body.contains("\"fallbacks\":\"default\"") && body.contains("\"cache_control\":{\"type\":\"ephemeral\"},\"system\"")
	expect AnthropicHttp.post called with body.contains("\"tools\":[{\"name\":\"read_file\",\"description\":\"Read a file.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}},{\"name\":\"finish\"") && body.contains("\"required\":[\"answer\"],\"additionalProperties\":false},\"strict\":true}]")
	expect AnthropicHttp.post called with body.contains("\"messages\":[{\"role\":\"user\",\"content\":\"Review pull request #12.\"}]")
	let calls <- Deliveries.select[Recorded]("FROM claude_calls ORDER BY id", [])
	expect calls == Ok([
		Recorded {
			feature: "review",
			model: "claude-opus-5-5",
			outcome: "answered",
			review: Some(7),
			cache_read_input_tokens: Some(80),
		},
		Recorded {
			feature: "review",
			model: "claude-opus-5-5",
			outcome: "answered",
			review: Some(7),
			cache_read_input_tokens: Some(80),
		},
	])
}

case "a reply without a tool call is reminded once to finish, then ends unfinished" {
	stub AnthropicHttp.post(_, _, _) returns each [replying(TALK, "end_turn"), replying(TALK, "end_turn")]
	let r <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect r.end == Unfinished("Claude stopped without calling finish")
	expect r.answer == None
	expect r.turns == 2
	expect AnthropicHttp.post called with body.contains(echoed(TALK).concat(",{\"role\":\"user\",\"content\":\"Finish by calling the finish tool.\"}"))
}

case "a conversation that runs out of turns ends unfinished, without another request" {
	stub AnthropicHttp.post(_, _, _) returns replying(READ_CALL, "tool_use")
	let r <- converse[DemoInput](ask(3), (c) => Effect.pure(reading(c)))
	expect r.end == Unfinished("it used all 3 turns")
	expect r.turns == 3
	expect AnthropicHttp.post called 3 times
}

case "arguments that don't decode get an error result, and the tool isn't run" {
	stub AnthropicHttp.post(_, _, _) returns each [replying("[{\"type\":\"tool_use\",\"id\":\"tu_9\",\"name\":\"read_file\",\"input\":{\"path\":5}}]", "tool_use"), replying(FINISH_CALL, "tool_use")]
	let r <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect r.end == Finished
	expect AnthropicHttp.post called with body.contains("{\"type\":\"tool_result\",\"tool_use_id\":\"tu_9\",\"content\":\"The arguments to read_file didn't match its schema.\",\"is_error\":true}")
}

case "a refusal, a reply cut off and Anthropic unreachable each end the conversation" {
	stub AnthropicHttp.post(_, _, _) returns each [answer(200, "{\"model\":\"claude-opus-5-5\",\"content\":[],\"stop_reason\":\"refusal\",\"stop_details\":{\"type\":\"refusal\",\"category\":\"cyber\"},\"usage\":{\"input_tokens\":40,\"output_tokens\":0}}"), replying(TALK, "max_tokens"), Err("Anthropic could not be reached"), answer(529, "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}")]
	let refused <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect refused.end == AgentRefused(Some("cyber"))
	let cut <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect cut.end == AgentTruncated
	let unreachable <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect unreachable.end == AgentUnavailable("Anthropic could not be reached")
	let overloaded <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect overloaded.end == AgentUnavailable(
		"Anthropic answered 529 (overloaded_error: Overloaded)"
	)
	let outcomes <- Deliveries.all("SELECT outcome FROM claude_calls ORDER BY id", [])
	expect outcomes == Ok("[{\"outcome\":\"refused\"},{\"outcome\":\"truncated\"},{\"outcome\":\"failed\"},{\"outcome\":\"failed\"}]")
}

case "the reply's content is cut from its text: brackets and quotes in strings, and astral characters, don't end it early" {
	expect rawContent(
		"{\"id\":\"m\",\"model\":\"x\",\"content\":[{\"type\":\"text\",\"text\":\"😀 ] } \\\" [ {\"},{\"type\":\"tool_use\",\"input\":{\"a\":[1,{\"b\":\"]\"}]}}],\"stop_reason\":\"end_turn\"}"
	) == Some("[{\"type\":\"text\",\"text\":\"😀 ] } \\\" [ {\"},{\"type\":\"tool_use\",\"input\":{\"a\":[1,{\"b\":\"]\"}]}}]")
	expect rawContent("{\"content\": [] , \"x\": 1}") == Some("[]")
	expect rawContent("{\"content\":\"text\"}") == None
	expect rawContent("{\"content\":[{\"type\":\"text\"}") == None
	expect rawContent("{\"model\":\"x\"}") == None
}

case "the content array is the top-level key's, whatever order the keys come in" {
	expect rawContent(
		"{\"container\":{\"content\":[\"not this\"]},\"text\":\"\\\"content\\\":[\",\"content\":[{\"type\":\"text\",\"text\":\"this\"}],\"stop_reason\":\"end_turn\"}"
	) == Some("[{\"type\":\"text\",\"text\":\"this\"}]")
	expect rawContent("{\"content\":null,\"x\":{\"content\":[1]}}") == None
	expect rawContent("[{\"content\":[1]}]") == None
}

case "a task budget below the API's minimum isn't sent, and says so" {
	stub AnthropicHttp.post(_, _, _) returns replying(FINISH_CALL, "tool_use")
	let r <- converse[DemoInput](
		AgentAsk {
			...ask(10),
			taskBudget: Some(5000),
		},
		(c) => Effect.pure(reading(c))
	)
	expect r.end == Finished
	expect AnthropicHttp.post called with beta == Some("server-side-fallback-2026-07-01") && !body.contains("task_budget")
	expect Logger.warn called with msg == "review for bynk-lang/vscode: a task budget of 5000 is below the API's minimum of 20000, so none is sent"
}

case "a finishing call whose input doesn't decode gets an error result, and Claude can finish again" {
	stub AnthropicHttp.post(_, _, _) returns each [replying("[{\"type\":\"tool_use\",\"id\":\"tu_3\",\"name\":\"finish\",\"input\":{\"answer\":7}}]", "tool_use"), replying(FINISH_CALL, "tool_use")]
	let r <- converse[DemoInput](ask(10), (c) => Effect.pure(reading(c)))
	expect r.end == Finished
	expect r.turns == 2
	expect AnthropicHttp.post called with body.contains("{\"type\":\"tool_result\",\"tool_use_id\":\"tu_3\",\"content\":\"The arguments to finish didn't match its schema.\",\"is_error\":true}")
}
