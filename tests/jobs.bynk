// Phase 4, slice 4, step 1 (#42): `workflow_job` deliveries become
// `workflow_jobs` rows, through the webhook, against an in-memory D1 with the
// migrations applied. The fixture is a real `bynk` CI job, "Test suite
// (ubuntu-latest)", which ran on a self-hosted runner (its steps and runner
// name left out), wrapped as the webhook delivers it; each case varies it.
suite github.hooks

fixture completedJob = "fixtures/github/workflow_job.completed.json"

fixture completedRun = "fixtures/github/workflow_run.completed.json"

--- A delivery's headers.
fn headers(id: String) -> RequestHeaders {
	RequestHeaders.of(["X-GitHub-Event: workflow_job", "X-GitHub-Delivery: \(id)"])
}

---
The job at another moment: its action and status, its conclusion and
`completed_at` as JSON (`null` or quoted), and its runner group.
---
fn jobAt(action: String, conclusion: String, completed: String, group: String) -> Bytes {
	Bytes.fromUtf8(completedJob
		.replace("\"action\": \"completed\"", "\"action\": \"\(action)\"")
		.replace("\"status\": \"completed\"", "\"status\": \"\(action)\"")
		.replace("\"conclusion\": \"success\"", "\"conclusion\": \(conclusion)")
		.replace("\"completed_at\": \"2026-11-06T09:19:43Z\"", "\"completed_at\": \(completed)")
		.replace("\"runner_group_name\": \"default\"", "\"runner_group_name\": \(group)"))
}

--- The one job's row, every column but its id.
fn row() -> String {
	"SELECT repo, run_id, attempt, workflow, name, runner, runner_group, status, conclusion, created_at, started_at, completed_at FROM workflow_jobs"
}

case "a completed job is recorded with the runner it asked for and its times" {
	let r <- api.POST("/github", headers("job-1"), Bytes.fromUtf8(completedJob)) by GitHub
	expect r is Accepted(_)
	let job <- Deliveries.first(row(), [])
	expect job == Ok(Some("{\"repo\":\"bynk-lang/bynk\",\"run_id\":42190975969,\"attempt\":1,\"workflow\":\"CI\",\"name\":\"Test suite (ubuntu-latest)\",\"runner\":\"self-hosted\",\"runner_group\":\"default\",\"status\":\"completed\",\"conclusion\":\"success\",\"created_at\":\"2026-11-06T09:16:48.000Z\",\"started_at\":\"2026-11-06T09:16:50.000Z\",\"completed_at\":\"2026-11-06T09:19:43.000Z\"}"))
	expect Logger.error never called
}

case "a job's life: queued, in progress, completed, whatever order the deliveries arrive in" {
	// Queued: GitHub sends `started_at` as `created_at` until a runner takes
	// the job, so it isn't kept; no runner group yet.
	let _ <- api.POST(
		"/github",
		headers("job-queued"),
		jobAt("queued", "null", "null", "null")
	) by GitHub
	let queued <- Deliveries.first(
		"SELECT status, runner_group, started_at, completed_at FROM workflow_jobs",
		[]
	)
	expect queued == Ok(Some("{\"status\":\"queued\",\"runner_group\":null,\"started_at\":null,\"completed_at\":null}"))
	let _ <- api.POST("/github", headers("job-done"), Bytes.fromUtf8(completedJob)) by GitHub
	// A late in_progress after completed changes nothing.
	let _ <- api.POST(
		"/github",
		headers("job-late"),
		jobAt("in_progress", "null", "null", "\"default\"")
	) by GitHub
	// Nor does a late queued.
	let _ <- api.POST(
		"/github",
		headers("job-later"),
		jobAt("queued", "null", "null", "null")
	) by GitHub
	let done <- Deliveries.first(
		"SELECT status, conclusion, runner_group, started_at, completed_at FROM workflow_jobs",
		[]
	)
	expect done == Ok(Some("{\"status\":\"completed\",\"conclusion\":\"success\",\"runner_group\":\"default\",\"started_at\":\"2026-11-06T09:16:50.000Z\",\"completed_at\":\"2026-11-06T09:19:43.000Z\"}"))
}

case "in progress, a job has started but not finished; a queued delivery after it doesn't unstart it" {
	let _ <- api.POST(
		"/github",
		headers("job-running"),
		jobAt("in_progress", "null", "null", "\"default\"")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("job-queued-late"),
		jobAt("queued", "null", "null", "null")
	) by GitHub
	let running <- Deliveries.first(
		"SELECT status, runner_group, started_at, completed_at FROM workflow_jobs",
		[]
	)
	expect running == Ok(Some("{\"status\":\"in_progress\",\"runner_group\":\"default\",\"started_at\":\"2026-11-06T09:16:50.000Z\",\"completed_at\":null}"))
}

case "a job that asked for no label is on an unknown runner; an empty runner group is none" {
	let _ <- api.POST(
		"/github",
		headers("job-bare"),
		Bytes.fromUtf8(completedJob
			.replace(
				"\"labels\": [\n      \"self-hosted\",\n      \"Linux\",\n      \"X64\"\n    ]",
				"\"labels\": []"
			)
			.replace("\"runner_group_name\": \"default\"", "\"runner_group_name\": \"\""))
	) by GitHub
	let job <- Deliveries.first("SELECT runner, runner_group FROM workflow_jobs", [])
	expect job == Ok(Some("{\"runner\":\"unknown\",\"runner_group\":null}"))
}

case "a redelivered job changes nothing" {
	let _ <- api.POST("/github", headers("job-1"), Bytes.fromUtf8(completedJob)) by GitHub
	let again <- api.POST("/github", headers("job-1"), Bytes.fromUtf8(completedJob)) by GitHub
	expect again == Ok("duplicate")
	let count <- Deliveries.first("SELECT count(*) AS n FROM workflow_jobs", [])
	expect count == Ok(Some("{\"n\":1}"))
}

case "a job payload that doesn't decode is logged, and the delivery is still recorded" {
	let r <- api.POST(
		"/github",
		headers("job-bad"),
		Bytes.fromUtf8(
			"{\"action\": \"queued\", \"workflow_job\": {\"id\": \"not a number\"}, \"repository\": {\"full_name\": \"bynk-lang/bynk\"}}"
		)
	) by GitHub
	expect r is Accepted(_)
	expect Logger.error called once
	let count <- Deliveries.first("SELECT count(*) AS n FROM workflow_jobs", [])
	expect count == Ok(Some("{\"n\":0}"))
}

case "a later delivery that names no runner group keeps the one already known" {
	let _ <- api.POST(
		"/github",
		headers("job-running"),
		jobAt("in_progress", "null", "null", "\"default\"")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("job-done-nameless"),
		jobAt("completed", "\"cancelled\"", "\"2026-11-06T09:18:00Z\"", "null")
	) by GitHub
	let job <- Deliveries.first("SELECT status, conclusion, runner_group FROM workflow_jobs", [])
	expect job == Ok(Some("{\"status\":\"completed\",\"conclusion\":\"cancelled\",\"runner_group\":\"default\"}"))
}

case "a job cancelled before any runner took it has no start, so no wait" {
	// GitHub fills `started_at` with `created_at` for it, with runner id 0.
	let _ <- api.POST(
		"/github",
		headers("job-cancelled"),
		Bytes.fromUtf8(completedJob
			.replace("\"conclusion\": \"success\"", "\"conclusion\": \"cancelled\"")
			.replace(
				"\"started_at\": \"2026-11-06T09:16:50Z\"",
				"\"started_at\": \"2026-11-06T09:16:48Z\""
			)
			.replace("\"runner_id\": 778", "\"runner_id\": 0")
			.replace("\"runner_group_name\": \"default\"", "\"runner_group_name\": null"))
	) by GitHub
	let job <- Deliveries.first(
		"SELECT status, conclusion, started_at, completed_at FROM workflow_jobs",
		[]
	)
	expect job == Ok(Some("{\"status\":\"completed\",\"conclusion\":\"cancelled\",\"started_at\":null,\"completed_at\":\"2026-11-06T09:19:43.000Z\"}"))
}

case "a job held for an approval is marked, and stays marked, whatever order the deliveries arrive in" {
	let _ <- api.POST(
		"/github",
		headers("job-waiting"),
		jobAt("waiting", "null", "null", "null")
	) by GitHub
	let waiting <- Deliveries.first("SELECT status, approval FROM workflow_jobs", [])
	expect waiting == Ok(Some("{\"status\":\"waiting\",\"approval\":1}"))
	let _ <- api.POST("/github", headers("job-done"), Bytes.fromUtf8(completedJob)) by GitHub
	let done <- Deliveries.first("SELECT status, approval FROM workflow_jobs", [])
	expect done == Ok(Some("{\"status\":\"completed\",\"approval\":1}"))
}

case "a waiting delivery that arrives after the job completed still marks it" {
	let _ <- api.POST("/github", headers("job-done"), Bytes.fromUtf8(completedJob)) by GitHub
	let plain <- Deliveries.first("SELECT approval FROM workflow_jobs", [])
	expect plain == Ok(Some("{\"approval\":0}"))
	let _ <- api.POST(
		"/github",
		headers("job-waiting-late"),
		jobAt("waiting", "null", "null", "null")
	) by GitHub
	let marked <- Deliveries.first("SELECT status, approval FROM workflow_jobs", [])
	expect marked == Ok(Some("{\"status\":\"completed\",\"approval\":1}"))
}

--- The run fixture moved to the job fixture's repository and run.
fn jobsRun() -> Bytes {
	Bytes.fromUtf8(completedRun
		.replace("bynk-lang/github-hooks", "bynk-lang/bynk")
		.replace("41978704067", "42190975969"))
}

fn runHeaders(id: String) -> RequestHeaders {
	RequestHeaders.of(["X-GitHub-Event: workflow_run", "X-GitHub-Delivery: \(id)"])
}

case "a job keeps its workflow's file from its run, whichever is recorded first (#62)" {
	// The job first: it has no file until its run is recorded.
	let _ <- api.POST("/github", headers("job-done"), Bytes.fromUtf8(completedJob)) by GitHub
	let before <- Deliveries.first("SELECT path FROM workflow_jobs", [])
	expect before == Ok(Some("{\"path\":null}"))
	let _ <- api.POST("/github", runHeaders("run-done"), jobsRun()) by GitHub
	let after <- Deliveries.first("SELECT path FROM workflow_jobs", [])
	expect after == Ok(Some("{\"path\":\".github/workflows/ci.yml\"}"))
	// The run first: a job recorded after it takes the file straight away.
	let _ <- api.POST(
		"/github",
		headers("job-other"),
		Bytes.fromUtf8(completedJob.replace("\"id\": 127812039258", "\"id\": 127812039259"))
	) by GitHub
	let both <- Deliveries.first(
		"SELECT count(*) AS jobs, count(path) AS with_path FROM workflow_jobs",
		[]
	)
	expect both == Ok(Some("{\"jobs\":2,\"with_path\":2}"))
	expect Logger.error never called
}
