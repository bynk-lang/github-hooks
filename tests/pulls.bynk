// Phase 4, slice 2 (#26): `pull_request` and `pull_request_review` deliveries
// become `pull_requests`, `pull_request_events` and `pull_request_reviews`
// rows, through the webhook, against an in-memory D1 with the migrations
// applied. The fixtures are this repository's PR #25 and its first review, as
// GitHub's REST API returned them, wrapped as the webhook delivers them (the
// bodies cut short); each case varies them to the state it needs.
suite github.hooks

fixture mergedPull = "fixtures/github/pull_request.closed.json"

fixture review = "fixtures/github/pull_request_review.submitted.json"

---
PR #25 at another moment: `action` (with any extra top-level fields after
it), its state, whether it is a draft, its `updated_at`, and its `merged_at`
and `closed_at` as JSON (`null` or a quoted time).
---
fn pullAt(
	action: String,
	extra: String,
	state: String,
	draft: Bool,
	updated: String,
	merged: String,
	closed: String
) -> Bytes {
	Bytes.fromUtf8(mergedPull
		.replace("\"action\": \"closed\"", "\"action\": \"\(action)\"\(extra)")
		.replace("\"state\": \"closed\"", "\"state\": \"\(state)\"")
		.replace("\"draft\": false", "\"draft\": \(if draft { "true" } else { "false" })")
		.replace("\"updated_at\": \"2026-11-05T08:10:14Z\"", "\"updated_at\": \"\(updated)\"")
		.replace("\"merged_at\": \"2026-11-05T08:10:11Z\"", "\"merged_at\": \(merged)")
		.replace("\"closed_at\": \"2026-11-05T08:10:11Z\"", "\"closed_at\": \(closed)"))
}

--- PR #25 open, at `updated`, after `action`.
fn openPull(action: String, draft: Bool, updated: String) -> Bytes {
	pullAt(action, "", "open", draft, updated, "null", "null")
}

--- A delivery's headers.
fn headers(event: String, id: String) -> RequestHeaders {
	RequestHeaders.of(["X-GitHub-Event: \(event)", "X-GitHub-Delivery: \(id)"])
}

case "a merged pull request is recorded with its times, size and author" {
	let r <- api.POST(
		"/github",
		headers("pull_request", "pr-1"),
		Bytes.fromUtf8(mergedPull)
	) by GitHub
	expect r is Accepted(_)
	let row <- Deliveries.first(
		"""
		SELECT repo, number, title, author, author_is_bot, base, head, draft, state, opened_at, ready_at,
		       closed_at, merged_at, commits, additions, deletions, changed_files, updated_at
		FROM pull_requests
		""",
		[]
	)
	expect row == Ok(Some("{\"repo\":\"bynk-lang/github-hooks\",\"number\":25,\"title\":\"CI history: recent runs and daily trends for each workflow\",\"author\":\"accuser\",\"author_is_bot\":0,\"base\":\"main\",\"head\":\"ci-history\",\"draft\":0,\"state\":\"merged\",\"opened_at\":\"2026-11-05T07:54:42.000Z\",\"ready_at\":null,\"closed_at\":\"2026-11-05T08:10:11.000Z\",\"merged_at\":\"2026-11-05T08:10:11.000Z\",\"commits\":4,\"additions\":776,\"deletions\":18,\"changed_files\":10,\"updated_at\":\"2026-11-05T08:10:14.000Z\"}"))
	// Closing is a moment worth keeping, timed by when the delivery arrived.
	let moment <- Deliveries.first(
		"""
		SELECT e.action, e.reason, e.at = d.received_at AS on_arrival
		FROM pull_request_events e JOIN deliveries d ON d.id = e.delivery
		""",
		[]
	)
	expect moment == Ok(Some("{\"action\":\"closed\",\"reason\":null,\"on_arrival\":1}"))
}

case "a draft's life: ready, pushed to, queued, dequeued and merged" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-open"),
		openPull("opened", true, "2026-11-05T07:54:42Z")
	) by GitHub
	let opened <- Deliveries.first("SELECT state, draft, ready_at FROM pull_requests", [])
	expect opened == Ok(Some("{\"state\":\"open\",\"draft\":1,\"ready_at\":null}"))
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-ready"),
		openPull("ready_for_review", false, "2026-11-05T08:03:00Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-push"),
		openPull("synchronize", false, "2026-11-05T08:05:00Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-enq"),
		openPull("enqueued", false, "2026-11-05T08:06:00Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-deq"),
		pullAt(
			"dequeued",
			", \"reason\": \"CI_FAILURE\"",
			"open",
			false,
			"2026-11-05T08:07:00Z",
			"null",
			"null"
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-merged"),
		Bytes.fromUtf8(mergedPull)
	) by GitHub
	let row <- Deliveries.first(
		"SELECT state, draft, opened_at, ready_at, merged_at, (SELECT count(*) FROM pull_requests) AS n FROM pull_requests",
		[]
	)
	expect row == Ok(Some("{\"state\":\"merged\",\"draft\":0,\"opened_at\":\"2026-11-05T07:54:42.000Z\",\"ready_at\":\"2026-11-05T08:03:00.000Z\",\"merged_at\":\"2026-11-05T08:10:11.000Z\",\"n\":1}"))
	// `opened` and `synchronize` are on the row; the rest are moments.
	let moments <- Deliveries.first(
		"SELECT group_concat(action || ':' || coalesce(reason, '-'), ' ') AS m FROM (SELECT * FROM pull_request_events ORDER BY rowid)",
		[]
	)
	expect moments == Ok(Some("{\"m\":\"ready_for_review:- enqueued:- dequeued:CI_FAILURE closed:-\"}"))
}

case "a pull request opened ready is ready when it opened" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-open"),
		openPull("opened", false, "2026-11-05T07:54:43Z")
	) by GitHub
	let row <- Deliveries.first("SELECT ready_at FROM pull_requests", [])
	expect row == Ok(Some("{\"ready_at\":\"2026-11-05T07:54:42.000Z\"}"))
}

case "a late delivery never undoes a merge, but still says when the PR was ready" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-merged"),
		Bytes.fromUtf8(mergedPull)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-push"),
		openPull("synchronize", false, "2026-11-05T08:05:00Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-ready"),
		openPull("ready_for_review", false, "2026-11-05T08:03:00Z")
	) by GitHub
	let row <- Deliveries.first(
		"SELECT state, merged_at, ready_at, updated_at FROM pull_requests",
		[]
	)
	expect row == Ok(Some("{\"state\":\"merged\",\"merged_at\":\"2026-11-05T08:10:11.000Z\",\"ready_at\":\"2026-11-05T08:03:00.000Z\",\"updated_at\":\"2026-11-05T08:10:14.000Z\"}"))
}

case "ready_at only moves earlier" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-ready-2"),
		openPull("ready_for_review", false, "2026-11-05T08:04:00Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-ready-1"),
		openPull("ready_for_review", false, "2026-11-05T08:01:00Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-ready-3"),
		openPull("ready_for_review", false, "2026-11-05T08:06:00Z")
	) by GitHub
	let row <- Deliveries.first("SELECT ready_at FROM pull_requests", [])
	expect row == Ok(Some("{\"ready_at\":\"2026-11-05T08:01:00.000Z\"}"))
}

case "a redelivered moment is recorded once" {
	let first <- api.POST(
		"/github",
		headers("pull_request", "pr-enq"),
		openPull("enqueued", false, "2026-11-05T08:06:00Z")
	) by GitHub
	let again <- api.POST(
		"/github",
		headers("pull_request", "pr-enq"),
		openPull("enqueued", false, "2026-11-05T08:06:00Z")
	) by GitHub
	expect first is Accepted(_)
	expect again is Ok("duplicate")
	let n <- Deliveries.first("SELECT count(*) AS n FROM pull_request_events", [])
	expect n == Ok(Some("{\"n\":1}"))
	expect Logger.error never called
}

case "a delivery without sizes keeps the last known ones" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-push"),
		openPull("synchronize", false, "2026-11-05T08:05:00Z")
	) by GitHub
	let bare = Bytes.fromUtf8(mergedPull
		.replace("\"commits\": 4,", "")
		.replace("\"additions\": 776,", ""))
	let _ <- api.POST("/github", headers("pull_request", "pr-merged"), bare) by GitHub
	let row <- Deliveries.first(
		"SELECT state, commits, additions, deletions FROM pull_requests",
		[]
	)
	expect row == Ok(Some("{\"state\":\"merged\",\"commits\":4,\"additions\":776,\"deletions\":18}"))
}

case "a pull request by a bot is marked as one" {
	let byBot = Bytes.fromUtf8(mergedPull
		.replace("\"type\": \"User\"", "\"type\": \"Bot\"")
		.replace("\"login\": \"accuser\"", "\"login\": \"github-actions[bot]\""))
	let _ <- api.POST("/github", headers("pull_request", "pr-bot"), byBot) by GitHub
	let row <- Deliveries.first("SELECT author, author_is_bot FROM pull_requests", [])
	expect row == Ok(Some("{\"author\":\"github-actions[bot]\",\"author_is_bot\":1}"))
}

case "a review is recorded, and a dismissal updates it" {
	let r <- api.POST(
		"/github",
		headers("pull_request_review", "rv-1"),
		Bytes.fromUtf8(review)
	) by GitHub
	expect r is Accepted(_)
	let row <- Deliveries.first(
		"SELECT review_id, repo, number, reviewer, reviewer_is_bot, state, submitted_at FROM pull_request_reviews",
		[]
	)
	expect row == Ok(Some("{\"review_id\":5781620014,\"repo\":\"bynk-lang/github-hooks\",\"number\":25,\"reviewer\":\"accuser\",\"reviewer_is_bot\":0,\"state\":\"commented\",\"submitted_at\":\"2026-11-05T08:06:04.000Z\"}"))
	let dismissed = Bytes.fromUtf8(review
		.replace("\"action\": \"submitted\"", "\"action\": \"dismissed\"")
		.replace("\"state\": \"COMMENTED\"", "\"state\": \"DISMISSED\""))
	let _ <- api.POST("/github", headers("pull_request_review", "rv-2"), dismissed) by GitHub
	let after <- Deliveries.first(
		"SELECT state, submitted_at, (SELECT count(*) FROM pull_request_reviews) AS n FROM pull_request_reviews",
		[]
	)
	expect after == Ok(Some("{\"state\":\"dismissed\",\"submitted_at\":\"2026-11-05T08:06:04.000Z\",\"n\":1}"))
	// A review records no pull request: its payload's PR is a partial view.
	let prs <- Deliveries.first("SELECT count(*) AS n FROM pull_requests", [])
	expect prs == Ok(Some("{\"n\":0}"))
}

case "a pull_request that doesn't decode is logged, and the delivery is still recorded" {
	let r <- api.POST(
		"/github",
		headers("pull_request", "pr-bad"),
		Bytes.fromUtf8("{\"action\": \"opened\"}")
	) by GitHub
	expect r is Accepted(_)
	expect Logger.error called once with msg.startsWith("could not read pull request from pr-bad")
	let n <- Deliveries.first("SELECT count(*) AS n FROM pull_requests", [])
	expect n == Ok(Some("{\"n\":0}"))
}

case "a dismissal is final, whichever order the deliveries arrive in" {
	let dismissed = Bytes.fromUtf8(review
		.replace("\"action\": \"submitted\"", "\"action\": \"dismissed\"")
		.replace("\"state\": \"COMMENTED\"", "\"state\": \"DISMISSED\""))
	let approved = Bytes.fromUtf8(review.replace(
		"\"state\": \"COMMENTED\"",
		"\"state\": \"APPROVED\""
	))
	let _ <- api.POST(
		"/github",
		headers("pull_request_review", "rv-dismissed"),
		dismissed
	) by GitHub
	let _ <- api.POST("/github", headers("pull_request_review", "rv-approved"), approved) by GitHub
	let row <- Deliveries.first("SELECT state FROM pull_request_reviews", [])
	expect row == Ok(Some("{\"state\":\"dismissed\"}"))
}

case "in the same second, a delivery never takes a PR out of merged, but still moves an open one on" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-merged"),
		Bytes.fromUtf8(mergedPull)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-labelled"),
		openPull("labeled", false, "2026-11-05T08:10:14Z")
	) by GitHub
	let merged <- Deliveries.first("SELECT state, merged_at FROM pull_requests", [])
	expect merged == Ok(Some("{\"state\":\"merged\",\"merged_at\":\"2026-11-05T08:10:11.000Z\"}"))
	// Opened as a draft and marked ready within one second: the ready one applies.
	let _ <- Deliveries.run("DELETE FROM pull_requests", [])
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-open"),
		openPull("opened", true, "2026-11-05T07:54:42Z")
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-ready"),
		openPull("ready_for_review", false, "2026-11-05T07:54:42Z")
	) by GitHub
	let ready <- Deliveries.first("SELECT state, draft, ready_at FROM pull_requests", [])
	expect ready == Ok(Some("{\"state\":\"open\",\"draft\":0,\"ready_at\":\"2026-11-05T07:54:42.000Z\"}"))
}

case "the merge commit is kept only once the pull request has merged" {
	// GitHub names a test merge commit for an open pull request too; that one
	// is never on the base branch, so no release could ship it.
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-open"),
		openPull("opened", false, "2026-11-05T07:54:42Z")
	) by GitHub
	let open <- Deliveries.first("SELECT merge_commit_sha FROM pull_requests", [])
	expect open == Ok(Some("{\"merge_commit_sha\":null}"))
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-merged"),
		Bytes.fromUtf8(mergedPull)
	) by GitHub
	let merged <- Deliveries.first("SELECT merge_commit_sha FROM pull_requests", [])
	expect merged == Ok(Some("{\"merge_commit_sha\":\"5c1ea97f111ced1e27160467b9268efeedf216a7\"}"))
	// A later delivery that names none keeps it.
	let _ <- api.POST(
		"/github",
		headers("pull_request", "pr-edited"),
		Bytes.fromUtf8(mergedPull
			.replace("\"action\": \"closed\"", "\"action\": \"edited\"")
			.replace(
				"\"updated_at\": \"2026-11-05T08:10:14Z\"",
				"\"updated_at\": \"2026-11-05T08:20:00Z\""
			)
			.replace(
				"\"merge_commit_sha\": \"5c1ea97f111ced1e27160467b9268efeedf216a7\"",
				"\"merge_commit_sha\": null"
			))
	) by GitHub
	let edited <- Deliveries.first("SELECT updated_at FROM pull_requests", [])
	expect edited == Ok(Some("{\"updated_at\":\"2026-11-05T08:20:00.000Z\"}"))
	let kept <- Deliveries.first("SELECT merge_commit_sha FROM pull_requests", [])
	expect kept == Ok(Some("{\"merge_commit_sha\":\"5c1ea97f111ced1e27160467b9268efeedf216a7\"}"))
}

--- PR #25 open at `updated`, after `action`, asking `users` and `teams` (logins and slugs) to review.
fn requesting(
	action: String,
	extra: String,
	updated: String,
	users: List[String],
	teams: List[String]
) -> Bytes {
	let us = users.map((u) => "{\"login\": \"\(u)\", \"type\": \"User\"}")
	let ts = teams.map((t) => "{\"slug\": \"\(t)\"}")
	Bytes.fromUtf8(pullAt(action, extra, "open", false, updated, "null", "null")
		.decodeUtf8()
		.getOrElse("")
		.replace("\"requested_reviewers\": []", "\"requested_reviewers\": [\(joined(us, ", "))]")
		.replace("\"requested_teams\": []", "\"requested_teams\": [\(joined(ts, ", "))]"))
}

---
Who pull request 25 waits on: users by login, teams as `@slug`, sorted and
comma-separated; `None` when nobody.
---
type Waiting = {
	who: Option[String],
}

const WAITING_SQL: String = """
	FROM (SELECT group_concat(who, ',') AS who
	      FROM (SELECT CASE WHEN team = 1 THEN '@' || reviewer ELSE reviewer END AS who
	            FROM pull_request_review_requests
	            WHERE repo = 'bynk-lang/github-hooks' AND number = 25 ORDER BY who))
"""

--- `WAITING_SQL`'s row for `names`.
fn requested(names: String) -> Result[Option[Waiting], SqlReadError] {
	Ok(Some(Waiting { who: if names == "" { None } else { Some(names) } }))
}

case "a pull request records its head commit and whose review it waits on" {
	let r <- api.POST(
		"/github",
		headers("pull_request", "rq-1"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"b-person\", \"type\": \"User\"}",
			"2026-11-05T09:00:00Z",
			["a-person", "b-person"],
			["core"]
		)
	) by GitHub
	expect r is Accepted(_)
	let sha <- Deliveries.first("SELECT head_sha FROM pull_requests WHERE number = 25", [])
	expect sha == Ok(Some("{\"head_sha\":\"b65fe31d2f057a5af17713d14e71dae5b28fd600\"}"))
	let first <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect first == requested("@core,a-person,b-person")
}

case "requests made in the same second combine, and a removal or a review takes one off" {
	// Two requests in one second: each delivery lists the set at its moment,
	// and they may arrive in either order. The tie never replaces the set;
	// each adds the one it names.
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-2"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:00:00Z",
			["a-person", "c-person"],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-1"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"a-person\", \"type\": \"User\"}",
			"2026-11-05T09:00:00Z",
			["a-person"],
			[]
		)
	) by GitHub
	let both <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect both == requested("a-person,c-person")
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-3"),
		requesting(
			"review_request_removed",
			", \"requested_team\": {\"slug\": \"core\"}",
			"2026-11-05T09:01:00Z",
			["a-person", "c-person"],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-4"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:02:00Z",
			["a-person"],
			[]
		)
	) by GitHub
	let removed <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect removed == requested("a-person")
	// Reviewing satisfies the request, as GitHub has it: a review submitted
	// after the request was made.
	let reviewed = Bytes.fromUtf8(review
		.replace("\"login\": \"accuser\"", "\"login\": \"A-Person\"")
		.replace(
			"\"submitted_at\": \"2026-11-05T08:06:04Z\"",
			"\"submitted_at\": \"2026-11-05T09:03:00Z\""
		))
	let _ <- api.POST("/github", headers("pull_request_review", "rv-9"), reviewed) by GitHub
	let after <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect after == requested("")
}

case "a removal that arrives before the request it undoes still wins (#68)" {
	// A CODEOWNERS request withdrawn a minute later, delivered the other way round.
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rm-1"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:01:00Z",
			[],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-1"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:00:00Z",
			["c-person"],
			[]
		)
	) by GitHub
	let waiting <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect waiting == requested("")
}

case "a review that arrives before the request it answers still takes it off (#68)" {
	let reviewed = Bytes.fromUtf8(review
		.replace("\"login\": \"accuser\"", "\"login\": \"a-person\"")
		.replace(
			"\"submitted_at\": \"2026-11-05T08:06:04Z\"",
			"\"submitted_at\": \"2026-11-05T09:03:00Z\""
		))
	let _ <- api.POST("/github", headers("pull_request_review", "rv-1"), reviewed) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-1"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"a-person\", \"type\": \"User\"}",
			"2026-11-05T09:00:00Z",
			["a-person"],
			[]
		)
	) by GitHub
	let waiting <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect waiting == requested("")
}

case "a request made after a removal or a review stays, whichever arrives first (#68)" {
	// Asked again at 09:05, after a removal at 09:01 and a review at 09:03,
	// and delivered before both.
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-5"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"a-person\", \"type\": \"User\"}",
			"2026-11-05T09:05:00Z",
			["a-person"],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rm-1"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"a-person\", \"type\": \"User\"}",
			"2026-11-05T09:01:00Z",
			[],
			[]
		)
	) by GitHub
	let reviewed = Bytes.fromUtf8(review
		.replace("\"login\": \"accuser\"", "\"login\": \"a-person\"")
		.replace(
			"\"submitted_at\": \"2026-11-05T08:06:04Z\"",
			"\"submitted_at\": \"2026-11-05T09:03:00Z\""
		))
	let _ <- api.POST("/github", headers("pull_request_review", "rv-1"), reviewed) by GitHub
	let waiting <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect waiting == requested("a-person")
}

case "a late, older removal doesn't move a newer one back (#68)" {
	// Removals at 09:05 and 09:01 arrive newest first, then a request made at
	// 09:03: the 09:05 removal still undoes it.
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rm-5"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:05:00Z",
			[],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rm-1"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:01:00Z",
			[],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-3"),
		requesting(
			"review_requested",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:03:00Z",
			["c-person"],
			[]
		)
	) by GitHub
	let waiting <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect waiting == requested("")
}

case "an old request redelivered after its tombstone has gone changes nothing (#68, #77 review)" {
	// Asked at 09:00, withdrawn at 09:01; a newer delivery at 09:10 settles
	// the tombstone, as retention would after a day. Then the 09:00 request is
	// redelivered: the row is newer, so its set already said who is asked.
	let asked = requesting(
		"review_requested",
		", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
		"2026-11-05T09:00:00Z",
		["c-person"],
		[]
	)
	let _ <- api.POST("/github", headers("pull_request", "rq-1"), asked) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rm-1"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:01:00Z",
			[],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "ed-1"),
		requesting("edited", "", "2026-11-05T09:10:00Z", [], [])
	) by GitHub
	let settled <- Deliveries.first("SELECT count(*) AS n FROM pull_request_review_tombstones", [])
	expect settled == Ok(Some("{\"n\":0}"))
	let _ <- api.POST("/github", headers("pull_request", "rq-1-again"), asked) by GitHub
	let waiting <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect waiting == requested("")
}

case "a newer set settles a removal: who it lists is asked again, and the tombstone goes (#68)" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rm-1"),
		requesting(
			"review_request_removed",
			", \"requested_reviewer\": {\"login\": \"c-person\", \"type\": \"User\"}",
			"2026-11-05T09:01:00Z",
			[],
			[]
		)
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "ed-1"),
		requesting("edited", "", "2026-11-05T09:10:00Z", ["c-person"], [])
	) by GitHub
	let waiting <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect waiting == requested("c-person")
	let left <- Deliveries.first("SELECT count(*) AS n FROM pull_request_review_tombstones", [])
	expect left == Ok(Some("{\"n\":0}"))
}

case "a strictly newer delivery's set replaces the requests, and an older one changes nothing" {
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-5"),
		requesting("edited", "", "2026-11-05T09:05:00Z", ["a-person", "b-person"], ["core"])
	) by GitHub
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-6"),
		requesting("edited", "", "2026-11-05T09:01:00Z", ["z-late"], [])
	) by GitHub
	let kept <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect kept == requested("@core,a-person,b-person")
	let _ <- api.POST(
		"/github",
		headers("pull_request", "rq-7"),
		requesting("edited", "", "2026-11-05T09:10:00Z", [], [])
	) by GitHub
	let cleared <- Deliveries.firstAs[Waiting](WAITING_SQL, [])
	expect cleared == requested("")
}
