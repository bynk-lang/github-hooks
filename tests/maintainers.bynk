// Phase 4, slice 6, step 1 (#53): signing maintainers in with GitHub. The
// sign-in code is exchanged at GitHub through the GitHub App's user
// authorisation (stubbed here at its capability), and the Worker issues its own
// token, which the `Maintainer` actor (Bynk's `Bearer`) verifies. These cases
// give the verified maintainer directly (`by Maintainer(login)`) and check what
// the routes do; GitHub's API is stubbed at the wire.
suite github.hooks

env {
	APP_CLIENT_ID = "Iv23liTestClient"
	APP_CLIENT_SECRET = "test-client-secret"
	MAINTAINER_TOKEN_SECRET = "test-signing-secret"
}

stub Clock.now() returns Instant.fromEpochMillis(1793880000000)

// GitHub's user token is revoked once it has said who signed in.
stub GitHubSignIn.revoke(_, _, _) returns Ok(())

--- A viewer's request headers: one address, well within the limit, at the deployed host.
fn viewer() -> RequestHeaders {
	at("github-hooks.bynk-lang.workers.dev")
}

--- The same viewer, reaching the Worker at `host`.
fn at(host: String) -> RequestHeaders {
	RequestHeaders.of(["CF-Connecting-IP: 203.0.113.7", "Host: \(host)"])
}

--- Installation 42 last delivered for one of bynk-lang's repositories.
fn installed() -> List[SqlStatement] {
	[
		SqlStatement {
			sql: """
				INSERT INTO repositories (repo, public) VALUES
				  ('bynk-lang/bynk', 1), ('bynk-lang/github-hooks', 0), ('someone-else/repo', 1)
			""",
			params: [],
		},
		SqlStatement {
			sql: """
				INSERT INTO deliveries (id, event, repo, installation, size, received_at) VALUES
				  ('d-old', 'push', 'bynk-lang/bynk', 7, 1, '2026-11-01T00:00:00.000Z'),
				  ('d-new', 'push', 'bynk-lang/github-hooks', 42, 1, '2026-11-05T00:00:00.000Z'),
				  ('d-other', 'push', 'someone-else/repo', 99, 1, '2026-11-06T00:00:00.000Z')
			""",
			params: [],
		},
	]
}

fn member() -> Result[Response, String] {
	Ok(Response {
		status: 200,
		headers: Map.empty(),
		body: "{\"state\": \"active\", \"role\": \"member\"}",
	})
}

fn notMember() -> Result[Response, String] {
	Ok(Response { status: 404, headers: Map.empty(), body: "{\"message\": \"Not Found\"}" })
}

--- A sign-in code exchange as the page sends it.
fn exchange(redirect: String) -> TokenRequest {
	TokenRequest {
		code: "the-code",
		code_verifier: "the-verifier",
		redirect_uri: redirect,
	}
}

fn deployed() -> TokenRequest {
	exchange("https://github-hooks.bynk-lang.workers.dev/maintainers/callback")
}

fn granted() -> Result[GitHubTokenReply, String] {
	Ok(GitHubTokenReply { access_token: Some("ghu_user"), error: None, error_description: None })
}

---
The token the Worker issues for accuser at the stubbed clock, signed with the
suite's `MAINTAINER_TOKEN_SECRET`: computed independently with Node's
`crypto.createHmac("sha256", …)`, so it pins the Worker's signing to standard
HS256, as Bynk's `Bearer` verifies it.
---
fn accuserToken() -> String {
	"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhY2N1c2VyIiwiaWF0IjoxNzkzODgwMDAwLCJleHAiOjE3OTM5MDg4MDB9.58EvP933ALbPj3WRgb9W9zqzABcubuRcXnySl5RN2wI"
}

--- As `accuserToken`, for the subject sign-in gives it: `accuser:0`, their first session.
fn accuserSessionToken() -> String {
	"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhY2N1c2VyOjAiLCJpYXQiOjE3OTM4ODAwMDAsImV4cCI6MTc5MzkwODgwMH0.C0naEnkeq3iuR95l4FdCaVua6gzdSPpU3-CXvGLkjZo"
}

case "the sign-in settings name GitHub and the App's client ID" {
	let r <- api.GET("/maintainers/config") by Visitor
	expect r == Ok(SignInConfig {
		authorization_endpoint: "https://github.com/login/oauth/authorize",
		client_id: "Iv23liTestClient",
	})
}

case "a maintainer's token is a standard HS256 JWT for their login, lasting a working day" {
	let t <- sessionToken("test-signing-secret", "accuser", Instant.fromEpochMillis(1793880000000))
	expect t == accuserToken()
}

case "a member who signs in with GitHub gets a token for their login" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "accuser" })
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	// The token's subject carries accuser's session version, 0 before they first sign out.
	expect r == Ok(SignedIn { token: accuserSessionToken(), expires_in: 28800, login: "accuser" })
	expect GitHubSignIn.exchange called once with clientId == "Iv23liTestClient"
	expect GitHubSignIn.exchange called once with clientSecret == "test-client-secret"
	expect GitHubSignIn.user called once with token == "ghu_user"
	expect GitHubSignIn.revoke called once with token == "ghu_user"
	expect GitHubSignIn.revoke called once with clientSecret == "test-client-secret"
	expect AppAuth.token called once with installation == 42
	expect GitHubHttp.get called once with url == "https://api.github.com/orgs/bynk-lang/memberships/accuser"
}

case "someone outside the organisation who signs in with GitHub gets no token" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "a-stranger" })
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns notMember()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect r is RawError(403, _, _)
	let RawError(_, body, _) = r else {
		expect false
	}
	expect body.decodeUtf8().getOrElse("").contains("not_a_member")
}

case "a code GitHub refuses is a bad request with its reason; GitHub unreachable is a bad gateway" {
	stub GitHubSignIn.exchange(_, _, _) returns each [Ok(GitHubTokenReply { access_token: None, error: Some("bad_verification_code"), error_description: Some("The code passed is incorrect or expired.") }), Err("GitHub could not be reached to finish a sign-in"), granted()]
	stub GitHubSignIn.user(_) returns Err("GitHub answered 401 when asked who signed in")
	let refused <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect refused is BadRequest("GitHub refused the sign-in: bad_verification_code")
	let down <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect down is BadGateway(_)
	let nobody <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect nobody is BadGateway(_)
	// Even when GitHub can't say who it is, the user token is revoked.
	expect GitHubSignIn.revoke called once with token == "ghu_user"
}

case "signing in asks GitHub afresh: a kept answer from yesterday doesn't issue a token to a leaver" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "a-leaver" })
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns notMember()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	// GitHub said yes yesterday afternoon, within the day an answer is kept.
	let kept <- Deliveries.run(
		"INSERT INTO org_members (org, login, member, checked_at) VALUES ('bynk-lang', 'a-leaver', 1, '2026-11-05T15:00:00.000Z')",
		[]
	)
	expect kept is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect r is RawError(403, _, _)
	expect GitHubHttp.get called once with url == "https://api.github.com/orgs/bynk-lang/memberships/a-leaver"
	// The fresh answer is kept, so the next request is refused without asking.
	let after <- api.GET("/maintainers/me") by Maintainer("a-leaver")
	expect after is RawError(403, _, _)
	expect GitHubHttp.get called once
}

case "a user token GitHub won't revoke is logged, and the sign-in still finishes" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "accuser" })
	stub GitHubSignIn.revoke(_, _, _) returns Err("GitHub answered 422")
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect r is Ok(_)
	expect Logger.warn called once
}

case "if GitHub can't say whether they belong, the sign-in is unavailable, not refused" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "accuser" })
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect r is ServiceUnavailable(_)
	expect Logger.error called once
}

case "only this service's callback may receive a code, and exchanges are limited per address" {
	stub MetricsLimit.allow(_) returns each [true, true, true, false]
	let elsewhere <- api.POST(
		"/maintainers/token",
		exchange("https://evil.example/steal"),
		viewer()
	) by Visitor
	expect elsewhere is BadRequest(_)
	// Ending in the callback's path isn't enough: it must be this origin's.
	let lookalike <- api.POST(
		"/maintainers/token",
		exchange("https://evil.example/maintainers/callback"),
		viewer()
	) by Visitor
	expect lookalike is BadRequest(_)
	let downgraded <- api.POST(
		"/maintainers/token",
		exchange("http://github-hooks.bynk-lang.workers.dev/maintainers/callback"),
		viewer()
	) by Visitor
	expect downgraded is BadRequest(_)
	let limited <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect limited is TooManyRequests(_)
	expect GitHubSignIn.exchange never called
}

case "a local Worker's plain-http callback is accepted, on its own host only" {
	stub GitHubSignIn.exchange(_, _, _) returns Ok(GitHubTokenReply { access_token: None, error: Some("bad_verification_code"), error_description: None })
	let local <- api.POST(
		"/maintainers/token",
		exchange("http://localhost:8787/maintainers/callback"),
		at("localhost:8787")
	) by Visitor
	expect local is BadRequest("GitHub refused the sign-in: bad_verification_code")
	let otherPort <- api.POST(
		"/maintainers/token",
		exchange("http://localhost:9999/maintainers/callback"),
		at("localhost:8787")
	) by Visitor
	expect otherPort is BadRequest("the redirect URI must be this service's /maintainers/callback")
	expect isOwnCallback(
		"https://github-hooks.bynk-lang.workers.dev/maintainers/callback",
		"github-hooks.bynk-lang.workers.dev"
	)
	expect !isOwnCallback("http://github-hooks.bynk-lang.workers.dev/maintainers/callback", "github-hooks.bynk-lang.workers.dev")
	expect !isOwnCallback("https://github-hooks.bynk-lang.workers.dev/maintainers/callback", "")
	expect GitHubSignIn.exchange called once
}

case "a signed-in member is told who they are, after GitHub confirms they still belong" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.GET("/maintainers/me") by Maintainer("accuser")
	expect r == Ok(Me { login: "accuser" })
	expect AppAuth.token called once with installation == 42
}

case "a membership GitHub confirmed today is used without finding an installation" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let kept <- Deliveries.run(
		"INSERT INTO org_members (org, login, member, checked_at) VALUES ('bynk-lang', 'accuser', 1, '2026-11-05T12:00:00.000Z')",
		[]
	)
	expect kept is Ok(_)
	let r <- api.GET("/maintainers/me") by Maintainer("Accuser")
	expect r == Ok(Me { login: "Accuser" })
	expect AppAuth.token never called
	expect GitHubHttp.get never called
}

case "someone who has left the organisation is refused, even with a token" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns notMember()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.GET("/maintainers/me") by Maintainer("a-leaver")
	expect r is RawError(403, _, _)
	let RawError(_, body, _) = r else {
		expect false
	}
	expect body.decodeUtf8().getOrElse("").contains("not_a_member")
}

case "a private member is a member, an invitation isn't, and an App that can't see members is an error" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns each [Ok(Response { status: 200, headers: Map.empty(), body: "{\"state\": \"active\", \"role\": \"admin\"}" }), Ok(Response { status: 200, headers: Map.empty(), body: "{\"state\": \"pending\", \"role\": \"member\"}" }), Ok(Response { status: 403, headers: Map.empty(), body: "{\"message\": \"Resource not accessible by integration\"}" })]
	let owner <- GitHubApi.isMember(42, "bynk-lang", "accuser")
	expect owner == Ok(true)
	let invited <- GitHubApi.isMember(42, "bynk-lang", "invitee")
	expect invited == Ok(false)
	let unseen <- GitHubApi.isMember(42, "bynk-lang", "someone")
	expect unseen is Err(_)
	expect GitHubHttp.get called with url == "https://api.github.com/orgs/bynk-lang/memberships/accuser"
}

case "signing in while the App can't see members is unavailable, not a refusal" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "accuser" })
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns Ok(Response { status: 403, headers: Map.empty(), body: "{\"message\": \"Resource not accessible by integration\"}" })
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect r is ServiceUnavailable(_)
}

case "if GitHub can't say, or no installation is known, the answer is unavailable, not a refusal" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns Ok(Response { status: 500, headers: Map.empty(), body: "{\"message\": \"Server Error\"}" })
	let none <- api.GET("/maintainers/me") by Maintainer("accuser")
	expect none is ServiceUnavailable(_)
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let failing <- api.GET("/maintainers/me") by Maintainer("accuser")
	expect failing is ServiceUnavailable(_)
	expect Logger.error called 2 times
}

case "the callback page loads the sign-in script, and every dashboard has the sign-in link" {
	let r <- api.GET("/maintainers/callback") by Visitor
	let Raw(body, contentType) = r else {
		expect false
	}
	expect contentType == "text/html; charset=utf-8"
	let page = body.decodeUtf8().getOrElse("")
	expect page.contains("src=\"\(signinJs.url)\"")
	expect page.contains("id=\"signin-status\"")
	let ci <- api.GET("/") by Visitor
	let prs <- api.GET("/prs") by Visitor
	let releases <- api.GET("/releases") by Visitor
	let issues <- api.GET("/issues") by Visitor
	let pages = [ci, prs, releases, issues].map((p) => match p {
		Raw(b, _) => b.decodeUtf8().getOrElse(""),
		_ => "",
	})
	expect pages.all((p) => p.contains("src=\"\(signinJs.url)\"")
		&& p.contains("id=\"signin\"")
		&& !p.contains("{signin}"))
	// The page scripts fetch through signin.js (#53, step 3), so it loads first.
	expect pages.all(
		(p) => !p.split("<script src=\"\(signinJs.url)\"").first().getOrElse("").contains("<script")
	)
	// Signed in, each page shows what's the maintainer's, its own part of it.
	expect pages.map((p) => ["ci", "prs", "issues", "releases"].filter((k) => p.contains(
		"data-mine=\"\(k)\""
	))) == [["ci"], ["prs"], ["releases"], ["issues"]]
	// Signed in, each page says it covers every repository.
	expect pages.all((p) => p.contains("class=\"subtitle for-public\"")
		&& p.contains("class=\"subtitle for-maintainers\""))
}

case "signing out ends every earlier token for the login, though none has expired" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	// A token from before sessions (a plain login) is the first session's.
	let before <- api.GET("/maintainers/me") by Maintainer("accuser")
	expect before == Ok(Me { login: "accuser" })
	let out <- api.POST("/maintainers/signout") by Maintainer("accuser:0")
	expect out == Ok(Me { login: "accuser" })
	let old <- api.GET("/maintainers/me") by Maintainer("accuser")
	expect old is RawError(403, _, _)
	let RawError(_, body, _) = old else {
		expect false
	}
	expect body.decodeUtf8().getOrElse("").contains("signed_out")
	let stillOld <- api.GET(
		"/maintainers/metrics/ci/now",
		NowQuery { repo: None }
	) by Maintainer("accuser:0")
	expect stillOld is RawError(403, _, _)
	// The next session's token is let in; another maintainer's is untouched.
	let next <- api.GET("/maintainers/me") by Maintainer("Accuser:1")
	expect next == Ok(Me { login: "Accuser" })
	let other <- api.GET("/maintainers/me") by Maintainer("someone-else")
	expect other == Ok(Me { login: "someone-else" })
}

case "signing in after signing out issues the next session's token" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "accuser" })
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let out <- api.POST("/maintainers/signout") by Maintainer("accuser")
	expect out is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	let Ok(signed) = r else {
		expect false
	}
	// The subject is the token's middle part: {"sub":"accuser:1",...}.
	let claims = signed.token
		.split(".")
		.get(1)
		.andThen((p) => Bytes.fromBase64Url(p))
		.andThen((b) => b.decodeUtf8())
	expect claims.getOrElse("").contains("\"sub\":\"accuser:1\"")
}

case "a sign-in whose session can't be read is refused, not issued an old version's token" {
	stub GitHubSignIn.exchange(_, _, _) returns granted()
	stub GitHubSignIn.user(_) returns Ok(GitHubUser { login: "accuser" })
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let broken <- Deliveries.run("DROP TABLE maintainer_sessions", [])
	expect broken is Ok(_)
	let r <- api.POST("/maintainers/token", deployed(), viewer()) by Visitor
	expect r is ServiceUnavailable(_)
}
