// Phase 4, slice 6, step 1 (#53): signing maintainers in. The `Maintainer`
// actor's token is Bynk's to verify (an `Oidc` actor against the Access
// application's JWKS); these cases give the verified principal and its claims
// directly (`by Maintainer(sub, TokenClaims.of(...))`), and check what the
// routes do with them. GitHub is stubbed at the wire, Access at its capability.
suite github.hooks

--- A viewer's request headers: one address, well within the limit.
fn viewer() -> RequestHeaders {
	RequestHeaders.of(["CF-Connecting-IP: 203.0.113.7"])
}

--- Installation 42 last delivered for one of bynk-lang's repositories.
fn installed() -> List[SqlStatement] {
	[
		SqlStatement {
			sql: """
				INSERT INTO deliveries (id, event, repo, installation, size, received_at) VALUES
				  ('d-old', 'push', 'bynk-lang/bynk', 7, 1, '2026-11-01T00:00:00.000Z'),
				  ('d-new', 'push', 'bynk-lang/github-hooks', 42, 1, '2026-11-05T00:00:00.000Z'),
				  ('d-other', 'push', 'someone-else/repo', 99, 1, '2026-11-06T00:00:00.000Z')
			""",
			params: [],
		},
	]
}

fn member() -> Result[Response, String] {
	Ok(Response { status: 204, headers: Map.empty(), body: "" })
}

fn notMember() -> Result[Response, String] {
	Ok(Response { status: 404, headers: Map.empty(), body: "{\"message\": \"Not Found\"}" })
}

--- A sign-in code exchange as the page sends it.
fn exchange(redirect: String) -> TokenRequest {
	TokenRequest {
		code: "the-code",
		code_verifier: "the-verifier",
		redirect_uri: redirect,
	}
}

case "the sign-in settings come from the declared Access application" {
	let r <- api.GET("/maintainers/config") by Visitor
	expect r == Ok(SignInConfig {
		authorization_endpoint: "https://bynk-lang.cloudflareaccess.com/cdn-cgi/access/sso/oidc/fba9900eff8cefeca28cc95d364cae191a747ead0d670a9d11c0c88451869d0a/authorization",
		client_id: "fba9900eff8cefeca28cc95d364cae191a747ead0d670a9d11c0c88451869d0a",
		logout_url: "https://bynk-lang.cloudflareaccess.com/cdn-cgi/access/logout",
	})
}

case "MAINTAINER_OIDC replaces the declared trust, and one that doesn't read falls back to it" {
	let fake = trustOf(
		Some("{\"issuer\": \"http://localhost:9999/oidc/test-client\", \"jwks\": \"http://localhost:9999/oidc/test-client/jwks\", \"audience\": \"test-client\"}")
	)
	expect signInConfigOf(
		fake
	) == SignInConfig {
		authorization_endpoint: "http://localhost:9999/oidc/test-client/authorization",
		client_id: "test-client",
		logout_url: "http://localhost:9999/oidc/test-client/cdn-cgi/access/logout",
	}
	expect trustOf(Some("not json")).issuer == "https://bynk-lang.cloudflareaccess.com/cdn-cgi/access/sso/oidc/fba9900eff8cefeca28cc95d364cae191a747ead0d670a9d11c0c88451869d0a"
	expect trustOf(None).jwks.endsWith("/jwks")
}

case "a signed-in member is told who they are, by their GitHub login, after GitHub confirms they belong" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/maintainers/me"
	) by Maintainer("access-user-1", TokenClaims.of(["login: accuser", "email: accuser@example.com"]))
	expect r == Ok(Me {
		sub: "access-user-1",
		login: "accuser",
		email: Some("accuser@example.com"),
		name: None,
		claims: ["login", "email"],
	})
	expect AppAuth.token called once with installation == 42
	expect GitHubHttp.get called once with url == "https://api.github.com/orgs/bynk-lang/members/accuser"
}

case "a login under another claim name is found too" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns member()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/maintainers/me"
	) by Maintainer("access-user-1", TokenClaims.of(["preferred_username: accuser"]))
	let Ok(me) = r else {
		expect false
	}
	expect me.login == "accuser"
	expect me.claims == ["preferred_username"]
}

case "a token with no GitHub login is refused, naming the claims it did carry" {
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/maintainers/me"
	) by Maintainer("access-user-1", TokenClaims.of(["email: accuser@example.com", "name: A User"]))
	expect r is RawError(403, _, _)
	let RawError(_, body, _) = r else {
		expect false
	}
	expect body.decodeUtf8().getOrElse("").contains("present: email, name")
	expect GitHubHttp.get never called
}

case "someone GitHub says isn't in the organisation is refused" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns notMember()
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let r <- api.GET(
		"/maintainers/me"
	) by Maintainer("access-user-2", TokenClaims.of(["login: a-stranger"]))
	expect r is RawError(403, _, _)
	let RawError(_, body, _) = r else {
		expect false
	}
	expect body.decodeUtf8().getOrElse("").contains("not_a_member")
}

case "if GitHub can't say, or no installation is known, the answer is unavailable, not a refusal" {
	stub AppAuth.token(_) returns Ok("ghs_test")
	stub GitHubHttp.get(_, _) returns Ok(Response { status: 500, headers: Map.empty(), body: "{\"message\": \"Server Error\"}" })
	let none <- api.GET(
		"/maintainers/me"
	) by Maintainer("access-user-1", TokenClaims.of(["login: accuser"]))
	expect none is ServiceUnavailable(_)
	let seeded <- Deliveries.batch(installed())
	expect seeded is Ok(_)
	let failing <- api.GET(
		"/maintainers/me"
	) by Maintainer("access-user-1", TokenClaims.of(["login: accuser"]))
	expect failing is ServiceUnavailable(_)
	expect Logger.error called once
}

case "a sign-in code is exchanged at Access's token endpoint for the page" {
	stub AccessOidc.exchange(_, _, _) returns Ok(AccessTokenReply { id_token: Some("eyJ.token.sig"), expires_in: Some(3600), error: None, error_description: None })
	let r <- api.POST(
		"/maintainers/token",
		exchange("https://github-hooks.bynk-lang.workers.dev/maintainers/callback"),
		viewer()
	) by Visitor
	expect r == Ok(SignedIn { id_token: "eyJ.token.sig", expires_in: Some(3600) })
	expect AccessOidc.exchange called once with tokenUrl == "https://bynk-lang.cloudflareaccess.com/cdn-cgi/access/sso/oidc/fba9900eff8cefeca28cc95d364cae191a747ead0d670a9d11c0c88451869d0a/token"
	expect AccessOidc.exchange called once with clientId == "fba9900eff8cefeca28cc95d364cae191a747ead0d670a9d11c0c88451869d0a"
}

case "a code Access refuses is a bad request with its reason; Access unreachable is a bad gateway" {
	stub AccessOidc.exchange(_, _, _) returns each [Ok(AccessTokenReply { id_token: None, expires_in: None, error: Some("invalid_grant"), error_description: Some("code expired") }), Err("Cloudflare Access could not be reached")]
	let refused <- api.POST(
		"/maintainers/token",
		exchange("https://github-hooks.bynk-lang.workers.dev/maintainers/callback"),
		viewer()
	) by Visitor
	expect refused is BadRequest("Cloudflare Access refused the sign-in: invalid_grant")
	let down <- api.POST(
		"/maintainers/token",
		exchange("https://github-hooks.bynk-lang.workers.dev/maintainers/callback"),
		viewer()
	) by Visitor
	expect down is BadGateway(_)
}

case "only this service's callback may receive a code, and exchanges are limited per address" {
	stub MetricsLimit.allow(_) returns each [true, false]
	let elsewhere <- api.POST(
		"/maintainers/token",
		exchange("https://evil.example/steal"),
		viewer()
	) by Visitor
	expect elsewhere is BadRequest(_)
	let limited <- api.POST(
		"/maintainers/token",
		exchange("https://github-hooks.bynk-lang.workers.dev/maintainers/callback"),
		viewer()
	) by Visitor
	expect limited is TooManyRequests(_)
	expect AccessOidc.exchange never called
}

case "the callback page loads the sign-in script, and every dashboard has the sign-in link" {
	let r <- api.GET("/maintainers/callback") by Visitor
	let Raw(body, contentType) = r else {
		expect false
	}
	expect contentType == "text/html; charset=utf-8"
	let page = body.decodeUtf8().getOrElse("")
	expect page.contains("src=\"\(signinJs.url)\"")
	expect page.contains("id=\"signin-status\"")
	let ci <- api.GET("/") by Visitor
	let prs <- api.GET("/prs") by Visitor
	let releases <- api.GET("/releases") by Visitor
	let issues <- api.GET("/issues") by Visitor
	let pages = [ci, prs, releases, issues].map((p) => match p {
		Raw(b, _) => b.decodeUtf8().getOrElse(""),
		_ => "",
	})
	expect pages.all((p) => p.contains("src=\"\(signinJs.url)\"")
		&& p.contains("id=\"signin\"")
		&& !p.contains("{signin}"))
}
