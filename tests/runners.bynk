				  (8, 'bynk-lang/bynk', 8, 1, 'CI', 'Test suite', 'self-hosted', NULL, 'completed', 'skipped',
				   '2026-11-04T11:00:00.000Z', '2026-11-04T11:00:00.000Z', '2026-11-04T11:00:00.000Z', 0),
				  (9, 'bynk-lang/bynk', 9, 1, 'CI', 'Test suite', 'self-hosted', NULL, 'completed', 'cancelled',
				   '2026-11-04T11:00:00.000Z', NULL, '2026-11-04T11:10:00.000Z', 0),
				  (10, 'bynk-lang/bynk', 10, 1, 'CI', 'Lint', 'ubuntu-latest', 'GitHub Actions', 'completed', 'success',
				   '2026-07-01T09:00:00.000Z', '2026-07-01T09:30:00.000Z', '2026-07-01T09:31:00.000Z', 0),
				  (11, 'bynk-lang/bynk', 11, 1, 'CI', 'Lint', 'ubuntu-latest', NULL, 'queued', NULL,
				   '2026-11-05T11:58:00.000Z', NULL, NULL, 0),
				  (12, 'bynk-lang/bynk', 12, 1, 'CI', 'Test suite', 'ubuntu-latest', NULL, 'queued', NULL,
				   '2026-11-05T11:50:00.000Z', NULL, NULL, 0),
				  (13, 'bynk-lang/bynk', 13, 1, 'CI', 'Test suite', 'self-hosted', NULL, 'queued', NULL,
				   '2026-11-03T10:00:00.000Z', NULL, NULL, 0),
				  (14, 'bynk-lang/bynk', 14, 1, 'Release', 'Deploy', 'self-hosted', NULL, 'waiting', NULL,
