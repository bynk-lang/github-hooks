}

case "the hourly figures: waits by runner, the longest waits and the slowest jobs, for the week" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let ran <- runnerFigures.schedule("37 * * * *", nowMs())
	expect ran == Ok(())
	let r <- api.GET("/metrics/runners", RunnerQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.computed_at == Some("2026-11-05T12:00:00.000Z")
	expect m.since == Some("2026-10-29T12:00:00.000Z")
	expect m.until == Some("2026-11-05T12:00:00.000Z")
	expect m.data_since == Some("2026-07-01T09:00:00.000Z")
	expect m.runners == [
		RunnerWait {
			repo: "bynk-lang/bynk",
			runner: "self-hosted",
			jobs: 3,
			p50_seconds: Some(120),
			p95_seconds: Some(600),
			longest_seconds: Some(600),
		},
		RunnerWait {
			repo: "bynk-lang/bynk",
			runner: "macos-latest",
			jobs: 2,
			p50_seconds: Some(10),
			p95_seconds: Some(20),
			longest_seconds: Some(20),
		},
		RunnerWait {
			repo: "bynk-lang/bynk",
			runner: "ubuntu-latest",
			jobs: 2,
			p50_seconds: Some(3),
			p95_seconds: Some(5),
			longest_seconds: Some(5),
		},
	]
	expect m.longest.map(
		(l) => "\(l.name) \(l.runner) \(l.wait_seconds)"
	) == [
		"Docs self-hosted 600",
		"Test suite self-hosted 120",
		"Test suite self-hosted 60",
		"Lint macos-latest 20",
		"Test suite macos-latest 10",
		"Lint ubuntu-latest 5",
		"Lint ubuntu-latest 3",
	]
	expect m.longest.first() == Some(LongWait {
		repo: "bynk-lang/bynk",
		workflow: "CI",
		name: "Docs",
		runner: "self-hosted",
		wait_seconds: 600,
		queued_at: "2026-11-02T10:00:00.000Z",
		url: "https://github.com/bynk-lang/bynk/actions/runs/3/job/3",
	})
	expect m.slowest == [
		JobTime {
			repo: "bynk-lang/bynk",
			workflow: "CI",
			name: "Test suite",
			runs: 3,
			p50_seconds: Some(1400),
			p95_seconds: Some(1500),
		},
		JobTime {
			repo: "bynk-lang/bynk",
			workflow: "CI",
			name: "Lint",
			runs: 3,
			p50_seconds: Some(75),
			p95_seconds: Some(90),
		},
	]
}

case "the 30-day window reaches further back, and a repository filter narrows it" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let _ <- runnerFigures.schedule("37 * * * *", nowMs())
	let r <- api.GET(
		"/metrics/runners",
		RunnerQuery {
			repo: Some("Bynk-Lang/Bynk"),
			days: 30,
		},
		viewer()
	) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.since == Some("2026-10-06T12:00:00.000Z")
	expect m.runners.first() == Some(RunnerWait {
		repo: "bynk-lang/bynk",
		runner: "self-hosted",
		jobs: 4,
		p50_seconds: Some(120),
		p95_seconds: Some(900),
		longest_seconds: Some(900),
	})
	expect m.slowest
		.first()
		.map(
			(j) => "\(j.name) \(j.runs) \(j.p50_seconds.getOrElse(0)) \(j.p95_seconds.getOrElse(0))"
		) == Some("Test suite 4 1300 1500")
	let other <- api.GET(
		"/metrics/runners",
		RunnerQuery {
			repo: Some("bynk-lang/other"),
			days: 30,
		},
		viewer()
	) by Visitor
	let Ok(o) = other else {
		expect false
	}
	expect o.runners.length() == 0
	expect o.longest.length() == 0
	expect o.slowest.length() == 0
}

case "a private or excluded repository's figures are computed, but never shown" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let _ <- runnerFigures.schedule("37 * * * *", nowMs())
	let stored <- Deliveries.first("SELECT runners FROM runner_windows WHERE days = 7", [])
	let Ok(Some(row)) = stored else {
		expect false
	}
	expect row.contains("bynk-lang/secret")
	expect row.contains("bynk-lang/sandbox")
	let r <- api.GET("/metrics/runners", RunnerQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.runners.map((w) => w.repo) == ["bynk-lang/bynk", "bynk-lang/bynk", "bynk-lang/bynk"]
	expect m.longest.all((l) => l.repo == "bynk-lang/bynk")
	expect m.slowest.all((j) => j.repo == "bynk-lang/bynk")
}

case "before the first computation, the figures are empty, not an error" {
	let r <- api.GET("/metrics/runners", RunnerQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.computed_at == None
	expect m.runners.length() == 0
}

case "a run over no jobs stores empty lists" {
	let ran <- runnerFigures.schedule("37 * * * *", nowMs())
	expect ran == Ok(())
	let r <- api.GET("/metrics/runners", RunnerQuery { repo: None, days: 90 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.computed_at == Some("2026-11-05T12:00:00.000Z")
	expect m.data_since == None
	expect m.runners.length() == 0
	expect m.longest.length() == 0
	expect m.slowest.length() == 0
}

case "what is waiting now: queued for a runner, and held for an approval, by runner" {
	let seeded <- Deliveries.batch(seed())
	expect seeded is Ok(_)
	let r <- api.GET("/metrics/runners/now", NowQuery { repo: None }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.waiting == [
		WaitingNow {
			repo: "bynk-lang/bynk",
			runner: "ubuntu-latest",
			queued: 2,
			oldest_queued_at: Some("2026-11-05T11:50:00.000Z"),
			awaiting_approval: 0,
		},
		WaitingNow {
			repo: "bynk-lang/bynk",
			runner: "self-hosted",
			queued: 0,
			oldest_queued_at: None,
			awaiting_approval: 1,
		},
	]
}

case "a runners window other than 7, 30 or 90 days is refused, and the limit applies to both runner routes" {
	stub MetricsLimit.allow(_) returns each [true, false, false]
	let bad <- api.GET(
		"/metrics/runners",
		RunnerQuery {
			repo: None,
			days: 14,
		},
		viewer()
	) by Visitor
	expect bad is BadRequest("days must be 7, 30 or 90")
	let limited <- api.GET(
		"/metrics/runners",
		RunnerQuery {
			repo: None,
			days: 7,
		},
		viewer()
	) by Visitor
	expect limited is TooManyRequests(_)
	let now <- api.GET("/metrics/runners/now", NowQuery { repo: None }, viewer()) by Visitor
	expect now is TooManyRequests(_)
}

case "each repository keeps its 10 longest waits and 10 slowest jobs" {
	// Twelve job names, each run three times: 36 jobs waiting 1 to 36 s, job
	// k running k × 10 s each time. The 10 longest waits are 36 s down to
	// 27 s, and the 10 slowest jobs those that ran 120 s down to 30 s.
	let seeded <- Deliveries.batch(
		[
			SqlStatement {
				sql: "INSERT INTO repositories (repo, public, default_branch) VALUES ('bynk-lang/bynk', 1, 'main')",
				params: [],
			},
			SqlStatement {
				sql: """
					INSERT INTO workflow_jobs (job_id, repo, run_id, attempt, workflow, name, runner, runner_group, status,
					                           conclusion, created_at, started_at, completed_at, approval)
					WITH RECURSIVE n (value) AS (SELECT 1 UNION ALL SELECT value + 1 FROM n WHERE value < 36),
					jobs (value, k) AS (SELECT value, (value - 1) % 12 + 1 FROM n)
					SELECT value, 'bynk-lang/bynk', value, 1, 'CI', 'Job ' || k, 'ubuntu-latest', NULL, 'completed', 'success',
					       '2026-11-04T09:00:00.000Z',
					       strftime('%Y-%m-%dT%H:%M:%fZ', '2026-11-04T09:00:00.000Z', '+' || value || ' seconds'),
					       strftime('%Y-%m-%dT%H:%M:%fZ', '2026-11-04T09:00:00.000Z', '+' || (value + k * 10) || ' seconds'),
					       0
					FROM jobs
				""",
				params: [],
			},
		]
	)
	expect seeded is Ok(_)
	let _ <- runnerFigures.schedule("37 * * * *", nowMs())
	let r <- api.GET("/metrics/runners", RunnerQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	expect m.longest.map((l) => l.wait_seconds) == [36, 35, 34, 33, 32, 31, 30, 29, 28, 27]
	expect m.slowest.map(
		(j) => j.p50_seconds.getOrElse(0)
	) == [120, 110, 100, 90, 80, 70, 60, 50, 40, 30]
}

--- accuser, a maintainer: GitHub's kept answer, so the maintainer routes need no GitHub stub.
fn keptMaintainer() -> SqlStatement {
	SqlStatement {
		sql: "INSERT INTO org_members (org, login, member, checked_at) VALUES ('bynk-lang', 'accuser', 1, '2026-11-06T00:00:00.000Z')",
		params: [],
	}
}

case "a maintainer's runner figures include private and excluded repositories; the public's never do" {
	let seeded <- Deliveries.batch(seed().concat([keptMaintainer()]))
	expect seeded is Ok(_)
	let _ <- runnerFigures.schedule("37 * * * *", nowMs())
	let public0 <- api.GET(
		"/metrics/runners",
		RunnerQuery {
			repo: None,
			days: 7,
		},
		viewer()
	) by Visitor
	let mine0 <- api.POST("/maintainers/metrics/runners", RunnerQuery {
		repo: None,
		days: 7,
	}) by Maintainer("accuser")
	let Ok(p0) = public0 else {
		expect false
	}
	let Ok(m0) = mine0 else {
		expect false
	}
	// /metrics/runners: the public never see the private or excluded repository; a maintainer sees both.
	let pt0 = Json.encode(p0)
	let mt0 = Json.encode(m0)
	expect !pt0.contains("bynk-lang/secret") && !pt0.contains("bynk-lang/sandbox")
	expect mt0.contains("bynk-lang/secret") && mt0.contains("bynk-lang/sandbox")
	expect mt0.contains("bynk-lang/bynk")
	let public1 <- api.GET("/metrics/runners/now", NowQuery { repo: None }, viewer()) by Visitor
	let mine1 <- api.POST(
		"/maintainers/metrics/runners/now",
		NowQuery { repo: None }
	) by Maintainer("accuser")
	let Ok(p1) = public1 else {
		expect false
	}
	let Ok(m1) = mine1 else {
		expect false
	}
	// /metrics/runners/now: the public never see the private or excluded repository; a maintainer sees both.
	let pt1 = Json.encode(p1)
	let mt1 = Json.encode(m1)
	expect !pt1.contains("bynk-lang/secret") && !pt1.contains("bynk-lang/sandbox")
	// The seed has nothing from the excluded repository here; the other route covers it.
	expect mt1.contains("bynk-lang/secret")
	expect mt1.contains("bynk-lang/bynk")
}

case "two workflows of one name keep their own slowest jobs, told apart by their files (#62)" {
	let seeded <- Deliveries.batch(
		[
			SqlStatement {
				sql: "INSERT INTO repositories (repo, public, default_branch) VALUES ('bynk-lang/bynk', 1, 'main')",
				params: [],
			},
			SqlStatement {
				sql: """
					INSERT INTO workflow_runs (repo, run_id, attempt, workflow, path, branch, sha, event, status, conclusion,
					                           created_at, queued_at, started_at, completed_at, updated_at) VALUES
					  ('bynk-lang/bynk', 101, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a', 'push', 'completed', 'success', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:30:00.000Z', '2026-11-04T09:30:00.000Z'),
					  ('bynk-lang/bynk', 102, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a', 'push', 'completed', 'success', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:30:00.000Z', '2026-11-04T09:30:00.000Z'),
					  ('bynk-lang/bynk', 103, 1, 'CI', '.github/workflows/ci.yml', 'main', 'a', 'push', 'completed', 'success', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:30:00.000Z', '2026-11-04T09:30:00.000Z'),
					  ('bynk-lang/bynk', 104, 1, 'CI', '.github/workflows/nightly.yml', 'main', 'a', 'push', 'completed', 'success', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:30:00.000Z', '2026-11-04T09:30:00.000Z'),
					  ('bynk-lang/bynk', 105, 1, 'CI', '.github/workflows/nightly.yml', 'main', 'a', 'push', 'completed', 'success', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:30:00.000Z', '2026-11-04T09:30:00.000Z'),
					  ('bynk-lang/bynk', 106, 1, 'CI', '.github/workflows/nightly.yml', 'main', 'a', 'push', 'completed', 'success', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:00.000Z', '2026-11-04T09:30:00.000Z', '2026-11-04T09:30:00.000Z')
				""",
				params: [],
			},
			SqlStatement {
				sql: """
					INSERT INTO workflow_jobs (job_id, repo, run_id, attempt, workflow, name, runner, runner_group, status,
					                           conclusion, created_at, started_at, completed_at, approval, path) VALUES
					  (200, 'bynk-lang/bynk', 101, 1, 'CI', 'Build', 'ubuntu-latest', NULL, 'completed', 'success', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:01:00.000Z', 0, '.github/workflows/ci.yml'),
					  (201, 'bynk-lang/bynk', 102, 1, 'CI', 'Build', 'ubuntu-latest', NULL, 'completed', 'success', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:01:00.000Z', 0, '.github/workflows/ci.yml'),
					  (202, 'bynk-lang/bynk', 103, 1, 'CI', 'Build', 'ubuntu-latest', NULL, 'completed', 'success', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:01:00.000Z', 0, '.github/workflows/ci.yml'),
					  (203, 'bynk-lang/bynk', 104, 1, 'CI', 'Build', 'ubuntu-latest', NULL, 'completed', 'success', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:01:00.000Z', 0, '.github/workflows/nightly.yml'),
					  (204, 'bynk-lang/bynk', 105, 1, 'CI', 'Build', 'ubuntu-latest', NULL, 'completed', 'success', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:10:00.000Z', 0, '.github/workflows/nightly.yml'),
					  (205, 'bynk-lang/bynk', 106, 1, 'CI', 'Build', 'ubuntu-latest', NULL, 'completed', 'success', '2026-11-04T10:00:00.000Z', '2026-11-04T10:00:00.000Z', '2026-11-04T10:10:00.000Z', 0, '.github/workflows/nightly.yml')
				""",
				params: [],
			},
		]
	)
	expect seeded is Ok(_)
	let _ <- runnerFigures.schedule("37 * * * *", nowMs())
	let r <- api.GET("/metrics/runners", RunnerQuery { repo: None, days: 7 }, viewer()) by Visitor
	let Ok(m) = r else {
		expect false
	}
	// Both are "CI / Build", but one is the nightly run's ten-minute build. One
	// nightly build took a minute, as every CI one did: it's still the nightly's.
	expect m.slowest.map(
		(j) => "\(j.path.getOrElse("-")) \(j.name) \(j.p50_seconds.getOrElse(0)) x\(j.runs)"
	) == [".github/workflows/nightly.yml Build 600 x3", ".github/workflows/ci.yml Build 60 x3"]
}
