// Phase 4, slice 4, step 2 (#42): the runner-wait figures, computed hourly by
// the `runnerFigures` cron, and the public routes that read them, against an
// in-memory D1 with the migrations applied and a hand-built set of jobs whose
// figures are worked out below. The clock, and the cron's time, are
// 2026-11-05T12:00:00Z, so the 7-day window opens at 2026-10-29T12:00:00Z and
// the 30-day one at 2026-10-06T12:00:00Z.
suite github.hooks

env {
	DASHBOARD_EXCLUDE = "bynk-lang/sandbox"
}

stub Clock.now() returns Instant.fromEpochMillis(1793880000000)

--- 2026-11-05T12:00:00Z, the cron's time, in epoch milliseconds.
fn nowMs() -> Int {
	1793880000000
}

--- A viewer's request headers: one address, well within the limit.
fn viewer() -> RequestHeaders {
	RequestHeaders.of(["CF-Connecting-IP: 203.0.113.7"])
}

---
`bynk-lang/bynk`'s jobs. In the week, self-hosted jobs waited 60 s (Test
suite, ran 1,200 s), 120 s (Test suite, 1,500 s) and 600 s (Docs, failed):
jobs 3, p50 120, p95 600, longest 600. Ubuntu jobs waited 3 s and 5 s (Lint,
ran 60 s and 90 s): p50 3, p95 5. A Deploy job waited 2 hours for an
approval and ran 100 s: its wait isn't counted, its duration is. Not counted
at all: a skipped job, one cancelled before a runner took it, and one from
July. On macOS, a Test suite waited 10 s and ran 1,400 s, and a Lint waited
20 s and ran 75 s: p50 10, p95 20. So the week's Test suite times are
[1,200, 1,400, 1,500] (p50 1,400) and Lint's [60, 75, 90] (p50 75); Deploy,
with one run, is too few to rank. 20 days ago a self-hosted Test suite waited
900 s and ran 1,300 s, so the 30-day window's self-hosted waits are [60, 120,
600, 900] (p50 120, p95 900) and its Test suite times [1,200, 1,300, 1,400,
1,500] (p50 1,300, p95 1,500).

Waiting now: two Ubuntu jobs queued (since 11:50 and 11:58), a self-hosted
job held for approval since 11:30, and a self-hosted job queued on 3
November, too long ago to still be waiting. The private and excluded
repositories' jobs are computed but never shown.
---
fn seed() -> List[SqlStatement] {
	[
		SqlStatement {
			sql: """
				INSERT INTO repositories (repo, public, default_branch) VALUES
				  ('bynk-lang/bynk', 1, 'main'), ('bynk-lang/secret', 0, 'main'), ('bynk-lang/sandbox', 1, 'main')
			""",
			params: [],
		},
		SqlStatement {
			sql: """
				INSERT INTO workflow_jobs (job_id, repo, run_id, attempt, workflow, name, runner, runner_group, status,
				                           conclusion, created_at, started_at, completed_at, approval) VALUES
				  (1, 'bynk-lang/bynk', 1, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'success',
				   '2026-11-04T10:00:00.000Z', '2026-11-04T10:01:00.000Z', '2026-11-04T10:21:00.000Z', 0),
				  (2, 'bynk-lang/bynk', 2, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'success',
				   '2026-11-03T10:00:00.000Z', '2026-11-03T10:02:00.000Z', '2026-11-03T10:27:00.000Z', 0),
				  (3, 'bynk-lang/bynk', 3, 1, 'CI', 'Docs', 'self-hosted', 'default', 'completed', 'failure',
				   '2026-11-02T10:00:00.000Z', '2026-11-02T10:10:00.000Z', '2026-11-02T10:15:00.000Z', 0),
				  (4, 'bynk-lang/bynk', 4, 1, 'CI', 'Lint', 'ubuntu-latest', 'GitHub Actions', 'completed', 'success',
				   '2026-11-04T09:00:00.000Z', '2026-11-04T09:00:03.000Z', '2026-11-04T09:01:03.000Z', 0),
				  (5, 'bynk-lang/bynk', 5, 1, 'CI', 'Lint', 'ubuntu-latest', 'GitHub Actions', 'completed', 'success',
				   '2026-11-01T09:00:00.000Z', '2026-11-01T09:00:05.000Z', '2026-11-01T09:01:35.000Z', 0),
				  (6, 'bynk-lang/bynk', 6, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'success',
				   '2026-10-16T10:00:00.000Z', '2026-10-16T10:15:00.000Z', '2026-10-16T10:36:40.000Z', 0),
				  (7, 'bynk-lang/bynk', 7, 1, 'Release', 'Deploy', 'self-hosted', 'default', 'completed', 'success',
