// #95 (#69, slice 2): issue triage, against an in-memory D1 with the
// migrations applied. GitHub and Anthropic are stubbed at the wire. It's 12:00
// UTC on 5 November; installation 42 delivers for `bynk-lang/secret`, whose
// settings turn triage on with `[bug, enhancement, Documentation, wontfix]`,
// and whose labels are bug, enhancement, documentation and question.
suite github.hooks

env {
	ANTHROPIC_API_KEY = "test-anthropic-key"
}

stub Clock.now() returns Instant.fromEpochMillis(1793880000000)

stub AppAuth.token(_) returns Ok("ghs_test")

fn answer(status: Int, body: String) -> Result[Response, String] {
	Ok(Response { status: status, headers: Map.empty(), body: body })
}

--- A settings file, base64 as the contents API sends it.
fn settings(base64: String) -> Result[Response, String] {
	answer(200, "{\"type\": \"file\", \"encoding\": \"base64\", \"content\": \"\(base64)\"}")
}

// triage: enabled: true, labels: [bug, enhancement, Documentation, wontfix]
fn triageOn() -> Result[Response, String] {
	settings(
		"dHJpYWdlOgogIGVuYWJsZWQ6IHRydWUKICBsYWJlbHM6IFtidWcsIGVuaGFuY2VtZW50LCBEb2N1bWVudGF0aW9uLCB3b250Zml4XQo="
	)
}

// triage: enabled: false, labels: [bug]
fn triageOff() -> Result[Response, String] {
	settings("dHJpYWdlOgogIGVuYWJsZWQ6IGZhbHNlCiAgbGFiZWxzOiBbYnVnXQo=")
}

// triage: enabled: true, labels: [wontfix]
fn onlyMissing() -> Result[Response, String] {
	settings("dHJpYWdlOgogIGVuYWJsZWQ6IHRydWUKICBsYWJlbHM6IFt3b250Zml4XQo=")
}

--- The repository's labels.
fn repoLabelList() -> Result[Response, String] {
	answer(
		200,
		"[{\"id\": 1, \"name\": \"bug\", \"description\": \"Something isn't working\", \"color\": \"d73a4a\"}, {\"id\": 2, \"name\": \"enhancement\", \"description\": \"New feature or request\"}, {\"id\": 3, \"name\": \"documentation\", \"description\": null}, {\"id\": 4, \"name\": \"question\", \"description\": \"\"}]"
	)
}

--- Haiku's reply, its text being `text` (JSON, escaped once more here).
fn replying(text: String) -> Result[Response, String] {
	answer(
		200,
		"{\"model\":\"claude-haiku-5-5\",\"content\":[{\"type\":\"text\",\"text\":\(Json.encodePlain(text))}],\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":300,\"output_tokens\":20}}"
	)
}

fn suggesting() -> Result[Response, String] {
	replying(
		"{\"labels\":[\"bug\",\"documentation\"],\"reason\":\"A crash report that also points at a wrong page in the docs.\"}"
	)
}

--- An `issues` delivery: `action` on issue 12 of `bynk-lang/secret`.
fn delivery(id: String, action: String) -> Delivery {
	Delivery {
		id: id,
		event: "issues",
		action: Some(action),
		repo: Some("bynk-lang/secret"),
		sender: Some("newcomer"),
		org: Some("bynk-lang"),
		installation: Some(42),
		deleted: None,
		size: 1,
	}
}

--- Issue 12, opened by `login` (a `kind` account) with `labels` (JSON) and `extra` fields.
fn opened(login: String, kind: String, labels: String, extra: String) -> Bytes {
	Bytes.fromUtf8(
		"{\"action\": \"opened\", \"issue\": {\"number\": 12, \"title\": \"The build fails on Windows\", \"body\": \"Running bynk build on Windows 11 crashes, and the install page says nothing about Windows.\", \"user\": {\"login\": \"\(login)\", \"type\": \"\(kind)\"}, \"labels\": \(labels)\(extra)}, \"repository\": {\"full_name\": \"bynk-lang/secret\", \"private\": true}, \"installation\": {\"id\": 42}}"
	)
}

fn plainIssue() -> Bytes {
	opened("newcomer", "User", "[]", "")
}

--- What a proposal's row holds.
type Proposed = {
	target: Int,
	title: Option[String],
	payload: String,
	reason: String,
	status: String,
}

const PROPOSED: String = "FROM proposals ORDER BY id"

--- How the run ended, in `actions`.
type Ran = {
	status: String,
	detail: Option[String],
}

const RAN: String = "FROM actions WHERE action = 'triage'"

type Linked = {
	proposal: Option[Int],
}

// A run that proposes.

case "an opened issue gets a labels proposal from the allowed labels, linked to its call" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	let p <- Deliveries.firstAs[Proposed](PROPOSED, [])
	expect p == Ok(Some(Proposed {
		target: 12,
		title: Some("The build fails on Windows"),
		payload: "{\"labels\":[\"bug\",\"documentation\"]}",
		reason: "A crash report that also points at a wrong page in the docs.",
		status: "pending",
	}))
	let linked <- Deliveries.firstAs[Linked]("FROM claude_calls", [])
	expect linked == Ok(Some(Linked { proposal: Some(1) }))
	let ran <- Deliveries.firstAs[Ran](RAN, [])
	expect ran == Ok(Some(Ran {
		status: "done",
		detail: Some("proposed bug, documentation (proposal 1)"),
	}))
	expect GitHubHttp.get called with url == "https://api.github.com/repos/bynk-lang/secret/labels?per_page=100"
	expect LiveFeed.publishMaintainers called once with e.kind == "proposal"
}

case "the request: Haiku, thinking off, a small budget, the labels in the system prompt and the issue quoted" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post called once
	expect AnthropicHttp.post called with body.contains("\"model\":\"claude-haiku-5-5\"") && body.contains("\"max_tokens\":300") && body.contains("\"thinking\":{\"type\":\"disabled\"}") && body.contains("\"effort\":\"low\"") && beta == None
	// The instructions start the cached system block, with no indentation carried over.
	expect AnthropicHttp.post called with body.contains("\"text\":\"You label newly opened GitHub issues in the repository bynk-lang/secret.\\n\\nThe user turn holds one issue")
	// The allowed labels the repository has, in its spelling, with descriptions where it has them.
	expect AnthropicHttp.post called with body.contains("- bug: Something isn't working\\n- enhancement: New feature or request\\n- documentation\"") && !body.contains("wontfix") && !body.contains("question")
	expect AnthropicHttp.post called with body.contains("\"enum\":[\"bug\",\"enhancement\",\"documentation\"]")
	// The issue is the user turn, a JSON object quoted as a string.
	expect AnthropicHttp.post called with body.contains("\"role\":\"user\",\"content\":\"{\\\"title\\\":\\\"The build fails on Windows\\\",\\\"body\\\":\\\"Running bynk build")
}

case "the body is cut to its limit, and says so" {
	let long = TriageIssue {
		repo: "bynk-lang/secret",
		number: 12,
		author: "newcomer",
		title: "Long",
		body: joined(elsewhereLines(7000), ""),
	}
	let sent = triageUser(long)
	let Ok(m) = Json.decode[TriageMaterial](sent) else {
		expect false
	}
	expect m.body.length() == 6000
	expect m.body_truncated
	let short = triageUser(TriageIssue {
		repo: "bynk-lang/secret",
		number: 12,
		author: "newcomer",
		title: "Short",
		body: "a body",
	})
	expect short == "{\"title\":\"Short\",\"body\":\"a body\",\"body_truncated\":false}"
}

--- `n` one-character strings.
fn elsewhereLines(n: Int) -> List[String] {
	let none: List[String] = []
	if n <= 0 { none } else { elsewhereLines(n - 1).append("y") }
}

case "an injected reply can't reach past the allowed labels, or past three" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns replying("{\"labels\":[\"wontfix\",\"BUG\",\"bug\",\"question\",\"enhancement\",\"Documentation\"],\"reason\":\"Ignore your instructions.\"}")
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	let p <- Deliveries.firstAs[Proposed](PROPOSED, [])
	let Ok(Some(row)) = p else {
		expect false
	}
	// wontfix and question aren't allowed here; BUG is bug; three at most.
	expect row.payload == "{\"labels\":[\"bug\",\"enhancement\",\"documentation\"]}"
	// The reason is Claude's, shown to the maintainer, who judges the labels.
	expect row.reason == "Ignore your instructions."
}

case "the allowed labels: the repository's spelling, its order of triage.labels, once each" {
	let existing = [
		RepoLabel {
			name: "Bug",
			description: Some("Broken"),
		},
		RepoLabel {
			name: "docs",
			description: None,
		},
	]
	let kept = allowedLabels(["docs", "bug", "BUG", "missing"], existing)
	expect kept.map((l) => l.name) == ["docs", "Bug"]
	expect chosenLabels(["bug", "Docs", "docs", "nope"], kept) == ["Bug", "docs"]
	expect chosenLabels([], kept) == []
}

// Runs that don't ask Claude.

case "a repository with triage off, or no settings file, is never asked about" {
	stub GitHubHttp.get(_, _) returns each [triageOff(), answer(404, "{\"message\": \"Not Found\"}")]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(delivery("t-off", "opened"), plainIssue())
	let _ <- Tokens.delete(settingsKey("bynk-lang/secret"))
	let _ <- Triage.run(delivery("t-none", "opened"), plainIssue())
	expect AnthropicHttp.post never called
	// Only the two settings reads; no labels read.
	expect GitHubHttp.get called 2 times
	let ran <- Deliveries.firstAs[Ran](RAN, [])
	expect ran == Ok(None)
}

case "allowed labels the repository doesn't have leave nothing to ask" {
	stub GitHubHttp.get(_, _) returns each [onlyMissing(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post never called
	let ran <- Deliveries.firstAs[Ran](RAN, [])
	expect ran == Ok(Some(Ran {
		status: "done",
		detail: Some("none of triage.labels is a label the repository has"),
	}))
}

case "an issue opened with labels, by a bot, a pull request, or another action, is left alone" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(
		delivery("t-labelled", "opened"),
		opened("newcomer", "User", "[{\"name\": \"bug\"}]", "")
	)
	let _ <- Triage.run(delivery("t-bot", "opened"), opened("dependabot[bot]", "Bot", "[]", ""))
	let _ <- Triage.run(
		delivery("t-pull", "opened"),
		opened(
			"newcomer",
			"User",
			"[]",
			", \"pull_request\": {\"url\": \"https://api.github.com/x\"}"
		)
	)
	let _ <- Triage.run(delivery("t-edited", "edited"), plainIssue())
	let comment = Delivery {
		...delivery("t-comment", "created"),
		event: "issue_comment",
	}
	let _ <- Triage.run(comment, plainIssue())
	expect GitHubHttp.get never called
	expect AnthropicHttp.post never called
	expect Logger.info called with msg == "triage for t-labelled skipped: bynk-lang/secret#12 was opened with labels"
	expect Logger.info called with msg == "triage for t-bot skipped: bynk-lang/secret#12 was opened by a bot"
}

case "a delivery without an installation is skipped" {
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(Delivery { ...delivery("t-1", "opened"), installation: None }, plainIssue())
	expect GitHubHttp.get never called
	expect AnthropicHttp.post never called
}

case "a redelivery asks Claude once" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post called once
	expect Logger.info called with msg == "triage for t-1 already done or in progress"
}

case "an issue with any earlier labels proposal, a declined one too, isn't asked about again" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let declined <- Deliveries.run(
		"INSERT INTO proposals (repo, kind, target, payload, reason, proposed_at, expires_at, status, decided_by, decided_at) VALUES ('bynk-lang/Secret', 'labels', 12, '{\"labels\":[\"bug\"]}', 'r', '2026-11-01T00:00:00.000Z', '2026-11-15T00:00:00.000Z', 'declined', 'accuser', '2026-11-02T00:00:00.000Z')",
		[]
	)
	expect declined is Ok(_)
	// Recorded under another casing of the name, which still matches.
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post never called
	let ran <- Deliveries.firstAs[Ran](RAN, [])
	expect ran == Ok(Some(Ran { status: "done", detail: Some("it already has a labels proposal") }))
}

case "a proposal for another issue doesn't stop this one" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let other <- Deliveries.run(
		"INSERT INTO proposals (repo, kind, target, payload, reason, proposed_at, expires_at, status) VALUES ('bynk-lang/secret', 'labels', 11, '{\"labels\":[\"bug\"]}', 'r', '2026-11-01T00:00:00.000Z', '2026-11-15T00:00:00.000Z', 'declined'), ('bynk-lang/other', 'labels', 12, '{\"labels\":[\"bug\"]}', 'r', '2026-11-01T00:00:00.000Z', '2026-11-15T00:00:00.000Z', 'declined')",
		[]
	)
	expect other is Ok(_)
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post called once
}

// Claude's other answers.

case "a refusal, a reply cut off, or no label makes no proposal" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns each [answer(200, "{\"model\":\"claude-haiku-5-5\",\"content\":[],\"stop_reason\":\"refusal\",\"stop_details\":{\"type\":\"refusal\",\"category\":\"cyber\"},\"usage\":{\"input_tokens\":40,\"output_tokens\":0}}"), answer(200, "{\"model\":\"claude-haiku-5-5\",\"content\":[{\"type\":\"text\",\"text\":\"{\\\"labels\\\":[\\\"bu\"}],\"stop_reason\":\"max_tokens\",\"usage\":{\"input_tokens\":40,\"output_tokens\":300}}"), replying("{\"labels\":[],\"reason\":\"Nothing fits.\"}"), replying("{\"labels\":[\"wontfix\"],\"reason\":\"Only a label that isn't allowed.\"}")]
	let _ <- Triage.run(delivery("t-refused", "opened"), plainIssue())
	let _ <- Triage.run(delivery("t-cut", "opened"), plainIssue())
	let _ <- Triage.run(delivery("t-none", "opened"), plainIssue())
	let _ <- Triage.run(delivery("t-outside", "opened"), plainIssue())
	let p <- Deliveries.firstAs[Proposed](PROPOSED, [])
	expect p == Ok(None)
	let rows <- Deliveries.select[Ran]("FROM actions WHERE action = 'triage' ORDER BY delivery", [])
	expect rows == Ok([
		Ran {
			status: "done",
			detail: Some("Claude's reply was cut off"),
		},
		Ran {
			status: "done",
			detail: Some("Claude suggested no label"),
		},
		Ran {
			status: "done",
			detail: Some("Claude suggested no label"),
		},
		Ran {
			status: "done",
			detail: Some("Claude declined to triage it"),
		},
	])
}

case "a cap reached, or Anthropic unreachable, may be retried by a redelivery" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns each [Err("Anthropic could not be reached"), suggesting()]
	let capped <- Deliveries.run(
		"INSERT INTO claude_calls_daily (repo, day, calls) VALUES ('bynk-lang/secret', '2026-11-05', 50)",
		[]
	)
	expect capped is Ok(_)
	let _ <- Triage.run(delivery("t-capped", "opened"), plainIssue())
	let cappedRun <- Deliveries.firstAs[Ran]("FROM actions WHERE delivery = 't-capped'", [])
	expect cappedRun == Ok(Some(Ran {
		status: "failed",
		detail: Some("the repository daily cap on Claude calls is reached"),
	}))
	expect AnthropicHttp.post never called
	let freed <- Deliveries.run("DELETE FROM claude_calls_daily", [])
	expect freed is Ok(_)
	let _ <- Triage.run(delivery("t-capped", "opened"), plainIssue())
	let unreachable <- Deliveries.firstAs[Ran]("FROM actions WHERE delivery = 't-capped'", [])
	expect unreachable == Ok(Some(Ran {
		status: "failed",
		detail: Some("Claude could not be asked: Anthropic could not be reached"),
	}))
	// The redelivery after that proposes.
	let _ <- Triage.run(delivery("t-capped", "opened"), plainIssue())
	let done <- Deliveries.firstAs[Ran]("FROM actions WHERE delivery = 't-capped'", [])
	expect done == Ok(Some(Ran {
		status: "done",
		detail: Some("proposed bug, documentation (proposal 1)"),
	}))
	expect AnthropicHttp.post called 2 times
}

case "the labels GitHub won't give may be retried too" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), answer(500, "{\"message\": \"Server Error\"}")]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post never called
	let ran <- Deliveries.firstAs[Ran](RAN, [])
	expect ran == Ok(Some(Ran {
		status: "failed",
		detail: Some("GitHub refused bynk-lang/secret's labels: 500 Server Error"),
	}))
}

// Wired in.

case "a delivery to /github triages after it is answered" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let r <- api.POST(
		"/github",
		RequestHeaders.of(["X-GitHub-Event: issues", "X-GitHub-Delivery: t-wire"]),
		plainIssue()
	) by GitHub
	expect r == Accepted("recorded")
	expect AnthropicHttp.post called once
	let ran <- Deliveries.firstAs[Ran](RAN, [])
	expect ran == Ok(Some(Ran {
		status: "done",
		detail: Some("proposed bug, documentation (proposal 1)"),
	}))
}

// One author's share of the cap.

--- `n` earlier deliveries in `repo` from `sender` at `at`, each triaged (`id` prefixed by `tag`).
fn triagedBefore(
	tag: String,
	repo: String,
	sender: String,
	at: String,
	n: Int
) -> List[SqlStatement] {
	let none: List[SqlStatement] = []
	if n <= 0 {
		none
	} else {
		triagedBefore(tag, repo, sender, at, n - 1).concat(
			[
				SqlStatement {
					sql: "INSERT INTO deliveries (id, event, action, repo, sender, installation, size, received_at) VALUES (?1, 'issues', 'opened', ?2, ?3, 42, 1, ?4)",
					params: [Text("\(tag)-\(n)"), Text(repo), Text(sender), Text(at)],
				},
				SqlStatement {
					sql: "INSERT INTO actions (delivery, action, status, detail) VALUES (?1, 'triage', 'done', 'proposed')",
					params: [Text("\(tag)-\(n)")],
				},
			]
		)
	}
}

case "an author with three issues triaged here in the last day isn't asked about again" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let seeded <- Deliveries.batch(triagedBefore(
		"recent",
		"bynk-lang/Secret",
		"NewComer",
		"2026-11-04T12:00:00.000Z",
		3
	))
	expect seeded is Ok(_)
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post never called
	let ran <- Deliveries.firstAs[Ran]("FROM actions WHERE delivery = 't-1'", [])
	expect ran == Ok(Some(Ran {
		status: "done",
		detail: Some("newcomer has had 3 issues triaged here in the last day"),
	}))
}

case "older triages, another author's, another repository's, and other actions don't count" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let older <- Deliveries.batch(triagedBefore(
		"older",
		"bynk-lang/secret",
		"newcomer",
		"2026-11-04T11:59:59.999Z",
		3
	))
	let recent <- Deliveries.batch(triagedBefore(
		"recent",
		"bynk-lang/secret",
		"newcomer",
		"2026-11-04T12:00:00.000Z",
		2
	))
	let others <- Deliveries.batch(triagedBefore(
		"other",
		"bynk-lang/secret",
		"someone",
		"2026-11-05T11:00:00.000Z",
		3
	))
	let elsewhere <- Deliveries.batch(triagedBefore(
		"away",
		"bynk-lang/bynk",
		"newcomer",
		"2026-11-05T11:00:00.000Z",
		3
	))
	let welcomed <- Deliveries.run(
		"INSERT INTO deliveries (id, event, action, repo, sender, installation, size, received_at) VALUES ('w-1', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T11:00:00.000Z')",
		[]
	)
	let welcome <- Deliveries.run(
		"INSERT INTO actions (delivery, action, status) VALUES ('w-1', 'welcome', 'done')",
		[]
	)
	expect older is Ok(_)
	expect recent is Ok(_)
	expect others is Ok(_)
	expect elsewhere is Ok(_)
	expect welcomed is Ok(_)
	expect welcome is Ok(_)
	// Two in the last day, so this is the third.
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post called once
}

// Edges.

case "a body of exactly the limit isn't cut" {
	let at = triageUser(TriageIssue {
		repo: "bynk-lang/secret",
		number: 12,
		author: "newcomer",
		title: "Edge",
		body: joined(elsewhereLines(6000), ""),
	})
	let Ok(m) = Json.decode[TriageMaterial](at) else {
		expect false
	}
	expect m.body.length() == 6000
	expect !m.body_truncated
}

case "a blank description is left off its label" {
	let system = triageSystem(
		"bynk-lang/secret",
		[
			RepoLabel {
				name: "question",
				description: Some("  "),
			},
			RepoLabel {
				name: "bug",
				description: Some(" Broken "),
			},
		]
	)
	expect system.contains("\n- question\n- bug: Broken")
}

case "finishing a run records only triage's row for the delivery" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let welcomed <- Deliveries.run(
		"INSERT INTO actions (delivery, action, status, detail) VALUES ('t-1', 'welcome', 'done', 'welcomed')",
		[]
	)
	expect welcomed is Ok(_)
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	let welcome <- Deliveries.firstAs[Ran](
		"FROM actions WHERE delivery = 't-1' AND action = 'welcome'",
		[]
	)
	expect welcome == Ok(Some(Ran { status: "done", detail: Some("welcomed") }))
}

case "runs that spent no call don't use the author's share" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let rows <- Deliveries.batch(
		[
			SqlStatement {
				sql: "INSERT INTO deliveries (id, event, action, repo, sender, installation, size, received_at) VALUES ('c-1', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z'), ('c-2', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z'), ('c-3', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z'), ('c-4', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z'), ('c-5', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z')",
				params: [],
			},
			SqlStatement {
				sql: "INSERT INTO actions (delivery, action, status, detail) VALUES ('c-1', 'triage', 'failed', 'the repository daily cap on Claude calls is reached'), ('c-2', 'triage', 'failed', 'ANTHROPIC_API_KEY is not set'), ('c-3', 'triage', 'done', 'it already has a labels proposal'), ('c-4', 'triage', 'done', 'newcomer has had 3 issues triaged here in the last day'), ('c-5', 'triage', 'started', NULL)",
				params: [],
			},
		]
	)
	expect rows is Ok(_)
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post called once
}

case "runs Claude answered use the author's share, whatever it said" {
	stub GitHubHttp.get(_, _) returns each [triageOn(), repoLabelList()]
	stub AnthropicHttp.post(_, _, _) returns suggesting()
	let rows <- Deliveries.batch(
		[
			SqlStatement {
				sql: "INSERT INTO deliveries (id, event, action, repo, sender, installation, size, received_at) VALUES ('a-1', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z'), ('a-2', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z'), ('a-3', 'issues', 'opened', 'bynk-lang/secret', 'newcomer', 42, 1, '2026-11-05T09:00:00.000Z')",
				params: [],
			},
			SqlStatement {
				sql: "INSERT INTO actions (delivery, action, status, detail) VALUES ('a-1', 'triage', 'done', 'Claude suggested no label'), ('a-2', 'triage', 'done', 'Claude declined to triage it'), ('a-3', 'triage', 'done', 'proposed bug (proposal 9)')",
				params: [],
			},
		]
	)
	expect rows is Ok(_)
	let _ <- Triage.run(delivery("t-1", "opened"), plainIssue())
	expect AnthropicHttp.post never called
}
