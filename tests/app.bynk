// The GitHub App's JWT, and the RSA key path.
//
// TEST-ONLY KEY: the RSA private key below was generated for these tests with
// `openssl genpkey`, has never belonged to any GitHub App, and grants nothing.
// The same key (and its public half) is in tests/bot.bynk; rotate both
// together. It stays inline because tests/bot.bynk needs it in an `env`
// value, which must be a `String` literal; a fixture would be a third copy.
suite github.app

case "the signing input is a JWT header and claims, base64url" {
	let input = jwtSigningInput("Iv1.testclient", Instant.fromEpochMillis(1700000000000))
	let parts = input.split(".")
	expect parts.length() == 2
	let Some(header) = parts
		.get(0)
		.andThen((h) => Bytes.fromBase64Url(h))
		.andThen((b) => b.decodeUtf8()) else {
		expect false
	}
	let Some(claims) = parts
		.get(1)
		.andThen((c) => Bytes.fromBase64Url(c))
		.andThen((b) => b.decodeUtf8()) else {
		expect false
	}
	expect header == "{\"alg\":\"RS256\",\"typ\":\"JWT\"}"
	let Ok(c) = Json.decode[JwtClaims](claims) else {
		expect false
	}
	expect c.iat == 1699999940
	expect c.exp == 1700000540
	expect c.iss == "Iv1.testclient"
}

case "a stored key reads with or without line breaks" {
	expect pkcs8(
		""
	).isSome()
	expect pkcs8(
		"MIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQCjTkIscmyAn4Iq\"
	).isSome()
	expect pkcs8("not base64!") == None
}

case "a refusal carries GitHub's message when there is one" {
	expect refusal(
		403,
		"{\"message\": \"Resource not accessible by integration\", \"documentation_url\": \"https://docs.github.com\"}"
	) == "403 Resource not accessible by integration"
	expect refusal(502, "<html>Bad gateway</html>") == "502"
	expect refusal(404, "") == "404"
}

case "a 422 refusal names its errors" {
	let body = """
	{ "message": "Validation Failed",
	  "errors": [ { "resource": "IssueComment", "code": "custom", "message": "Body is too long" },
	              { "resource": "IssueComment", "code": "unprocessable" } ] }
	"""
	expect refusal(422, body) == "422 Validation Failed (Body is too long; unprocessable)"
	expect refusal(
		422,
		"{\"message\": \"Validation Failed\", \"errors\": []}"
	) == "422 Validation Failed"
}
