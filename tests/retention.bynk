// Retention, against an in-memory D1 with the migrations applied. Each case
// runs the hourly job as if scheduled at 2026-11-05T00:00:00Z, so 90 days back
// is 2026-08-07 and 7 days back is 2026-10-29.
suite github.hooks

--- 2026-11-05T00:00:00Z, as the scheduled time in epoch milliseconds.
fn nowMs() -> Int {
	1793836800000
}

case "old deliveries and stale workflow-run progress go; the rest stays" {
	let _ <- Deliveries.run(
		"""
		INSERT INTO deliveries (id, event, action, repo, size, received_at) VALUES
		  ('old-push',       'push',         NULL,          'bynk-lang/bynk', 1, '2026-08-06T23:59:59.999Z'),
		  ('edge-push',      'push',         NULL,          'bynk-lang/bynk', 1, '2026-08-07T00:00:00.000Z'),
		  ('old-run-done',   'workflow_run', 'completed',   'bynk-lang/bynk', 1, '2026-08-01T00:00:00.000Z'),
		  ('run-requested',  'workflow_run', 'requested',   'bynk-lang/bynk', 1, '2026-10-20T00:00:00.000Z'),
		  ('run-progress',   'workflow_run', 'in_progress', 'bynk-lang/bynk', 1, '2026-10-28T23:59:59.999Z'),
		  ('run-done',       'workflow_run', 'completed',   'bynk-lang/bynk', 1, '2026-10-20T00:00:00.000Z'),
		  ('recent-running', 'workflow_run', 'in_progress', 'bynk-lang/bynk', 1, '2026-11-01T00:00:00.000Z'),
		  ('issue-opened',   'issues',       'opened',      'bynk-lang/bynk', 1, '2026-10-01T00:00:00.000Z')
		""",
		[]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	let kept <- Deliveries.all("SELECT id FROM deliveries ORDER BY id", [])
	expect kept == Ok("[{\"id\":\"edge-push\"},{\"id\":\"issue-opened\"},{\"id\":\"recent-running\"},{\"id\":\"run-done\"}]")
	expect Logger.info called once with msg == "retention removed 2 workflow-run progress and job deliveries, 2 deliveries and 0 actions"
}

case "old actions go, and who was welcomed is kept for good" {
	let _ <- Deliveries.run(
		"""
		INSERT INTO actions (delivery, action, status, at) VALUES
		  ('d-old', 'welcome', 'done', '2026-07-01T00:00:00.000Z'),
		  ('d-new', 'welcome', 'done', '2026-11-01T00:00:00.000Z')
		""",
		[]
	)
	let _ <- Deliveries.run(
		"INSERT INTO welcomed (repo, login, delivery, at) VALUES ('bynk-lang/bynk', 'newcomer', 'd-old', '2026-07-01T00:00:00.000Z')",
		[]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	let actions <- Deliveries.all("SELECT delivery FROM actions", [])
	expect actions == Ok("[{\"delivery\":\"d-new\"}]")
	let welcomed <- Deliveries.all("SELECT login FROM welcomed", [])
	expect welcomed == Ok("[{\"login\":\"newcomer\"}]")
	expect Logger.info called once with msg == "retention removed 0 workflow-run progress and job deliveries, 0 deliveries and 1 actions"
}

case "a run with nothing to remove logs nothing" {
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	expect Logger.info never called
}

case "a backlog is removed a batch at a time, oldest first" {
	// 5,001 workflow-run progress deliveries from June and 5,001 pushes from
	// July, one a second, all older than both cutoffs. The first run takes
	// 5,000 progress rows, then the 5,000 oldest of what's left past 90 days:
	// the last progress row and 4,999 pushes. Both limits are pinned.
	let _ <- Deliveries.run(
		"""
		INSERT INTO deliveries (id, event, action, size, received_at)
		WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i + 1 FROM n WHERE i < 5000)
		SELECT 'run-' || i, 'workflow_run', 'in_progress', 1, strftime('%Y-%m-%dT%H:%M:%fZ', '2026-06-01', '+' || i || ' seconds')
		FROM n
		""",
		[]
	)
	let _ <- Deliveries.run(
		"""
		INSERT INTO deliveries (id, event, size, received_at)
		WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i + 1 FROM n WHERE i < 5000)
		SELECT 'push-' || i, 'push', 1, strftime('%Y-%m-%dT%H:%M:%fZ', '2026-07-01', '+' || i || ' seconds')
		FROM n
		""",
		[]
	)
	let first <- retention.schedule("23 * * * *", nowMs())
	expect first is Ok(_)
	let left <- Deliveries.all("SELECT id FROM deliveries ORDER BY id", [])
	expect left == Ok("[{\"id\":\"push-4999\"},{\"id\":\"push-5000\"}]")
	expect Logger.info called once with msg == "retention removed 5000 workflow-run progress and job deliveries, 5000 deliveries and 0 actions; more remain for the next run"
	let second <- retention.schedule("23 * * * *", nowMs() + 3600000)
	expect second is Ok(_)
	let none <- Deliveries.all("SELECT id FROM deliveries", [])
	expect none == Ok("[]")
}

case "a full batch of workflow-run progress alone says more remain" {
	// 5,001 progress deliveries between the two cutoffs: past 7 days, inside 90.
	let _ <- Deliveries.run(
		"""
		INSERT INTO deliveries (id, event, action, size, received_at)
		WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i + 1 FROM n WHERE i < 5000)
		SELECT 'run-' || i, 'workflow_run', 'requested', 1, strftime('%Y-%m-%dT%H:%M:%fZ', '2026-10-01', '+' || i || ' seconds')
		FROM n
		""",
		[]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	expect Logger.info called once with msg == "retention removed 5000 workflow-run progress and job deliveries, 0 deliveries and 0 actions; more remain for the next run"
}

case "a failed delete is logged and is the run's error" {
	stub Deliveries.run(_, _) returns Err(Failed("database is locked"))
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Err("retention could not delete workflow-run progress and job deliveries: database is locked")
	expect Logger.error called once with msg == "retention could not delete workflow-run progress and job deliveries: database is locked"
}

case "job deliveries go after 7 days, whatever their action" {
	let _ <- Deliveries.run(
		"""
		INSERT INTO deliveries (id, event, action, repo, size, received_at) VALUES
		  ('job-done-old',   'workflow_job', 'completed', 'bynk-lang/bynk', 1, '2026-10-28T23:59:59.999Z'),
		  ('job-queued-old', 'workflow_job', 'queued',    'bynk-lang/bynk', 1, '2026-10-20T00:00:00.000Z'),
		  ('job-done-new',   'workflow_job', 'completed', 'bynk-lang/bynk', 1, '2026-10-29T00:00:00.000Z')
		""",
		[]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	let kept <- Deliveries.all("SELECT id FROM deliveries ORDER BY id", [])
	expect kept == Ok("[{\"id\":\"job-done-new\"}]")
}

---
Jobs from before the 90-day window (2026-08-07), and one inside it. On
5 August, `bynk-lang/bynk`'s self-hosted test job ran three times: queued 60 s
and ran 240 s (success); queued 600 s and failed after 120 s; and queued
30 s and ran 180 s (success). A fourth waited 2 hours for a protected
environment's approval and ran 180 s: it counts as a job and a success, but
its wait isn't a wait for a runner. A fifth was skipped, and counts nowhere.
So: 4 jobs, 1 failed, 1 gated, 3 waited, waits [30, 60, 600] summing 690
(p50 60, p95 600), 3 succeeded, durations [180, 180, 240] summing 600 (p50
180). One job on 6 August, and one on 8 August, which is kept.
---
fn jobs() -> SqlStatement {
	SqlStatement {
		sql: """
			INSERT INTO workflow_jobs (job_id, repo, run_id, attempt, workflow, name, runner, runner_group, status,
			                           conclusion, created_at, started_at, completed_at) VALUES
			  (1, 'bynk-lang/bynk', 1, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'success',
			   '2026-08-05T10:00:00.000Z', '2026-08-05T10:01:00.000Z', '2026-08-05T10:05:00.000Z'),
			  (2, 'bynk-lang/bynk', 2, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'failure',
			   '2026-08-05T11:00:00.000Z', '2026-08-05T11:10:00.000Z', '2026-08-05T11:12:00.000Z'),
			  (3, 'bynk-lang/bynk', 3, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'success',
			   '2026-08-05T23:59:00.000Z', '2026-08-05T23:59:30.000Z', '2026-08-06T00:02:30.000Z'),
			  (4, 'bynk-lang/bynk', 4, 1, 'CI', 'Test suite', 'self-hosted', NULL, 'completed', 'skipped',
			   '2026-08-05T12:00:00.000Z', '2026-08-05T12:00:00.000Z', '2026-08-05T12:00:00.000Z'),
			  (7, 'bynk-lang/bynk', 7, 1, 'CI', 'Test suite', 'self-hosted', 'default', 'completed', 'success',
			   '2026-08-05T13:00:00.000Z', '2026-08-05T15:00:00.000Z', '2026-08-05T15:03:00.000Z'),
			  (5, 'bynk-lang/bynk', 5, 1, 'CI', 'Lint', 'ubuntu-latest', 'GitHub Actions', 'completed', 'success',
			   '2026-08-06T09:00:00.000Z', '2026-08-06T09:00:05.000Z', '2026-08-06T09:01:05.000Z'),
			  (6, 'bynk-lang/bynk', 6, 1, 'CI', 'Lint', 'ubuntu-latest', 'GitHub Actions', 'completed', 'success',
			   '2026-08-08T09:00:00.000Z', '2026-08-08T09:00:05.000Z', '2026-08-08T09:01:05.000Z')
		""",
		params: [],
	}
}

case "the oldest day of jobs past 90 days is rolled up, then pruned, a day a run" {
	let seeded <- Deliveries.batch([
		jobs(),
		SqlStatement {
			sql: "UPDATE workflow_jobs SET approval = 1 WHERE job_id = 7",
			params: [],
		},
	])
	expect seeded is Ok(_)
	let first <- retention.schedule("23 * * * *", nowMs())
	expect first is Ok(_)
	expect Logger.info called with msg == "retention removed 0 workflow-run progress and job deliveries, 0 deliveries and 0 actions, and rolled up and pruned 5 jobs of 2026-08-05"
	let day <- Deliveries.all(
		"SELECT day, workflow, name, runner, jobs, failed, gated, waited, wait_sum_seconds, wait_p50_seconds, wait_p95_seconds, succeeded, duration_sum_seconds, duration_p50_seconds FROM workflow_job_days",
		[]
	)
	expect day == Ok("[{\"day\":\"2026-08-05\",\"workflow\":\"CI\",\"name\":\"Test suite\",\"runner\":\"self-hosted\",\"jobs\":4,\"failed\":1,\"gated\":1,\"waited\":3,\"wait_sum_seconds\":690,\"wait_p50_seconds\":60,\"wait_p95_seconds\":600,\"succeeded\":3,\"duration_sum_seconds\":600,\"duration_p50_seconds\":180}]")
	let left <- Deliveries.all("SELECT job_id FROM workflow_jobs ORDER BY job_id", [])
	expect left == Ok("[{\"job_id\":5},{\"job_id\":6}]")
	// The next run takes 6 August; 8 August is inside the window and stays.
	let second <- retention.schedule("23 * * * *", nowMs())
	expect second is Ok(_)
	let days <- Deliveries.first(
		"SELECT group_concat(day || ' ' || name || ' ' || jobs, ', ') AS days FROM (SELECT * FROM workflow_job_days ORDER BY day)",
		[]
	)
	expect days == Ok(Some("{\"days\":\"2026-08-05 Test suite 4, 2026-08-06 Lint 1\"}"))
	let kept <- Deliveries.all("SELECT job_id FROM workflow_jobs", [])
	expect kept == Ok("[{\"job_id\":6}]")
	let third <- retention.schedule("23 * * * *", nowMs())
	expect third is Ok(_)
	let still <- Deliveries.all("SELECT job_id FROM workflow_jobs", [])
	expect still == Ok("[{\"job_id\":6}]")
}

case "a day already rolled up keeps its rollup when a late job for it is pruned" {
	let seeded <- Deliveries.batch(
		[
			jobs(),
			SqlStatement {
				sql: """
					INSERT INTO workflow_job_days (repo, day, workflow, name, runner, jobs, failed, gated, waited, wait_sum_seconds,
					                               wait_p50_seconds, wait_p95_seconds, succeeded, duration_sum_seconds,
					                               duration_p50_seconds)
					VALUES ('bynk-lang/bynk', '2026-08-05', 'CI', 'Test suite', 'self-hosted', 9, 0, 0, 9, 90, 10, 10, 9, 900, 100)
				""",
				params: [],
			},
		]
	)
	expect seeded is Ok(_)
	let _ <- retention.schedule("23 * * * *", nowMs())
	let day <- Deliveries.first("SELECT jobs FROM workflow_job_days WHERE day = '2026-08-05'", [])
	expect day == Ok(Some("{\"jobs\":9}"))
	let left <- Deliveries.first(
		"SELECT count(*) AS n FROM workflow_jobs WHERE created_at < '2026-08-06'",
		[]
	)
	expect left == Ok(Some("{\"n\":0}"))
}

case "review-request tombstones older than a day go (#68)" {
	let _ <- Deliveries.run(
		"""
		INSERT INTO pull_request_review_tombstones (repo, number, reviewer, team, at) VALUES
		  ('bynk-lang/bynk', 1, 'a-person', 0, '2026-11-03T23:59:59.000Z'),
		  ('bynk-lang/bynk', 2, 'a-person', 0, '2026-11-04T12:00:00.000Z')
		""",
		[]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	let kept <- Deliveries.all(
		"SELECT number FROM pull_request_review_tombstones ORDER BY number",
		[]
	)
	expect kept == Ok("[{\"number\":2}]")
	expect Logger.info called once with msg == "retention removed 0 workflow-run progress and job deliveries, 0 deliveries and 0 actions, 1 review-request tombstones"
}

case "Claude calls go after 90 days, and the daily claims after a week (#88)" {
	let _ <- Deliveries.batch(
		[
			SqlStatement {
				sql: """
					INSERT INTO claude_calls (id, at, repo, feature, model, outcome) VALUES
					  (1, '2026-08-06T23:59:59.999Z', 'bynk-lang/bynk', 'triage', 'claude-haiku-5-5', 'answered'),
					  (2, '2026-08-07T00:00:00.000Z', 'bynk-lang/bynk', 'triage', 'claude-haiku-5-5', 'answered')
				""",
				params: [],
			},
			SqlStatement {
				sql: """
					INSERT INTO claude_calls_daily (repo, day, calls) VALUES
					  ('bynk-lang/bynk', '2026-10-28', 4),
					  ('bynk-lang/bynk', '2026-10-29', 2)
				""",
				params: [],
			},
		]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	let calls <- Deliveries.all("SELECT id FROM claude_calls ORDER BY id", [])
	expect calls == Ok("[{\"id\":2}]")
	let days <- Deliveries.all("SELECT day FROM claude_calls_daily ORDER BY day", [])
	expect days == Ok("[{\"day\":\"2026-10-29\"}]")
	expect Logger.info called once with msg == "retention removed 0 workflow-run progress and job deliveries, 0 deliveries and 0 actions, 1 Claude calls and 1 days of Claude claims"
}

case "a pending proposal past its wait expires, and decided ones go after 90 days (#88)" {
	let _ <- Deliveries.run(
		"""
		INSERT INTO proposals (id, repo, kind, target, payload, reason, proposed_at, expires_at, status, decided_at) VALUES
		  (1, 'bynk-lang/bynk', 'labels', 1, '{"labels":[]}', 'r', '2026-10-01T00:00:00.000Z', '2026-10-15T00:00:00.000Z', 'pending', NULL),
		  (2, 'bynk-lang/bynk', 'labels', 2, '{"labels":[]}', 'r', '2026-11-01T00:00:00.000Z', '2026-11-15T00:00:00.000Z', 'pending', NULL),
		  (3, 'bynk-lang/bynk', 'labels', 3, '{"labels":[]}', 'r', '2026-07-01T00:00:00.000Z', '2026-07-15T00:00:00.000Z', 'declined', '2026-08-06T23:59:59.999Z'),
		  (4, 'bynk-lang/bynk', 'labels', 4, '{"labels":[]}', 'r', '2026-07-01T00:00:00.000Z', '2026-07-15T00:00:00.000Z', 'approved', '2026-08-07T00:00:00.000Z')
		""",
		[]
	)
	let r <- retention.schedule("23 * * * *", nowMs())
	expect r is Ok(_)
	let left <- Deliveries.all("SELECT id, status FROM proposals ORDER BY id", [])
	expect left == Ok("[{\"id\":1,\"status\":\"expired\"},{\"id\":2,\"status\":\"pending\"},{\"id\":4,\"status\":\"approved\"}]")
	expect Logger.info called once with msg == "retention removed 0 workflow-run progress and job deliveries, 0 deliveries and 0 actions, 1 proposals expired and 1 decided ones removed"
}
