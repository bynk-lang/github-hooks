// These cases run the deployable Worker itself, so the generated signature
// check sees every request exactly as it would from GitHub.
suite github.hooks as system {
	env {
		APP_WEBHOOK_SECRET = "test-webhook-secret"
		API_TOKEN_SECRET = "test-api-secret"
	}

	case "a signed delivery is accepted" {
		let h = RequestHeaders.of(["X-GitHub-Event: ping", "X-GitHub-Delivery: s-1"])
		let r <- api.POST("/github", h, Bytes.fromUtf8("{\"zen\": \"Design for failure.\"}"))
		expect r == Accepted("recorded")
	}

	case "a signed redelivery is acknowledged" {
		let h = RequestHeaders.of(["X-GitHub-Event: ping", "X-GitHub-Delivery: s-2"])
		let a <- api.POST("/github", h, Bytes.fromUtf8("{}"))
		let b <- api.POST("/github", h, Bytes.fromUtf8("{}"))
		expect a == Accepted("recorded")
		expect b == Ok("duplicate")
	}

	case "unsigned and forged deliveries are refused before the handler runs" {
		let h = RequestHeaders.of(["X-GitHub-Event: ping", "X-GitHub-Delivery: s-3"])
		let none <- api.POST("/github", h, Bytes.fromUtf8("{}")) by Nobody
		let forged <- api.POST("/github", h, Bytes.fromUtf8("{}")) by Forged
		expect none is Rejected(Unauthorized)
		expect forged is Rejected(Unauthorized)
	}

	case "the root is public" {
		let r <- api.GET("/")
		expect r is Ok(_)
	}

	case "a reader with a valid token can read activity" {
		let r <- api.GET("/activity") by Reader("ci")
		expect r is Ok(_)
	}

	case "reading activity without a valid token is refused" {
		let none <- api.GET("/activity") by Nobody
		let forged <- api.GET("/activity") by Forged
		let expired <- api.GET("/activity") by Expired
		expect none is Rejected(Unauthorized)
		expect forged is Rejected(Unauthorized)
		expect expired is Rejected(Unauthorized)
	}

	case "CI metrics are public, and their query is checked at the boundary" {
		let open <- api.GET("/metrics/ci", Wire(""), RequestHeaders.of([])) by Visitor
		let now <- api.GET("/metrics/ci/now", Wire(""), RequestHeaders.of([])) by Visitor
		let tooLong <- api.GET("/metrics/ci", Wire("?days=91"), RequestHeaders.of([])) by Visitor
		let notARepo <- api.GET("/metrics/ci", Wire("?repo=bynk"), RequestHeaders.of([])) by Visitor
		let notATrigger <- api.GET(
			"/metrics/ci",
			Wire("?event=anything"),
			RequestHeaders.of([])
		) by Visitor
		let notABranch <- api.GET(
			"/metrics/ci",
			Wire("?branch=a%20b"),
			RequestHeaders.of([])
		) by Visitor
		expect open is Handled(Ok(_))
		expect now is Handled(Ok(_))
		expect tooLong is Rejected(_)
		expect notARepo is Rejected(_)
		expect notATrigger is Rejected(_)
		expect notABranch is Rejected(_)
	}

	case "a digest day that is not a real YYYY-MM-DD date is refused at the boundary" {
		let word <- api.GET("/digest/:day", Wire("yesterday")) by Reader("ci")
		let month <- api.GET("/digest/:day", Wire("2026-13-01")) by Reader("ci")
		let day <- api.GET("/digest/:day", Wire("2026-01-32")) by Reader("ci")
		let missing <- api.GET("/digest/:day", Wire("2026-02-30")) by Reader("ci")
		let notLeap <- api.GET("/digest/:day", Wire("2026-02-29")) by Reader("ci")
		expect word is Rejected(_)
		expect month is Rejected(_)
		expect day is Rejected(_)
		expect missing is Rejected(_)
		expect notLeap is Rejected(_)
	}
}
