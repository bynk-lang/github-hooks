context github.hooks

---
What the service does in response to a delivery, after answering it. Each
action runs at most once per delivery: it is claimed in `actions` first, and a
claim succeeds only when the action has never run or last failed. So a
redelivery of a failed action retries it, and a redelivery of one that worked
does nothing. An action runs only in a repository `ACTION_REPOS` allows.
---
capability Bot {
	fn react(d: Delivery, body: Bytes) -> Effect[()]
}

provides Bot = GitHubBot given GitHubApi, Secrets, Deliveries, Logger {
	fn react(d: Delivery, body: Bytes) -> Effect[()] {
		// WELCOME_ASSOCIATIONS widens who is welcomed, to test in a sandbox where
		// every author is a member (`FIRST_TIMER,FIRST_TIME_CONTRIBUTOR,OWNER`).
		let associations <- Secrets.get("WELCOME_ASSOCIATIONS")
		let welcomed = present(associations).getOrElse(FIRST_TIMERS)
		let Some(w) = welcomeAmong(d, body, welcomed) else {
			match skipReason(d, body, welcomed) {
				Some(why) => Logger.info("welcome for \(d.id) skipped: \(why)"),
				None => Effect.pure(()),
			}
		}
		let allowed <- Secrets.get("ACTION_REPOS")
		let true = allows(allowed, w.repo) else {
			Logger.info("welcome for \(w.repo)#\(w.number) skipped: not in ACTION_REPOS")
		}
		// Claim the action for this delivery. A row that failed, or was left
		// `started` more than 10 minutes ago (the Worker stopped mid-action), can be
		// claimed again; a duplicate comment is then possible only if a post took
		// longer than that.
		let Ok(claim) <- Deliveries.run(
			"""
			INSERT INTO actions (delivery, action, status) VALUES (?1, 'welcome', 'started')
			ON CONFLICT (delivery, action) DO UPDATE
			  SET status = 'started', detail = NULL, at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
			  WHERE actions.status = 'failed'
			     OR (actions.status = 'started'
			         AND actions.at < strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-10 minutes'))
			""",
			[Text(w.delivery)]
		) else match {
			Err(e) => Logger.error("could not claim the welcome for \(w.delivery): \(sqlError(e))"),
		}
		let true = claim.changes == 1 else {
			Logger.info("welcome for \(w.delivery) already done or in progress")
		}
		// A person is welcomed once per repository: GitHub keeps reporting
		// FIRST_TIME_CONTRIBUTOR on every pull request until one is merged. The
		// claim is released if the comment fails, so a retry can welcome them.
		let Ok(person) <- Deliveries.run(
			"""
			INSERT INTO welcomed (repo, login, delivery) VALUES (lower(?1), lower(?2), ?3)
			ON CONFLICT (repo, login) DO UPDATE SET delivery = excluded.delivery
			  WHERE welcomed.delivery = excluded.delivery
			""",
			[Text(w.repo), Text(w.login), Text(w.delivery)]
		) else match {
			Err(e) => Logger.error("could not claim the welcome of \(w.login): \(sqlError(e))"),
		}
		let already = person.changes == 0
		let skipped: Result[(), String] = Ok(())
		let posted <- if already {
			Effect.pure(skipped)
		} else {
			GitHubApi.comment(w.installation, w.repo, w.number, message(w))
		}
		let status = match posted {
			Ok(_) => "done",
			Err(_) => "failed",
		}
		let detail = match posted {
			Ok(_) => if already {
				Text("\(w.login) was already welcomed in \(w.repo)")
			} else {
				Null
			},
			Err(why) => Text(why),
		}
		let nothingReleased: Result[SqlRun, SqlError] = Ok(SqlRun { changes: 0, lastRowId: 0 })
		let release <- match posted {
			Ok(_) => Effect.pure(nothingReleased),
			Err(_) => Deliveries.run(
				"DELETE FROM welcomed WHERE repo = lower(?1) AND login = lower(?2) AND delivery = ?3",
				[Text(w.repo), Text(w.login), Text(w.delivery)]
			),
		}
		let recorded <- Deliveries.run(
			"""
			UPDATE actions SET status = ?2, detail = ?3, at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
			WHERE delivery = ?1 AND action = 'welcome'
			""",
			[Text(w.delivery), Text(status), detail]
		)
		let _ <- match recorded {
			Ok(_) => Effect.pure(()),
			Err(e) => Logger.error(
				"could not record the welcome for \(w.delivery): \(sqlError(e))"
			),
		}
		let _ <- match release {
			Ok(_) => Effect.pure(()),
			Err(e) => Logger.error("could not release the welcome of \(w.login): \(sqlError(e))"),
		}
		match posted {
			Ok(_) => if already {
				Logger.info(
					"\(w.login) was already welcomed in \(w.repo); not again for #\(w.number)"
				)
			} else {
				Logger.info("welcomed \(w.login) on \(w.repo)#\(w.number)")
			},
			Err(why) => Logger.error(
				"could not welcome \(w.login) on \(w.repo)#\(w.number): \(why)"
			),
		}
	}
}
