commons github.issues

uses github.events
uses github.runs

---
The parts of an `issues` or `issue_comment` delivery the issue-response
figures need (#48). Both carry the whole issue; `issue_comment` also carries
the comment, and `labeled` and `unlabeled` name the one label that changed.
GitHub sends comments on pull requests as `issue_comment` too, with
`issue.pull_request` set.
---
type IssueDelivery = {
	action: String,
	issue: IssuePayload,
	label: Option[LabelRef],
	comment: Option[CommentPayload],
	repository: RepoRef,
}

---
An account as an issue or comment names it. `type` is `User`, `Bot` or
`Organization`.
---
type Account = {
	login: String,
	type: String,
}

--- A label as an issue carries it.
type LabelRef = {
	name: String,
}

---
Present on an issue that is a pull request. Only its presence matters.
---
type PullLink = {
	url: Option[String],
}

---
`issue` as GitHub sends it, in a delivery or from the REST API.
`state_reason` is `completed`, `not_planned` or `duplicate` once closed, and
`reopened` after a reopen. `repository_url` names the repository it is in.
---
type IssuePayload = {
	number: Int,
	title: String,
	user: Account,
	labels: List[LabelRef],
	state: String,
	state_reason: Option[String],
	comments: Int,
	created_at: String,
	updated_at: String,
	closed_at: Option[String],
	author_association: String,
	pull_request: Option[PullLink],
	repository_url: Option[String],
}

---
A repository's open issues as the REST API listed them, and whether that was
all of them (the last page read was short).
---
type IssueListing = {
	issues: List[IssuePayload],
	complete: Bool,
}

--- `comment` as an `issue_comment` delivery carries it.
type CommentPayload = {
	id: Int,
	user: Account,
	author_association: String,
	created_at: String,
}

---
One issue, as `issues` stores it, with times in the `received_at` format.
`state` is GitHub's, or `deleted` or `transferred` for a delivery that
removes the issue from its repository. `authorMaintainer` says whether the
author is a maintainer: known at once for a bot (no) or an owner, member or
collaborator (yes), otherwise `None` until the organisation is asked, since
GitHub reports a member whose membership is private as a `CONTRIBUTOR`. `labels` is the whole set when the
delivery was sent; `label` is the one a `labeled` or `unlabeled` delivery
added or removed.
---
type IssueFact = {
	repo: String,
	number: Int,
	action: String,
	title: String,
	author: String,
	authorIsBot: Bool,
	authorAssociation: String,
	authorMaintainer: Option[Bool],
	state: String,
	stateReason: Option[String],
	openedAt: String,
	closedAt: Option[String],
	updatedAt: String,
	comments: Int,
	labels: List[String],
	label: Option[String],
}

---
A comment that may be a maintainer's response to an issue: when, by whom, and
whether GitHub's author association already says they're a maintainer. When
it doesn't they may still be one, as GitHub reports an organisation member
whose membership is private as a `CONTRIBUTOR`, so the recorder asks the API.
---
type IssueResponse = {
	at: String,
	by: String,
	maintainer: Bool,
}

---
What an `issues` or `issue_comment` delivery says: the issue, and, for a
comment that may be a response, the response.
---
type IssueNews = {
	issue: IssueFact,
	response: Option[IssueResponse],
}

---
The author associations of a maintainer: someone who owns, belongs to, or
collaborates on the repository.
---
fn isMaintainer(association: String) -> Bool {
	association == "OWNER" || association == "MEMBER" || association == "COLLABORATOR"
}

---
The response a comment may be, at the time it was made: `None` for a bot's
(even one GitHub reports as a member) or the issue's own author's, who can't
respond to themselves; otherwise whether GitHub's association already makes
the commenter a maintainer.
---
fn responseOf(c: CommentPayload, issueAuthor: String) -> Option[IssueResponse] {
	let true = c.user.type != "Bot" && c.user.login.toLower() != issueAuthor.toLower() else { None }
	isoTime(c.created_at).map((at) => IssueResponse {
		at: at,
		by: c.user.login,
		maintainer: isMaintainer(c.author_association),
	})
}

---
The issue an `issues` or `issue_comment` delivery describes, `None` for one
about a pull request (a comment on a PR), or why it couldn't be read.
---
fn issueOf(body: Bytes) -> Result[Option[IssueNews], String] {
	let Some(text) = body.decodeUtf8() else { Err("the payload is not UTF-8") }
	let Ok(p) = Json.decode[IssueDelivery](text) else match {
		Err(e) => Err("the payload did not decode: \(e.kind) at \(e.path): \(e.message)"),
	}
	let i = p.issue
	let None = i.pull_request else { Ok(None) }
	let response: Option[IssueResponse] = match p.comment {
		Some(c) => if p.action != "deleted" { responseOf(c, i.user.login) } else { None },
		None => None,
	}
	// A deleted comment leaves the issue; only an `issues` delivery removes it.
	let removed = (p.action == "deleted" || p.action == "transferred") && p.comment.isNone()
	let Ok(fact) = issueFact(
		p.repository.full_name,
		p.action,
		if removed { Some(p.action) } else { None },
		p.label.map((l) => l.name),
		i
	) else match {
		Err(why) => Err(why),
	}
	Ok(Some(IssueNews { issue: fact, response: response }))
}

---
An issue as `issues` stores it, from GitHub's `issue` (a delivery's, or the
REST API's, which has the same shape): `repo` it belongs to, the `action`
that said so (`sync` for the daily sync), `removed` (`deleted` or
`transferred`) when it has left the repository, and the one `label` a
`labeled` or `unlabeled` delivery names.
---
fn issueFact(
	repo: String,
	action: String,
	removed: Option[String],
	label: Option[String],
	i: IssuePayload
) -> Result[IssueFact, String] {
	let Some(opened) = isoTime(i.created_at) else {
		Err("created_at is not a time: \(i.created_at)")
	}
	let Some(updated) = isoTime(i.updated_at) else {
		Err("updated_at is not a time: \(i.updated_at)")
	}
	Ok(IssueFact {
		repo: repo,
		number: i.number,
		action: action,
		title: i.title,
		author: i.user.login,
		authorIsBot: i.user.type == "Bot",
		authorAssociation: i.author_association,
		authorMaintainer: if i.user.type == "Bot" {
			Some(false)
		} else if isMaintainer(i.author_association) { Some(true) } else { None },
		state: removed.getOrElse(i.state),
		stateReason: i.state_reason,
		openedAt: opened,
		closedAt: i.closed_at.andThen((t) => isoTime(t)),
		updatedAt: updated,
		comments: i.comments,
		labels: i.labels.map((l) => l.name),
		label: label,
	})
}

---
The repository an issue from the REST API belongs to, from its
`repository_url` (`https://api.github.com/repos/{owner}/{name}`): after a
transfer, GitHub answers for the old number with the issue where it now is.
---
fn repoOfIssue(i: IssuePayload) -> Option[String] {
	let prefix = "https://api.github.com/repos/"
	i.repository_url.filter((u) => u.startsWith(prefix)).map((u) => u.replace(prefix, ""))
}
