context github.hooks

uses github.events
uses github.activity
consumes bynk { Logger }
consumes bynk.cloudflare { D1 }

---
Every delivery this service has accepted, one row each, keyed by GitHub's
delivery id. The key is what makes a redelivery harmless.
---
capability Deliveries = D1

---
The `bynk-lang` GitHub App. GitHub signs every delivery with HMAC-SHA256 of the
raw body under the App's webhook secret and sends it as
`X-Hub-Signature-256: sha256=<hex>`. The compiler generates the check: it runs
before the handler, compares in constant time, and answers `401` to anything
unsigned or forged.

GitHub signs no timestamp, so there is no replay window here. A replayed
delivery carries a delivery id we have already recorded, and is acknowledged
without being recorded twice.
---
actor GitHub { auth = Signature(secret = "APP_WEBHOOK_SECRET", header = "X-Hub-Signature-256") }

---
Who may read recorded activity: a caller presenting a JWT signed (HS256) with
`API_TOKEN_SECRET`. The compiler generates the check, including `exp` and
`nbf`, and answers `401` to a missing, forged or expired token.
`scripts/token.sh` mints one. The token's `sub` names the reader, for logs.
---
actor Reader { auth = Bearer(secret = "API_TOKEN_SECRET"), identity = ReaderId }

---
A reader's name, from their token's `sub`.
---
type ReaderId = String where NonEmpty

service api from http {
	// GitHub caps a delivery's payload at 25 MB (25,000,000 bytes). This cap is
	// 25 MiB (26,214,400 bytes), so a delivery at GitHub's limit still fits.
	limits {
		maxBody: 26_214_400,
	}

	on GET("/") () -> Effect[HttpResult[String]] by v: Visitor {
		Ok("github-hooks: POST GitHub App webhook deliveries to /github")
	}

	// The 50 most recent deliveries, across every repository.
	on GET("/activity") () -> Effect[HttpResult[List[Activity]]] by reader: Reader given Deliveries, Logger {
		let Ok(rows) <- Deliveries.all(
			"""
			SELECT id, event, action, repo, sender, org, installation, deleted, size, received_at
			FROM deliveries
			ORDER BY received_at DESC, rowid DESC
			LIMIT 50
			""",
			[]
		) else match {
			Err(e) => {
				let _ <- Logger.error("could not list activity: \(sqlError(e))")
				ServerError("could not read recorded activity")
			},
		}
		let Ok(list) = Json.decodeSql[List[Activity]](rows) else match {
			Err(e) => {
				let _ <- Logger.error("could not decode activity rows: \(jsonError(e))")
				ServerError("recorded activity did not decode")
			},
		}
		let _ <- Logger.info("\(reader.identity) listed activity")
		Ok(list)
	}

	// The 50 most recent deliveries for one repository, `/activity/bynk-lang/bynk`.
	on GET("/activity/:owner/:name") (
		owner: String,
		name: String
	) -> Effect[HttpResult[List[Activity]]] by reader: Reader given Deliveries, Logger {
		let Ok(rows) <- Deliveries.all(
			"""
			SELECT id, event, action, repo, sender, org, installation, deleted, size, received_at
			FROM deliveries
			WHERE repo = ?1 COLLATE NOCASE
			ORDER BY received_at DESC, rowid DESC
			LIMIT 50
			""",
			[Text("\(owner)/\(name)")]
		) else match {
			Err(e) => {
				let _ <- Logger.error("could not list \(owner)/\(name) activity: \(sqlError(e))")
				ServerError("could not read recorded activity")
			},
		}
		let Ok(list) = Json.decodeSql[List[Activity]](rows) else match {
			Err(e) => {
				let _ <- Logger.error(
					"could not decode \(owner)/\(name) activity rows: \(jsonError(e))"
				)
				ServerError("recorded activity did not decode")
			},
		}
		let _ <- Logger.info("\(reader.identity) listed \(owner)/\(name) activity")
		Ok(list)
	}

	// One UTC day's activity, counted by repository, event and action.
	on GET("/digest/:day") (
		day: Day
	) -> Effect[HttpResult[Digest]] by reader: Reader given Deliveries, Logger {
		let Some(range) = rangeOf(day) else { BadRequest("\(day) is not a date") }
		// `received_at` defaults to strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
		// (0001_create_deliveries.sql), the same text `toIso()` writes down to the
		// three-digit milliseconds, so the range compares as text, in time order,
		// and uses the time index. The bound depends on the two formats matching:
		// change either and the digest's day-boundary test should fail.
		let Ok(rows) <- Deliveries.all(
			"""
			SELECT repo, event, action, count(*) AS deliveries
			FROM deliveries
			WHERE received_at >= ?1 AND received_at < ?2
			  AND NOT (event = 'push' AND deleted IS 1)
			GROUP BY repo, event, action
			ORDER BY deliveries DESC, repo, event, action
			""",
			[Text(range.start.toIso()), Text(range.end.toIso())]
		) else match {
			Err(e) => {
				let _ <- Logger.error("could not count \(day): \(sqlError(e))")
				ServerError("could not read recorded activity")
			},
		}
		let Ok(tallies) = Json.decodeSql[List[Tally]](rows) else match {
			Err(e) => {
				let _ <- Logger.error("could not decode the \(day) digest rows: \(jsonError(e))")
				ServerError("the digest did not decode")
			},
		}
		let _ <- Logger.info("\(reader.identity) read the \(day) digest")
		Ok(digest(day, tallies))
	}

	// Receive one delivery. GitHub waits at most 10 seconds for a 2xx, so this
	// records the delivery and answers; work done in response belongs elsewhere.
	@raw(contentType: "application/json")
	on POST("/github") (
		headers: RequestHeaders,
		body: Bytes
	) -> Effect[HttpResult[String]] by GitHub given Deliveries, Logger {
		let Ok(d) = read(
			headers.get("X-GitHub-Event"),
			headers.get("X-GitHub-Delivery"),
			body
		) else match {
			Err(why) => BadRequest(describe(why)),
		}
		// Only a conflict on the delivery id is a redelivery: it inserts nothing.
		// Any other failure, including a constraint a later migration adds, is a
		// 500, so GitHub can redeliver it.
		let Ok(r) <- Deliveries.run(
			"""
			INSERT INTO deliveries (id, event, action, repo, sender, org, installation, deleted, size)
			VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)
			ON CONFLICT (id) DO NOTHING
			""",
			[
				Text(d.id),
				Text(d.event),
				text(d.action),
				text(d.repo),
				text(d.sender),
				text(d.org),
				integer(d.installation),
				boolean(d.deleted),
				Integer(d.size),
			]
		) else match {
			Err(e) => {
				let _ <- Logger.error(
					"could not record delivery \(d.id) (\(d.event)): \(sqlError(e))"
				)
				ServerError("could not record the delivery")
			},
		}
		if r.changes == 0 {
			let _ <- Logger.info("redelivery \(d.id) (\(d.event))")
			Ok("duplicate")
		} else {
			let _ <- Logger.info("delivery \(d.id) (\(d.event))")
			Accepted("recorded")
		}
	}
}

---
Why rows did not decode, for the log: `StructuralMismatch at $[0].size:
expected number, got string`.
---
fn jsonError(e: JsonError) -> String {
	"\(e.kind) at \(e.path): \(e.message)"
}

fn sqlError(e: SqlError) -> String {
	match e {
		Constraint(m) => "constraint: \(m)",
		Failed(m) => m,
		_ => "unrecognised D1 error",
	}
}

fn text(s: Option[String]) -> SqlValue {
	match s {
		Some(v) => Text(v),
		None => Null,
	}
}

fn integer(n: Option[Int]) -> SqlValue {
	match n {
		Some(v) => Integer(v),
		None => Null,
	}
}

fn boolean(b: Option[Bool]) -> SqlValue {
	match b {
		Some(v) => Boolean(v),
		None => Null,
	}
}
