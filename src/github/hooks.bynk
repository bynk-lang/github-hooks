context github.hooks

uses github.events
uses github.activity
uses github.app
uses github.welcome
consumes bynk { Logger, Secrets, Clock, Fetch }
consumes bynk.crypto { Crypto }
consumes bynk.cloudflare { D1, Kv }

---
Every delivery this service has accepted, one row each, keyed by GitHub's
delivery id. The key is what makes a redelivery harmless.
---
capability Deliveries = D1

---
Installation tokens, cached for `TOKEN_CACHE_SECONDS` so a burst of deliveries
mints one token, not one each. Keyed `installation:<id>`. A token here is a
credential: it expires within the hour and is never logged.
---
capability Tokens = Kv

---
Acting as the GitHub App. `token` gives an installation token: from `Tokens`
when one is cached, otherwise by signing a JWT with the App's private key
(`APP_PRIVATE_KEY`, base64 PKCS#8) as `APP_CLIENT_ID` and exchanging it with
GitHub. Kept separate from what the service does with the token, so it can move
into a first-party package unchanged.
---
capability AppAuth {
	fn token(installation: Int) -> Effect[Result[String, String]]
}

provides AppAuth = GitHubAppAuth given Secrets, Clock, Crypto, Fetch, Tokens {
	fn token(installation: Int) -> Effect[Result[String, String]] {
		let key = "installation:\(installation)"
		let cached <- Tokens.get(key)
		match cached {
			Some(t) => Effect.pure(Ok(t)),
			None => {
				// An empty value is as unusable as a missing one.
				let clientIdSet <- Secrets.get("APP_CLIENT_ID")
				let Some(clientId) = present(clientIdSet) else {
					Effect.pure(Err("APP_CLIENT_ID is not set"))
				}
				let keySet <- Secrets.get("APP_PRIVATE_KEY")
				let Some(stored) = present(keySet) else {
					Effect.pure(Err("APP_PRIVATE_KEY is not set"))
				}
				let Some(der) = pkcs8(stored) else {
					Effect.pure(Err("APP_PRIVATE_KEY is not base64"))
				}
				let Ok(signingKey) <- Crypto.importSigningKey(RsaPkcs1Sha256, der) else match {
					Err(_) => Effect.pure(Err("APP_PRIVATE_KEY is not an RSA PKCS#8 key")),
				}
				let now <- Clock.now()
				let input = jwtSigningInput(clientId, now)
				let signature <- Crypto.sign(signingKey, Bytes.fromUtf8(input))
				let jwt = "\(input).\(signature.toBase64Url())"
				let sent <- Fetch.send(Request {
					method: Post,
					url: "https://api.github.com/app/installations/\(installation)/access_tokens",
					contentType: None,
					authorization: Some("Bearer \(jwt)"),
					headers: apiHeaders(),
					body: None,
				})
				let Ok(res) = sent else {
					Effect.pure(Err("GitHub could not be reached for a token"))
				}
				let true = res.status == 201 else {
					Effect.pure(Err("GitHub refused a token for installation \(installation): \(res.status)"))
				}
				let Ok(t) = Json.decode[InstallationToken](res.body) else {
					Effect.pure(Err("GitHub's token response did not decode"))
				}
				let _ <- Tokens.putTtl(key, t.token, TOKEN_CACHE_SECONDS)
				Effect.pure(Ok(t.token))
			},
		}
	}
}

---
The GitHub REST calls the service makes, each as the App's installation.
---
capability GitHubApi {
	fn comment(
		installation: Int,
		repo: String,
		number: Int,
		body: String
	) -> Effect[Result[(), String]]
}

provides GitHubApi = GitHubRest given AppAuth, Fetch {
	fn comment(
		installation: Int,
		repo: String,
		number: Int,
		body: String
	) -> Effect[Result[(), String]] {
		let Ok(token) <- AppAuth.token(installation) else match {
			Err(why) => Effect.pure(Err(why)),
		}
		let sent <- Fetch.send(Request {
			method: Post,
			url: "https://api.github.com/repos/\(repo)/issues/\(number)/comments",
			contentType: Some("application/json"),
			authorization: Some("Bearer \(token)"),
			headers: apiHeaders(),
			body: Some(Json.encode(NewComment { body: body })),
		})
		let Ok(res) = sent else { Effect.pure(Err("GitHub could not be reached to comment")) }
		let true = res.status == 201 else {
			Effect.pure(Err("GitHub refused the comment on \(repo)#\(number): \(res.status)"))
		}
		Effect.pure(Ok(()))
	}
}

---
What the service does in response to a delivery, after answering it. Each
action runs at most once per delivery: it is claimed in `actions` first, and a
claim succeeds only when the action has never run or last failed. So a
redelivery of a failed action retries it, and a redelivery of one that worked
does nothing. An action runs only in a repository `ACTION_REPOS` allows.
---
capability Bot {
	fn react(event: String, delivery: String, body: Bytes) -> Effect[()]
}

provides Bot = GitHubBot given GitHubApi, Secrets, Deliveries, Logger {
	// The delivery arrives as its parts, built-in types only, and is read again
	// here: a capability operation that takes a commons type emits a test module
	// that does not compile (Bynk v0.492.1).
	fn react(event: String, delivery: String, body: Bytes) -> Effect[()] {
		let Ok(d) = read(Some(event), Some(delivery), body) else { Effect.pure(()) }
		// WELCOME_ASSOCIATIONS widens who is welcomed, to test in a sandbox where
		// every author is a member (`FIRST_TIMER,FIRST_TIME_CONTRIBUTOR,OWNER`).
		let associations <- Secrets.get("WELCOME_ASSOCIATIONS")
		let welcomed = present(associations).getOrElse(FIRST_TIMERS)
		let Some(w) = welcomeAmong(d, body, welcomed) else { Effect.pure(()) }
		let allowed <- Secrets.get("ACTION_REPOS")
		let true = allows(allowed, w.repo) else {
			Logger.info("welcome for \(w.repo)#\(w.number) skipped: not in ACTION_REPOS")
		}
		let Ok(claim) <- Deliveries.run(
			"""
			INSERT INTO actions (delivery, action, status) VALUES (?1, 'welcome', 'started')
			ON CONFLICT (delivery, action) DO UPDATE
			  SET status = 'started', detail = NULL, at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
			  WHERE actions.status = 'failed'
			""",
			[Text(w.delivery)]
		) else match {
			Err(e) => Logger.error("could not claim the welcome for \(w.delivery): \(sqlError(e))"),
		}
		let true = claim.changes == 1 else {
			Logger.info("welcome for \(w.delivery) already done or in progress")
		}
		let posted <- GitHubApi.comment(w.installation, w.repo, w.number, message(w))
		let status = match posted {
			Ok(_) => "done",
			Err(_) => "failed",
		}
		let detail = match posted {
			Ok(_) => Null,
			Err(why) => Text(why),
		}
		let _ <- Deliveries.run(
			"""
			UPDATE actions SET status = ?2, detail = ?3, at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
			WHERE delivery = ?1 AND action = 'welcome'
			""",
			[Text(w.delivery), Text(status), detail]
		)
		match posted {
			Ok(_) => Logger.info("welcomed \(w.login) on \(w.repo)#\(w.number)"),
			Err(why) => Logger.error(
				"could not welcome \(w.login) on \(w.repo)#\(w.number): \(why)"
			),
		}
	}
}

---
The `bynk-lang` GitHub App. GitHub signs every delivery with HMAC-SHA256 of the
raw body under the App's webhook secret and sends it as
`X-Hub-Signature-256: sha256=<hex>`. The compiler generates the check: it runs
before the handler, compares in constant time, and answers `401` to anything
unsigned or forged.

GitHub signs no timestamp, so there is no replay window here. A replayed
delivery carries a delivery id we have already recorded, and is acknowledged
without being recorded twice.
---
actor GitHub { auth = Signature(secret = "APP_WEBHOOK_SECRET", header = "X-Hub-Signature-256") }

---
Who may read recorded activity: a caller presenting a JWT signed (HS256) with
`API_TOKEN_SECRET`. The compiler generates the check, including `exp` and
`nbf`, and answers `401` to a missing, forged or expired token.
`scripts/token.sh` mints one. The token's `sub` names the reader, for logs.
---
actor Reader { auth = Bearer(secret = "API_TOKEN_SECRET"), identity = ReaderId }

---
A reader's name, from their token's `sub`.
---
type ReaderId = String where NonEmpty

service api from http {
	// GitHub caps a delivery's payload at 25 MB (25,000,000 bytes). This cap is
	// 25 MiB (26,214,400 bytes), so a delivery at GitHub's limit still fits.
	limits {
		maxBody: 26_214_400,
	}

	on GET("/") () -> Effect[HttpResult[String]] by v: Visitor {
		Ok("github-hooks: POST GitHub App webhook deliveries to /github")
	}

	// The 50 most recent deliveries, across every repository.
	on GET("/activity") () -> Effect[HttpResult[List[Activity]]] by reader: Reader given Deliveries, Logger {
		let Ok(rows) <- Deliveries.all(
			"""
			SELECT id, event, action, repo, sender, org, installation, deleted, size, received_at
			FROM deliveries
			ORDER BY received_at DESC, rowid DESC
			LIMIT 50
			""",
			[]
		) else match {
			Err(e) => {
				let _ <- Logger.error("could not list activity: \(sqlError(e))")
				ServerError("could not read recorded activity")
			},
		}
		let Ok(list) = Json.decodeSql[List[Activity]](rows) else match {
			Err(e) => {
				let _ <- Logger.error("could not decode activity rows: \(jsonError(e))")
				ServerError("recorded activity did not decode")
			},
		}
		let _ <- Logger.info("\(reader.identity) listed activity")
		Ok(list)
	}

	// The 50 most recent deliveries for one repository, `/activity/bynk-lang/bynk`.
	on GET("/activity/:owner/:name") (
		owner: String,
		name: String
	) -> Effect[HttpResult[List[Activity]]] by reader: Reader given Deliveries, Logger {
		let Ok(rows) <- Deliveries.all(
			"""
			SELECT id, event, action, repo, sender, org, installation, deleted, size, received_at
			FROM deliveries
			WHERE repo = ?1 COLLATE NOCASE
			ORDER BY received_at DESC, rowid DESC
			LIMIT 50
			""",
			[Text("\(owner)/\(name)")]
		) else match {
			Err(e) => {
				let _ <- Logger.error("could not list \(owner)/\(name) activity: \(sqlError(e))")
				ServerError("could not read recorded activity")
			},
		}
		let Ok(list) = Json.decodeSql[List[Activity]](rows) else match {
			Err(e) => {
				let _ <- Logger.error(
					"could not decode \(owner)/\(name) activity rows: \(jsonError(e))"
				)
				ServerError("recorded activity did not decode")
			},
		}
		let _ <- Logger.info("\(reader.identity) listed \(owner)/\(name) activity")
		Ok(list)
	}

	// One UTC day's activity, counted by repository, event and action.
	on GET("/digest/:day") (
		day: Day
	) -> Effect[HttpResult[DayDigest]] by reader: Reader given Deliveries, Logger {
		let Some(range) = rangeOf(day) else { BadRequest("\(day) is not a date") }
		// `received_at` defaults to strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
		// (0001_create_deliveries.sql), the same text `toIso()` writes down to the
		// three-digit milliseconds, so the range compares as text, in time order,
		// and uses the time index. The bound depends on the two formats matching:
		// change either and the digest's day-boundary test should fail.
		let Ok(rows) <- Deliveries.all(
			"""
			SELECT repo, event, action, count(*) AS deliveries
			FROM deliveries
			WHERE received_at >= ?1 AND received_at < ?2
			  AND NOT (event = 'push' AND deleted IS 1)
			GROUP BY repo, event, action
			ORDER BY deliveries DESC, repo, event, action
			""",
			[Text(range.start.toIso()), Text(range.end.toIso())]
		) else match {
			Err(e) => {
				let _ <- Logger.error("could not count \(day): \(sqlError(e))")
				ServerError("could not read recorded activity")
			},
		}
		let Ok(tallies) = Json.decodeSql[List[Tally]](rows) else match {
			Err(e) => {
				let _ <- Logger.error("could not decode the \(day) digest rows: \(jsonError(e))")
				ServerError("the digest did not decode")
			},
		}
		let _ <- Logger.info("\(reader.identity) read the \(day) digest")
		Ok(digest(day, tallies))
	}

	// Receive one delivery. GitHub waits at most 10 seconds for a 2xx, so this
	// records the delivery and answers; work done in response belongs elsewhere.
	@raw(contentType: "application/json")
	on POST("/github") (
		headers: RequestHeaders,
		body: Bytes
	) -> Effect[HttpResult[String]] by GitHub given Deliveries, Logger, Bot {
		let Ok(d) = read(
			headers.get("X-GitHub-Event"),
			headers.get("X-GitHub-Delivery"),
			body
		) else match {
			Err(why) => BadRequest(describe(why)),
		}
		// Only a conflict on the delivery id is a redelivery: it inserts nothing.
		// Any other failure, including a constraint a later migration adds, is a
		// 500, so GitHub can redeliver it.
		let Ok(r) <- Deliveries.run(
			"""
			INSERT INTO deliveries (id, event, action, repo, sender, org, installation, deleted, size)
			VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)
			ON CONFLICT (id) DO NOTHING
			""",
			[
				Text(d.id),
				Text(d.event),
				text(d.action),
				text(d.repo),
				text(d.sender),
				text(d.org),
				integer(d.installation),
				boolean(d.deleted),
				Integer(d.size),
			]
		) else match {
			Err(e) => {
				let _ <- Logger.error(
					"could not record delivery \(d.id) (\(d.event)): \(sqlError(e))"
				)
				ServerError("could not record the delivery")
			},
		}
		// Act after answering: GitHub waits at most 10 seconds for the reply.
		// A redelivery reacts too, so a failed action is retried; one that
		// worked is not repeated (see `Bot`).
		~> Bot.react(d.event, d.id, body)
		if r.changes == 0 {
			let _ <- Logger.info("redelivery \(d.id) (\(d.event))")
			Ok("duplicate")
		} else {
			let _ <- Logger.info("delivery \(d.id) (\(d.event))")
			Accepted("recorded")
		}
	}
}

---
Why rows did not decode, for the log: `StructuralMismatch at $[0].size:
expected number, got string`.
---
fn jsonError(e: JsonError) -> String {
	"\(e.kind) at \(e.path): \(e.message)"
}

fn sqlError(e: SqlError) -> String {
	match e {
		Constraint(m) => "constraint: \(m)",
		Failed(m) => m,
		_ => "unrecognised D1 error",
	}
}

fn text(s: Option[String]) -> SqlValue {
	match s {
		Some(v) => Text(v),
		None => Null,
	}
}

fn integer(n: Option[Int]) -> SqlValue {
	match n {
		Some(v) => Integer(v),
		None => Null,
	}
}

fn boolean(b: Option[Bool]) -> SqlValue {
	match b {
		Some(v) => Boolean(v),
		None => Null,
	}
}
