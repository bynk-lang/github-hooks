commons github.activity

---
A calendar day in UTC, `YYYY-MM-DD`, as `received_at` begins. A path parameter
of this type is checked at the boundary, so `GET /digest/yesterday` or
`/digest/2026-13-45` is a `400` before the handler runs. The pattern bounds the
month to 01–12 and the day to 01–31; `rangeOf` rejects the rest (`02-30`).
---
type Day = String where Matches("^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$")

---
The instants a UTC day spans: from its first millisecond (`start`) up to, not
including, the first millisecond of the next day (`end`).
---
type DayRange = {
	start: Instant,
	end: Instant,
}

---
A day's range, or `None` when the date doesn't exist (`2026-02-30`, or
29 February outside a leap year). `Instant.fromIso` decides which dates exist,
so this needs no calendar arithmetic of its own; a UTC day is always 24 hours.
---
fn rangeOf(day: Day) -> Option[DayRange] {
	let Some(start) = Instant.fromIso("\(day)T00:00:00Z") else { None }
	Some(DayRange { start: start, end: start + 1.days })
}

---
One recorded delivery, as the read API returns it: a row of `deliveries`.
---
type Activity = {
	id: String,
	event: String,
	action: Option[String],
	repo: Option[String],
	sender: Option[String],
	org: Option[String],
	installation: Option[Int],
	deleted: Option[Bool],
	size: Int,
	received_at: String,
}

---
How many deliveries of one event and action a repository had in a day. `repo`
is `None` for the deliveries that belong to no repository (`ping`,
`installation`).
---
type Tally = {
	repo: Option[String],
	event: String,
	action: Option[String],
	deliveries: Int,
}

---
One day's activity, busiest first. Pushes that deleted a branch or tag are left
out: each one arrives beside a `delete` event, which is counted instead.
---
type DayDigest = {
	day: Day,
	total: Int,
	tallies: List[Tally],
}

---
The digest for a day from its tallies.
---
fn digest(day: Day, tallies: List[Tally]) -> DayDigest {
	DayDigest {
		day: day,
		total: tallies.fold(0, (sum, t) => sum + t.deliveries),
		tallies: tallies,
	}
}
