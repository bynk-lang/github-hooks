commons github.activity

---
A calendar day in UTC, `YYYY-MM-DD`, as `received_at` begins. `IsoDate` admits
only dates that exist, so a path parameter of this type is checked at the
boundary: `GET /digest/yesterday`, `/digest/2026-13-01` and `/digest/2026-02-30`
are each a `400` before the handler runs.
---
type Day = String where IsoDate

---
The instants a UTC day spans: from its first millisecond (`start`) up to, not
including, the first millisecond of the next day (`end`).
---
type DayRange = {
	start: Instant,
	end: Instant,
}

---
A day's range; a UTC day is always 24 hours. `Instant.fromIso` answers an
`Option`, but it applies the same calendar rule as `IsoDate`, so for a `Day`
it is always `Some`.
---
fn rangeOf(day: Day) -> Option[DayRange] {
	let Some(start) = Instant.fromIso("\(day)T00:00:00Z") else { None }
	Some(DayRange { start: start, end: start + 1.days })
}

---
One recorded delivery, as the read API returns it: a row of `deliveries`.
---
type Activity = {
	id: String,
	event: String,
	action: Option[String],
	repo: Option[String],
	sender: Option[String],
	org: Option[String],
	installation: Option[Int],
	deleted: Option[Bool],
	size: Int,
	received_at: String,
}

---
How many deliveries of one event and action a repository had in a day. `repo`
is `None` for the deliveries that belong to no repository (`ping`,
`installation`).
---
type Tally = {
	repo: Option[String],
	event: String,
	action: Option[String],
	deliveries: Int,
}

---
One day's activity, busiest first. Pushes that deleted a branch or tag are left
out: each one arrives beside a `delete` event, which is counted instead.
---
type DayDigest = {
	day: Day,
	total: Int,
	tallies: List[Tally],
}

---
The digest for a day from its tallies.
---
fn digest(day: Day, tallies: List[Tally]) -> DayDigest {
	DayDigest {
		day: day,
		total: tallies.fold(0, (sum, t) => sum + t.deliveries),
		tallies: tallies,
	}
}

---
How long recorded activity is kept. A delivery is kept 90 days, enough for any
quarter's digests. A `workflow_run` that is only `requested` or `in_progress`
is kept 7 days: two thirds of all deliveries are workflow runs, and the
`completed` delivery carries the run's outcome. So is every `workflow_job`
delivery (#42): about 15,000 a day, whose facts are kept in `workflow_jobs`.
---
const KEEP: Duration = 90.days

const KEEP_RUN_PROGRESS: Duration = 7.days

---
At most this many rows go per statement per run, so no one `DELETE` runs long.
The job runs hourly, so a backlog clears at up to 120,000 rows a day.
---
const RETENTION_BATCH: Int = 5000

---
The `received_at` text each rule deletes before, from the run's time. Compared
as text with `received_at`, as the digest's range is. `jobDays` is the UTC day
(`YYYY-MM-DD`) job rows are rolled up and pruned before: whole days, 90 back.
---
type Cutoffs = {
	deliveries: String,
	runProgress: String,
	jobDays: String,
}

fn cutoffs(now: Instant) -> Cutoffs {
	Cutoffs {
		deliveries: (now - KEEP).toIso(),
		runProgress: (now - KEEP_RUN_PROGRESS).toIso(),
		jobDays: (now - KEEP).toIso().slice(0, 10),
	}
}
