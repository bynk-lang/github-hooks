commons github.maintainers

uses github.app

---
The maintainers view (#53): who is signed in, and the sign-in settings the
pages and the Worker share. Maintainers sign in with GitHub, through the
GitHub App's user authorisation. The Worker reads their login from GitHub,
checks they belong to the organisation, and issues its own short-lived token,
which the `Maintainer` actor verifies. A maintainer's identity is their GitHub
login.
---
type MaintainerId = String where NonEmpty

---
`GET /maintainers/config`: what the page needs to start a sign-in, all
public. `authorization_endpoint` is where it sends the browser, and
`client_id` is the GitHub App's client ID.
---
type SignInConfig = {
	authorization_endpoint: String,
	client_id: String,
}

---
`POST /maintainers/token`'s body: the code GitHub sent back, the PKCE
verifier the page kept, and the redirect URI the sign-in used.
---
type TokenRequest = {
	code: String,
	code_verifier: String,
	redirect_uri: String,
}

---
`POST /maintainers/token`'s answer: this service's token for the maintainer,
how many seconds it lasts, and whose it is.
---
type SignedIn = {
	token: String,
	expires_in: Int,
	login: String,
}

---
GitHub's answer when a sign-in code is exchanged: a user access token, or an
error. GitHub answers `200` either way.
---
type GitHubTokenReply = {
	access_token: Option[String],
	error: Option[String],
	error_description: Option[String],
}

--- The signed-in user, as GitHub's `GET /user` describes them.
type GitHubUser = {
	login: String,
}

--- `GET /maintainers/me`: who is signed in, by GitHub login.
type Me = {
	login: String,
}

--- The organisation whose members are maintainers.
const MAINTAINER_ORG: String = "bynk-lang"

--- Where the page sends the browser to sign in with GitHub.
const GITHUB_AUTHORIZE: String = "https://github.com/login/oauth/authorize"

--- Where the Worker exchanges a sign-in code.
const GITHUB_TOKEN_URL: String = "https://github.com/login/oauth/access_token"

---
How long a maintainer's token lasts: a working day. Membership is checked
again on each request, so leaving the organisation ends access sooner.
---
const SESSION_SECONDS: Int = 28800

---
Whether `uri` is this service's sign-in callback, on the origin the request
came to (`host`, from its `Host` header): `https`, or `http` for a local
Worker only.
---
fn isOwnCallback(uri: String, host: String) -> Bool {
	let local = host.startsWith("localhost:") || host == "localhost" || host.startsWith("127.0.0.1")
	uri == "https://\(host)/maintainers/callback"
		|| (local && uri == "http://\(host)/maintainers/callback")
}

---
The form GitHub's token endpoint takes for a code: the App's client ID and
secret, the code, and the PKCE verifier and redirect URI it was issued for.
---
fn tokenForm(clientId: String, clientSecret: String, r: TokenRequest) -> String {
	let pairs = [
		["client_id", clientId],
		["client_secret", clientSecret],
		["code", r.code],
		["code_verifier", r.code_verifier],
		["redirect_uri", r.redirect_uri],
	]
	pairs
		.map(
			(p) => "\(p.first().getOrElse("").percentEncode())=\(p.get(1).getOrElse("").percentEncode())"
		)
		.fold("", (all, part) => if all == "" { part } else { "\(all)&\(part)" })
}

--- A maintainer token's claims: whose it is, and when it was issued and ends.
type SessionClaims = {
	sub: String,
	iat: Int,
	exp: Int,
}

const SESSION_HEADER: String = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"

---
The part of a maintainer token that is signed: an HS256 JWT's header and
claims, for `login`, issued at `now` and lasting `SESSION_SECONDS`. The
`Maintainer` actor (Bynk's `Bearer`) verifies the signature, `exp` and `nbf`.
---
fn sessionSigningInput(login: String, now: Instant) -> String {
	let seconds = now.toEpochMillis() / 1000
	let claims = SessionClaims {
		sub: login,
		iat: seconds,
		exp: seconds + SESSION_SECONDS,
	}
	"\(base64Url(SESSION_HEADER)).\(base64Url(Json.encode(claims)))"
}

---
A repository, as `GET /maintainers/repositories` lists it: whether it is
public, and whether `DASHBOARD_EXCLUDE` keeps it off the public pages. Only
maintainers see a repository that is private or excluded.
---
type ShownRepository = {
	repo: String,
	public: Bool,
	excluded: Bool,
}

---
`GET /maintainers/mine` (#53): what is the signed-in maintainer's to act on,
across every repository, private ones included. Each list is capped at
`MAX_MINE`.
- `pulls`: their open pull requests, oldest waiting first, each with its
  stage and its CI on its head commit.
- `reviews`: open pull requests waiting on their review, asked of them by
  name (a team's request isn't attributed to its members).
- `issues`: their open issues, the stale first (no update for 14 days).
- `unreleased`: their pull requests merged since their repository's latest
  final release, waiting to ship.
- `proposals` (#88): what the App would do, waiting on any maintainer,
  oldest first. It isn't one maintainer's, so every maintainer sees it.
- `claude` (#88): today's Claude calls against the daily caps.
---
type Mine = {
	login: String,
	pulls: List[MyPull],
	reviews: List[ReviewWaiting],
	issues: List[MyIssue],
	unreleased: List[MyMerge],
	proposals: List[ProposalWaiting],
	claude: ClaudeToday,
}

---
A proposal waiting on a maintainer (#88): what the App would do (`kind`, on
issue or pull request `target` of `repo`), and why. For `labels`, `labels`
are the labels it would add. It expires, unanswered, at `expires_at`.
---
type ProposalWaiting = {
	id: Int,
	repo: String,
	kind: String,
	target: Int,
	title: Option[String],
	labels: List[String],
	reason: String,
	proposed_at: String,
	expires_at: String,
}

---
Today's Claude calls (#88), UTC: claimed across every repository, the
busiest repository's, and the caps they're held to.
---
type ClaudeToday = {
	calls: Int,
	busiest: Int,
	repo_cap: Int,
	total_cap: Int,
}

--- `POST /maintainers/proposals/approve` and `…/decline`'s request: which proposal.
type ProposalDecision = {
	id: Int,
}

--- What came of a decision: the proposal's status now, and what happened, in words.
type ProposalDecided = {
	id: Int,
	status: String,
	message: String,
}

---
One of a maintainer's open pull requests. `stage` is `draft`, `queued` or
`ready`. `ci` is the latest attempt of each workflow on its head commit, taken
together: `failing` if any failed, else `running` if any queued in the last
day is still going, else `passing` if any completed; `None` when nothing has
run on it (or its head isn't known yet). An attempt still "going" a day
after it was queued lost its completion, and counts as unknown.
---
type MyPull = {
	repo: String,
	number: Int,
	title: String,
	stage: String,
	opened_at: String,
	ready_since: Option[String],
	ci: Option[String],
}

--- An open pull request waiting on the maintainer's review.
type ReviewWaiting = {
	repo: String,
	number: Int,
	title: String,
	author: String,
	draft: Bool,
	opened_at: String,
	ready_since: Option[String],
}

--- One of a maintainer's open issues. `stale` is no update for 14 days.
type MyIssue = {
	repo: String,
	number: Int,
	title: String,
	opened_at: String,
	updated_at: String,
	stale: Bool,
}

--- One of a maintainer's merged pull requests waiting to ship.
type MyMerge = {
	repo: String,
	number: Int,
	title: String,
	merged_at: String,
}

--- The most of each kind `GET /maintainers/mine` lists.
const MAX_MINE: Int = 50

---
A maintainer token's subject, read (#53, step 5): `login:version`, where
`version` is the login's session version when the token was issued. A plain
login (a token from before sessions, or `bynk token Maintainer --sub login`)
is version 0. GitHub logins never contain `:`.
---
type Session = {
	login: String,
	version: Int,
}

fn sessionOf(who: String) -> Session {
	let parts = who.split(":")
	let login = parts.first().getOrElse(who)
	let version = parts.get(1).andThen((v) => Int.parse(v)).getOrElse(0)
	Session {
		login: login,
		version: version,
	}
}

--- `POST /maintainers/actions/rerun`'s body: the run whose failed jobs to re-run.
type RerunRequest = {
	repo: String,
	run_id: Int,
}

--- `POST /maintainers/actions/rerun`'s answer: GitHub accepted the re-run of `attempt`'s failed jobs.
type RerunDone = {
	repo: String,
	run_id: Int,
	attempt: Int,
	message: String,
}
