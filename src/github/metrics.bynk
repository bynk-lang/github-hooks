commons github.metrics

---
`owner/name`, as the query string names a repository.
---
type RepoName = String where Matches("^[^/\\s]+/[^/\\s]+$")

---
How many days back a window reaches: 7 (the default), 30 or 90. The routes
are public and cached per URL, so only those three are answered (others are
`400`): every shape the page asks for is then a cache hit for everyone else.
---
type WindowDays = Int where InRange(1, 90)

---
What triggered a run, as GitHub names the events a workflow can run on. Any
other value is `400` at the boundary rather than a fresh, uncached query.
---
type Trigger = String where Matches("^(push|pull_request|pull_request_target|merge_group|schedule|workflow_dispatch|workflow_run|workflow_call|repository_dispatch|release|deployment|deployment_status|check_run|check_suite|issues|issue_comment|discussion|discussion_comment|create|delete|fork|gollum|label|milestone|page_build|public|registry_package|status|watch|dynamic)$")

---
A branch name: the characters a Git ref may hold, at most 200 of them.
---
type BranchName = String where Matches("^[A-Za-z0-9._/+-]{1,200}$")

---
`GET /metrics/ci`'s query: every filter optional.
`?repo=bynk-lang/bynk&branch=main&event=merge_group&days=30`.
---
type CiQuery = {
	repo: Option[RepoName],
	branch: Option[BranchName],
	event: Option[Trigger],
	days: WindowDays = 7,
}

---
`GET /metrics/ci/now`'s query.
---
type NowQuery = {
	repo: Option[RepoName],
}

---
One workflow's health over the window, from its completed attempts (#20).
`pass_percent` is `success / (success + failure + timed_out)`, rounded, and
`None` when nothing in the window was judged; `cancelled`, `skipped` and
the rest are counted but don't count against it. The wall-clock times are
nearest-rank percentiles of `completed_at - queued_at` over successful
attempts. `flaky` counts runs whose first attempt failed and a re-run passed.
---
type WorkflowHealth = {
	repo: String,
	path: String,
	workflow: String,
	runs: Int,
	success: Int,
	failure: Int,
	timed_out: Int,
	cancelled: Int,
	skipped: Int,
	other: Int,
	pass_percent: Option[Int],
	wall_p50_seconds: Option[Int],
	wall_p95_seconds: Option[Int],
	flaky: Int,
}

---
`GET /metrics/ci`: the window asked for, how much of it has data, and each
workflow's health. `data_since` is the first completion ever recorded, so a
reader can tell "7-day window" from "7-day window, 3 days of data" (no
backfill).
---
type CiMetrics = {
	since: String,
	until: String,
	data_since: Option[String],
	workflows: List[WorkflowHealth],
}

---
A run attempt not yet completed.
---
type InFlight = {
	repo: String,
	path: String,
	workflow: String,
	run_id: Int,
	attempt: Int,
	branch: Option[String],
	event: String,
	status: String,
	queued_at: String,
}

---
A workflow's latest judged result on its repository's default branch (a
`push` to it that concluded `success`, `failure` or `timed_out`). When that
was a failure, `red_since` is the first failure after the last success.
`merge_group` runs don't count: a failed one is a pull request the merge
queue rejected, which is exactly what keeps the default branch green.
---
type MainState = {
	repo: String,
	path: String,
	workflow: String,
	branch: String,
	conclusion: String,
	completed_at: String,
	red_since: Option[String],
}

---
`GET /metrics/ci/now`: what is running, and the state of each default branch.
---
type CiNow = {
	in_flight: List[InFlight],
	main: List[MainState],
}

---
When collection began, decoded from `SELECT min(completed_at) AS first`.
---
type FirstRun = {
	first: Option[String],
}

---
The live board's key. There is one board, so one value; it is a refined
route parameter because the WebSocket upgrade resolves its agent from the
route (bynk-lang/bynk#2959).
---
type LiveBoardKey = String where Matches("^ci$")

---
A dashboard's id for its live connection: a random UUID the page makes.
---
type LiveClient = String where Matches("^[A-Za-z0-9-]{8,64}$")

---
What a dashboard may send on its live connection. It sends nothing today; the
type exists because a WebSocket names its inbound frame.
---
type LiveHello = {
	hello: String,
}

---
Something that changed, pushed to every open page so it refreshes at once.
`kind` is `run` (a workflow run: `path` to `conclusion` describe it, and
`conclusion` is `""` until it completes) or `pull` (a pull request: `number`,
`status` is the delivery's action and `conclusion` the PR's state; the run
fields are empty). Frames are Bynk's JSON, where an `Option` would be tagged,
so plain values keep the pages simple.

`refetch_ms` is how long a page should wait before refetching to be sure of
seeing the change: a few seconds when the metrics routes' edge cache was
purged for it, or until any copy cached before it has expired when the purge
was throttled or refused.
---
type LiveEvent = {
	refetch_ms: Int,
	kind: String,
	repo: String,
	number: Int,
	path: String,
	workflow: String,
	run_id: Int,
	attempt: Int,
	status: String,
	conclusion: String,
}

---
One completed attempt in a workflow's recent runs. `wall_seconds` is
`completed_at - queued_at` whatever the conclusion, so a strip can show how
long a failure took to report. `conclusion` is GitHub's, or `unknown` when a
completed delivery carried none.
---
type RecentRun = {
	repo: String,
	path: String,
	run_id: Int,
	attempt: Int,
	branch: Option[String],
	event: String,
	conclusion: String,
	completed_at: String,
	wall_seconds: Int,
}

---
One workflow's day (UTC, by completion), defined as `WorkflowHealth` is:
`failed` is `failure + timed_out`, `other` is every attempt not judged, and
`pass_percent` is `None` on a day nothing was judged. Days with no completed
attempt have no entry.
---
type DailyHealth = {
	repo: String,
	path: String,
	day: String,
	runs: Int,
	success: Int,
	failed: Int,
	other: Int,
	pass_percent: Option[Int],
	wall_p50_seconds: Option[Int],
}

---
`GET /metrics/ci/history`: for each workflow, its latest completed attempts
in the window (at most 20, oldest first) and its health day by day.
---
type CiHistory = {
	since: String,
	until: String,
	recent: List[RecentRun],
	daily: List[DailyHealth],
}

---
`GET /metrics/prs`'s query: a repository (optional) and a window of 7 (the
default), 30 or 90 days.
---
type PrQuery = {
	repo: Option[RepoName],
	days: WindowDays = 7,
}

---
One repository's pull request flow over the window (#26). Figures are for
pull requests by people; bots' are the `bots_` fields. Times are nearest-rank
percentiles, in seconds, of merged pull requests:

- `ready_to_merge_*`: `merged_at - ready_at`, the headline. A pull request
  whose ready time the service never saw (it became ready before deploy) is
  left out; `ready_to_merge_counted` says how many were counted of `merged`.
- `open_to_merge_*`: `merged_at - opened_at`, over every merged pull request.
- `queue_*`: from the last `enqueued` before the merge to the merge, over
  those whose last queue moment before merging was that enqueue
  (`queue_counted`): one dequeued and then merged around the queue isn't
  counted. `requeued` counts merged pull requests enqueued more than once.
- `size_p50_lines`: the median of additions plus deletions, over those whose
  size is known (`size_counted`).

`closed_unmerged` counts pull requests closed without merging in the window.
---
type PrFlow = {
	repo: String,
	merged: Int,
	closed_unmerged: Int,
	ready_to_merge_counted: Int,
	ready_to_merge_p50_seconds: Option[Int],
	ready_to_merge_p95_seconds: Option[Int],
	open_to_merge_p50_seconds: Option[Int],
	open_to_merge_p95_seconds: Option[Int],
	queue_counted: Int,
	queue_p50_seconds: Option[Int],
	queue_p95_seconds: Option[Int],
	requeued: Int,
	size_counted: Int,
	size_p50_lines: Option[Int],
	bots_merged: Int,
	bots_open: Int,
	bots_merge_p50_seconds: Option[Int],
}

---
Why pull requests left the merge queue without merging, in the window: each
`dequeued` reason other than `MERGE` (GitHub's normal way out), with how many
times. `unknown` when GitHub gave none.
---
type QueueExit = {
	repo: String,
	reason: String,
	count: Int,
}

--- How many pull requests by people merged on one UTC day.
type MergedDay = {
	repo: String,
	day: String,
	merged: Int,
}

---
`GET /metrics/prs`: the window, how much of it has data (`data_since`, the
first merge recorded), and each repository's flow.
---
type PrMetrics = {
	since: String,
	until: String,
	data_since: Option[String],
	repos: List[PrFlow],
	queue_exits: List[QueueExit],
	daily: List[MergedDay],
}

---
An open pull request. `stage` is `draft`, `queued` (in the merge queue) or
`ready`. `ready_since` is when it last became ready (a draft made ready again
counts from then), unknown for one that became ready before the service saw
it. `stale` when it has been ready for more than 7 days and isn't queued.
---
type OpenPull = {
	repo: String,
	number: Int,
	title: String,
	author: String,
	author_is_bot: Bool,
	stage: String,
	opened_at: String,
	ready_since: Option[String],
	stale: Bool,
}

---
`GET /metrics/prs/open`: every open pull request, longest waiting first, then
drafts.
---
type PrsOpen = {
	open: List[OpenPull],
}

---
`GET /metrics/releases`'s query: a repository (optional) and a window of 7
(the default), 30 or 90 days.
---
type ReleaseQuery = {
	repo: Option[RepoName],
	days: WindowDays = 7,
}

---
One repository's releases over the window (#36), for each repository with a
final release (published, and neither a draft nor a pre-release, nor
deleted). Times are nearest-rank percentiles, in seconds.

- `releases`: final releases published in the window; `prereleases` the
  pre-releases, which count towards nothing else.
- `interval_p50_seconds`: the median time between each final release in the
  window and the final release before it (which may be before the window).
- `last_tag`, `last_at`: the latest final release, whenever it was.
- `merge_to_release_*`: `released_at - merged_at` over pull requests by
  people that a release in the window shipped (`shipped_counted`): the
  headline.
- `waiting`: pull requests by people merged since the latest final release,
  which no release has shipped yet, and when the oldest of them merged.
  One merged before it but never matched to a release (it may be in one that
  couldn't be matched) isn't counted either way.
- `recording_since`: when the repository's pull requests began to be
  recorded; merges before it can't be measured.
---
type ReleaseFlow = {
	repo: String,
	releases: Int,
	prereleases: Int,
	interval_p50_seconds: Option[Int],
	last_tag: String,
	last_at: String,
	shipped_counted: Int,
	merge_to_release_p50_seconds: Option[Int],
	merge_to_release_p95_seconds: Option[Int],
	waiting: Int,
	waiting_since: Option[String],
	recording_since: Option[String],
}

---
A repository's release workflow over the window: a workflow that ran on a
release's tag, and its runs on tags, whether or not a release came of them
(so a tag whose release run failed, and was never published, counts too);
its runs on branches don't count.
`failed` counts failures and timeouts; `p50_seconds` is the median time from
queued to completed of the successful runs.
---
type ReleasePipeline = {
	repo: String,
	workflow: String,
	path: String,
	runs: Int,
	failed: Int,
	p50_seconds: Option[Int],
}

--- `GET /metrics/releases`: the window, and each repository's releases and release workflows.
type ReleaseMetrics = {
	since: String,
	until: String,
	repos: List[ReleaseFlow],
	pipeline: List[ReleasePipeline],
}

---
One published release. `previous_tag` is the final release it was compared
with (`None` until it is matched, and for one with nothing before it to
compare with); `shipped` is how many pull requests it shipped, bots' included
(`None` when that isn't known), and `shipped_by_people` how many of them were
by people, the pull requests `/metrics/releases` measures.
---
type RecentRelease = {
	repo: String,
	tag: String,
	name: Option[String],
	prerelease: Bool,
	published_at: String,
	previous_tag: Option[String],
	shipped: Option[Int],
	shipped_by_people: Option[Int],
	url: String,
}

--- `GET /metrics/releases/recent`: each repository's latest releases, newest first.
type ReleasesRecent = {
	releases: List[RecentRelease],
}

---
`GET /metrics/runners`'s query: a repository (optional) and a window of 7 (the
default), 30 or 90 days.
---
type RunnerQuery = {
	repo: Option[RepoName],
	days: WindowDays = 7,
}

---
How long one repository's jobs waited for one kind of runner (#42): the
runner label they asked for, how many started in the window, and the
nearest-rank median and 95th percentile of `started_at - created_at`, in
seconds, with the longest. Jobs held for a protected environment's approval,
cancelled before a runner took them, or skipped, aren't counted.
---
type RunnerWait = {
	repo: String,
	runner: String,
	jobs: Int,
	p50_seconds: Option[Int],
	p95_seconds: Option[Int],
	longest_seconds: Option[Int],
}

--- One of a repository's longest waits for a runner in the window, linking to its job.
type LongWait = {
	repo: String,
	workflow: String,
	name: String,
	runner: String,
	wait_seconds: Int,
	queued_at: String,
	url: String,
}

---
One of a repository's slowest jobs in the window, by its median duration
(`completed_at - started_at`) over successful runs, with the 95th percentile.
---
type JobTime = {
	repo: String,
	workflow: String,
	name: String,
	runs: Int,
	p50_seconds: Option[Int],
	p95_seconds: Option[Int],
}

---
`GET /metrics/runners`: the window, and each repository's waits by runner,
longest waits and slowest jobs. The figures are computed hourly
(`computed_at`; `None` before the first time), so the window ends then, not
now. `data_since` is when the first job was recorded.
---
type RunnerMetrics = {
	since: Option[String],
	until: Option[String],
	computed_at: Option[String],
	data_since: Option[String],
	runners: List[RunnerWait],
	longest: List[LongWait],
	slowest: List[JobTime],
}

---
What one repository's jobs are waiting for now, by runner label: how many
are queued for a runner, and since when the oldest; and how many are held
for a protected environment's approval.
---
type WaitingNow = {
	repo: String,
	runner: String,
	queued: Int,
	oldest_queued_at: Option[String],
	awaiting_approval: Int,
}

--- `GET /metrics/runners/now`.
type RunnersNow = {
	waiting: List[WaitingNow],
}
