commons github.pulls

uses github.events
uses github.runs
uses github.metrics

---
The parts of a `pull_request` delivery the PR flow dashboard needs (#26).
`reason` comes with `dequeued`: why the PR left the merge queue.
---
type PullDelivery = {
	action: String,
	pull_request: PullPayload,
	repository: RepoRef,
	reason: Option[String],
	requested_reviewer: Option[UserRef] = None,
	requested_team: Option[TeamRef] = None,
}

--- A team as a review request names it.
type TeamRef = {
	slug: String,
}

---
An account as a pull request or review names it. `type` is `User` or `Bot`.
---
type UserRef = {
	login: String,
	type: String,
}

---
A branch as a pull request names it. `repo` is the repository it belongs to,
under the name GitHub uses now (after any rename).
---
type BranchRef = {
	ref: String,
	sha: Option[String] = None,
	repo: Option[RepoRef],
}

---
`pull_request` as GitHub sends it. The size fields and `commits` are optional
so that a delivery without them still records the rest.
---
type PullPayload = {
	number: Int,
	title: String,
	user: UserRef,
	base: BranchRef,
	head: BranchRef,
	draft: Option[Bool],
	state: String,
	created_at: String,
	updated_at: String,
	closed_at: Option[String],
	merged_at: Option[String],
	merge_commit_sha: Option[String],
	commits: Option[Int],
	additions: Option[Int],
	deletions: Option[Int],
	changed_files: Option[Int],
	requested_reviewers: Option[List[UserRef]] = None,
	requested_teams: Option[List[TeamRef]] = None,
}

---
One pull request, as `pull_requests` stores it. `state` is `merged` once
merged, else GitHub's `open` or `closed`. `readyAt` is set only when this
delivery says when the PR became ready: opened not as a draft (its
`createdAt`), or `ready_for_review` (its `updatedAt`, which GitHub moves to
that moment).
---
type PullFact = {
	repo: String,
	number: Int,
	action: String,
	title: String,
	author: String,
	authorIsBot: Bool,
	base: String,
	head: String,
	draft: Bool,
	state: String,
	openedAt: String,
	readyAt: Option[String],
	closedAt: Option[String],
	mergedAt: Option[String],
	mergeCommitSha: Option[String],
	commits: Option[Int],
	additions: Option[Int],
	deletions: Option[Int],
	changedFiles: Option[Int],
	updatedAt: String,
	reason: Option[String],
	--- The head commit (#53), for the PR's CI.
	headSha: Option[String] = None,
	--- Whose review it waits on, as this delivery says: the whole set, when it says.
	reviewers: Option[List[String]] = None,
	teams: Option[List[String]] = None,
	--- The one request a `review_requested` or `review_request_removed` names.
	requestedUser: Option[String] = None,
	requestedTeam: Option[String] = None,
}

---
The pull request a `pull_request` delivery describes, or why it couldn't be read.
---
fn pullOf(body: Bytes) -> Result[PullFact, String] {
	let Some(text) = body.decodeUtf8() else { Err("the payload is not UTF-8") }
	let Ok(p) = Json.decode[PullDelivery](text) else match {
		Err(e) => Err("the payload did not decode: \(e.kind) at \(e.path): \(e.message)"),
	}
	let Ok(f) = pullFact(p.repository.full_name, p.action, p.reason, p.pull_request) else match {
		Err(why) => Err(why),
	}
	Ok(PullFact {
		...f,
		requestedUser: p.requested_reviewer.map((u) => u.login),
		requestedTeam: p.requested_team.map((t) => t.slug),
	})
}

---
A pull request as `pull_requests` stores it, from GitHub's PR object: a
delivery's, or one from the REST API (`action` is then `sync`, which says
nothing about when the PR became ready). The list endpoint omits the size
fields and `commits`, which then keep their stored values.
---
fn pullFact(
	repo: String,
	action: String,
	reason: Option[String],
	pr: PullPayload
) -> Result[PullFact, String] {
	let Some(created) = isoTime(pr.created_at) else {
		Err("created_at is not a time: \(pr.created_at)")
	}
	let Some(updated) = isoTime(pr.updated_at) else {
		Err("updated_at is not a time: \(pr.updated_at)")
	}
	let merged = pr.merged_at.andThen((t) => isoTime(t))
	let draft = pr.draft.getOrElse(false)
	// GitHub also names a test merge for an open PR; only a merged one's commit
	// is on the base branch, for a release to ship (#36).
	Ok(PullFact {
		repo: repo,
		number: pr.number,
		action: action,
		title: pr.title,
		author: pr.user.login,
		authorIsBot: pr.user.type == "Bot",
		base: pr.base.ref,
		head: pr.head.ref,
		draft: draft,
		state: if merged.isSome() { "merged" } else { pr.state },
		openedAt: created,
		readyAt: if action == "opened" && !draft {
			Some(created)
		} else if action == "ready_for_review" { Some(updated) } else { None },
		closedAt: pr.closed_at.andThen((t) => isoTime(t)),
		mergedAt: merged,
		mergeCommitSha: if merged.isSome() { pr.merge_commit_sha } else { None },
		commits: pr.commits,
		additions: pr.additions,
		deletions: pr.deletions,
		changedFiles: pr.changed_files,
		updatedAt: updated,
		reason: reason,
		headSha: pr.head.sha,
		reviewers: pr.requested_reviewers.map((us) => us.map((u) => u.login)),
		teams: pr.requested_teams.map((ts) => ts.map((t) => t.slug)),
		requestedUser: None,
		requestedTeam: None,
	})
}

---
Whether a `pull_request` action is one of the moments `pull_request_events`
keeps.
---
fn isPullMoment(action: String) -> Bool {
	action == "enqueued"
		|| action == "dequeued"
		|| action == "ready_for_review"
		|| action == "converted_to_draft"
		|| action == "closed"
		|| action == "reopened"
}

---
The parts of a `pull_request_review` delivery kept (#26). `user` is null for
a deleted account, and `submitted_at` for a review still pending.
---
type ReviewDelivery = {
	action: String,
	review: ReviewPayload,
	pull_request: ReviewedPull,
	repository: RepoRef,
}

type ReviewPayload = {
	id: Int,
	user: Option[UserRef],
	state: String,
	submitted_at: Option[String],
}

type ReviewedPull = {
	number: Int,
}

---
One review, as `pull_request_reviews` stores it: `state` in lower case.
---
type ReviewFact = {
	reviewId: Int,
	repo: String,
	number: Int,
	reviewer: Option[String],
	reviewerIsBot: Bool,
	state: String,
	submittedAt: Option[String],
}

---
The review a `pull_request_review` delivery describes, or why it couldn't be read.
---
fn reviewOf(body: Bytes) -> Result[ReviewFact, String] {
	let Some(text) = body.decodeUtf8() else { Err("the payload is not UTF-8") }
	let Ok(p) = Json.decode[ReviewDelivery](text) else match {
		Err(e) => Err("the payload did not decode: \(e.kind) at \(e.path): \(e.message)"),
	}
	let r = p.review
	Ok(ReviewFact {
		reviewId: r.id,
		repo: p.repository.full_name,
		number: p.pull_request.number,
		reviewer: r.user.map((u) => u.login),
		reviewerIsBot: r.user.map((u) => u.type == "Bot").getOrElse(false),
		state: r.state.toLower(),
		submittedAt: r.submitted_at.andThen((t) => isoTime(t)),
	})
}

---
A public repository the open-PR sync visits (#26): the installation that
last delivered for it, which is the one whose token can read it.
---
type SyncTarget = {
	repo: String,
	installation: Option[Int],
}

---
A pull request the sync holds open: its repository, as its row names it, and
its number.
---
type PullNumber = {
	repo: String,
	number: Int,
}

---
The live-feed event for a pull request that changed.
---
fn pullEventOf(p: PullFact) -> LiveEvent {
	LiveEvent {
		refetch_ms: 0,
		kind: "pull",
		repo: p.repo,
		number: p.number,
		path: "",
		workflow: "",
		run_id: 0,
		attempt: 0,
		status: p.action,
		conclusion: p.state,
	}
}
